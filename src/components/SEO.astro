---
import { SITE } from "../data/site";
import { PUBLISHER_SCHEMA } from "../data/editorialGovernance";

type Props = {
  title: string;
  description: string;
  canonicalPath?: string | false;
  type?: "website" | "article";
  image?: string;
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const {
  title,
  description,
  canonicalPath,
  type = "website",
  image = "/og-default.svg",
  ogTitle,
  ogDescription,
  twitterTitle,
  twitterDescription,
  publishedDate,
  modifiedDate,
  author,
  noindex = false,
  jsonLd
} = Astro.props;

const imageUrl = new URL(image, SITE.url).toString();
const isBrandedTitle = title === SITE.name
  || title === SITE.title
  || title.startsWith(`${SITE.name} -`)
  || title.startsWith(`${SITE.name} |`)
  || title.endsWith(`| ${SITE.name}`);
const pageTitle = isBrandedTitle ? title : `${title} | ${SITE.name}`;
const openGraphTitle = ogTitle ?? pageTitle;
const openGraphDescription = ogDescription ?? description;
const twitterCardTitle = twitterTitle ?? openGraphTitle;
const twitterCardDescription = twitterDescription ?? openGraphDescription;
const siteUrl = `${SITE.url}/#website`;
const organizationUrl = `${SITE.url}/#organization`;
const shouldEmitSiteIdentity = Astro.url.pathname === "/";
const globalJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": siteUrl,
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: "en",
    potentialAction: {
      "@type": "SearchAction",
      target: `${SITE.url}/search/?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    ...PUBLISHER_SCHEMA,
    "@id": organizationUrl,
    logo: {
      "@type": "ImageObject",
      url: new URL("/images/buddha-brand-icon.png", SITE.url).toString()
    }
  }
];
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = [...(shouldEmitSiteIdentity ? globalJsonLd : []), ...pageJsonLd];
const canonicalUrl = canonicalPath === false ? undefined : new URL(canonicalPath ?? Astro.url.pathname, SITE.url).toString();
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={openGraphTitle} />
<meta property="og:description" content={openGraphDescription} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:image" content={imageUrl} />
{type === "article" && publishedDate && <meta property="article:published_time" content={publishedDate} />}
{type === "article" && modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
{type === "article" && author && <meta property="article:author" content={author} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={twitterCardTitle} />
<meta name="twitter:description" content={twitterCardDescription} />
<meta name="twitter:image" content={imageUrl} />
{structuredData.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

---
import { getArticleCategory, getArticleReadTime, type Article } from "../data/site";

type Props = {
  article: Article;
};

const { article } = Astro.props;
const articleHref = article.content.length > 0 ? `/articles/${article.slug}/` : "";
const category = getArticleCategory(article.category);
const readTime = getArticleReadTime(article);
const formattedDate = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric"
}).format(new Date(`${article.date}T00:00:00Z`));
---

<article class="article-card surface">
  {articleHref ? (
    <a class="article-art" href={articleHref} aria-label={`Read ${article.title}`}>
      <span role="img" aria-label={article.imageAlt}></span>
    </a>
  ) : (
    <div class="article-art" role="img" aria-label={article.imageAlt}></div>
  )}
  <div class="article-body">
    <p class="article-kicker">
      <a href={`/articles/category/${category.slug}/`}>{article.category}</a>
    </p>
    <h3>
      {articleHref ? <a href={articleHref}>{article.title}</a> : article.title}
    </h3>
    <p>{article.description}</p>
    <div class="article-details">
      <time datetime={article.date}>{formattedDate}</time>
      <span>{readTime}</span>
      {!articleHref && <span>Preview</span>}
    </div>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .article-art {
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(circle at 50% 45%, rgba(255, 253, 248, 0.94) 0 16%, transparent 17%),
      radial-gradient(circle at 50% 45%, transparent 0 28%, rgba(255, 253, 248, 0.62) 29% 31%, transparent 32%),
      linear-gradient(135deg, rgba(185, 133, 36, 0.34), rgba(95, 127, 98, 0.22));
    border-bottom: 1px solid var(--color-line);
    display: block;
  }

  .article-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem;
  }

  .article-kicker {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: 0.55rem;
    text-transform: uppercase;
  }

  .article-kicker a {
    color: var(--color-green);
  }

  h3 {
    font-size: 1.35rem;
  }

  h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--color-green);
  }

  .article-body > p:not(.article-kicker) {
    color: var(--color-muted);
  }

  .article-details {
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.86rem;
    gap: 0.4rem 0.8rem;
    margin-top: auto;
  }
</style>

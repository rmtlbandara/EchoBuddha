---
import ArticleShare from "./ArticleShare.astro";
import ArticleImage from "./ArticleImage.astro";
import { SITE, getArticleCategory, getArticleReadTime, type Article } from "../data/site";

type Props = {
  article: Article;
  showThumbnail?: boolean;
};

const { article, showThumbnail = true } = Astro.props;
const articleHref = article.content.length > 0 ? `/articles/${article.slug}/` : "";
const articleUrl = articleHref ? new URL(articleHref, SITE.url).toString() : SITE.url;
const thumbnailUrl = article.thumbnail ? new URL(article.thumbnail, SITE.url).toString() : "";
const category = getArticleCategory(article.category);
const readTime = getArticleReadTime(article);
const formattedDate = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric"
}).format(new Date(`${article.date}T00:00:00Z`));
---

<article class="article-card surface">
  {articleHref ? (
    <a class="article-art" href={articleHref} aria-label={`Read ${article.title}`}>
      {showThumbnail && (
        <ArticleImage src={article.thumbnail} alt={article.imageAlt} />
      )}
    </a>
  ) : (
    <div class="article-art">
      {showThumbnail && (
        <ArticleImage src={article.thumbnail} alt={article.imageAlt} />
      )}
    </div>
  )}
  <div class="article-body">
    <p class="article-kicker">
      <a href={`/articles/category/${category.slug}/`}>{article.category}</a>
    </p>
    <h3>
      {articleHref ? <a href={articleHref}>{article.title}</a> : article.title}
    </h3>
    <p>{article.description}</p>
    <div class="article-details">
      <time datetime={article.date}>{formattedDate}</time>
      <span>{readTime}</span>
      {!articleHref && <span>Preview</span>}
      {articleHref && (
        <ArticleShare
          title={article.title}
          description={article.description}
          url={articleUrl}
          image={thumbnailUrl}
          variant="card"
        />
      )}
    </div>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    overflow: visible;
    position: relative;
  }

  .article-art {
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(circle at 50% 45%, rgba(255, 253, 248, 0.94) 0 16%, transparent 17%),
      radial-gradient(circle at 50% 45%, transparent 0 28%, rgba(255, 253, 248, 0.62) 29% 31%, transparent 32%),
      linear-gradient(135deg, rgba(185, 133, 36, 0.34), rgba(95, 127, 98, 0.22));
    border-bottom: 1px solid var(--color-line);
    display: block;
    overflow: hidden;
  }

  .article-art :global(picture),
  .article-art :global(img) {
    display: block;
    height: 100%;
    width: 100%;
  }

  .article-art :global(img) {
    object-fit: cover;
    transition: transform 180ms ease;
  }

  .article-art:hover :global(img) {
    transform: scale(1.02);
  }

  .article-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem;
  }

  .article-kicker {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    margin-bottom: 0.55rem;
    text-transform: uppercase;
  }

  .article-kicker a {
    color: var(--color-green);
  }

  h3 {
    font-size: 1.35rem;
  }

  h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--color-green);
  }

  .article-body > p:not(.article-kicker) {
    color: var(--color-muted);
  }

  .article-details {
    align-items: center;
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.86rem;
    gap: 0.4rem 0.8rem;
    margin-top: auto;
  }

  .article-details :global(.article-share) {
    margin-left: auto;
  }
</style>

---
import { EDITORIAL_IDENTITY } from "../data/editorialGovernance";

type Props = {
  label?: string;
};

const { label = "Prepared by" } = Astro.props;
---

<p class="editorial-attribution">
  <span>{label}</span>
  <a href="/authors/echo-buddha-editorial/" rel="author">{EDITORIAL_IDENTITY.bylineName}</a>
</p>

<style>
  .editorial-attribution {
    align-items: baseline;
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.9rem;
    gap: 0.3rem;
    margin: 0.85rem 0 0;
  }

  .editorial-attribution span {
    font-weight: 700;
  }

  .editorial-attribution a {
    font-weight: 800;
  }
</style>

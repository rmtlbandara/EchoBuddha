---
type Props = {
  title: string;
  description: string;
  url: string;
  image?: string;
  variant?: "card" | "page";
};

const { url, variant = "card" } = Astro.props;
---

<div class:list={["article-share", `article-share--${variant}`]} data-article-copy data-copy-url={url}>
  <button class="copy-link-button" type="button" aria-label="Copy article link" title="Copy article link" data-copy-link>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M8 7.5A2.5 2.5 0 0 1 10.5 5h6A2.5 2.5 0 0 1 19 7.5v6a2.5 2.5 0 0 1-2.5 2.5h-6A2.5 2.5 0 0 1 8 13.5v-6Zm2.5-.5a.5.5 0 0 0-.5.5v6a.5.5 0 0 0 .5.5h6a.5.5 0 0 0 .5-.5v-6a.5.5 0 0 0-.5-.5h-6Z" />
      <path d="M5 10.5A2.5 2.5 0 0 1 7.5 8v2A.5.5 0 0 0 7 10.5v6a.5.5 0 0 0 .5.5h6a.5.5 0 0 0 .5-.5h2a2.5 2.5 0 0 1-2.5 2.5h-6A2.5 2.5 0 0 1 5 16.5v-6Z" />
    </svg>
  </button>
  <span class="copy-link-status" role="status" aria-live="polite" data-copy-status></span>
</div>

<script>
  const copyArticleUrl = async (text) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.left = "-9999px";
    document.body.append(textarea);
    textarea.select();
    document.execCommand("copy");
    textarea.remove();
  };

  document.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) {
      return;
    }

    const button = target.closest("[data-copy-link]");

    if (!(button instanceof HTMLButtonElement)) {
      return;
    }

    event.preventDefault();
    event.stopPropagation();

    const copyContainer = button.closest("[data-article-copy]");
    const url = copyContainer?.getAttribute("data-copy-url") ?? "";
    const status = copyContainer?.querySelector("[data-copy-status]");

    copyArticleUrl(url)
      .then(() => {
        if (status instanceof HTMLElement) {
          status.textContent = "Copied";
        }
        window.setTimeout(() => {
          if (status instanceof HTMLElement) {
            status.textContent = "";
          }
        }, 1200);
      })
      .catch(() => {
        if (status instanceof HTMLElement) {
          status.textContent = "Copy failed";
        }
      });
  });
</script>

<style>
  .article-share {
    align-items: center;
    display: inline-flex;
    gap: 0.45rem;
    position: relative;
  }

  .copy-link-button {
    align-items: center;
    background: rgba(255, 253, 248, 0.9);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-brown);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    justify-content: center;
    min-height: 2.2rem;
    min-width: 2.2rem;
    padding: 0.45rem;
  }

  .copy-link-button:hover,
  .copy-link-button:focus-visible {
    border-color: var(--color-green);
    color: var(--color-green);
  }

  .copy-link-button svg {
    fill: currentColor;
    height: 1rem;
    width: 1rem;
  }

  .copy-link-status {
    color: var(--color-green);
    font-size: 0.78rem;
    font-weight: 800;
    min-height: 1rem;
  }

  .copy-link-status:empty {
    display: none;
  }

  .article-share--card .copy-link-status {
    background: #fffdf8;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    box-shadow: 0 12px 28px rgba(64, 49, 31, 0.12);
    padding: 0.15rem 0.5rem;
    position: absolute;
    right: 0;
    top: calc(100% + 0.35rem);
  }
</style>

---
import { canRenderAd, getMonetizationPolicy } from "../data/monetization.mjs";

type Props = {
  size?: "wide" | "box";
  zone?: string;
  slotId?: string;
  indexable?: boolean;
  reviewedPublisherContent?: boolean;
};

const {
  size = "wide",
  zone,
  slotId,
  indexable = false,
  reviewedPublisherContent = false
} = Astro.props;
const policy = getMonetizationPolicy({
  pathname: Astro.url.pathname,
  indexable,
  reviewedPublisherContent
});
const shouldRender = canRenderAd({ policy, zone, slotId });
---

<!-- Missing page or zone metadata fails closed. Phase 10 keeps all rendering gates off. -->
{shouldRender && (
  <aside class:list={["ad-slot", `ad-slot--${size}`]} aria-label="Advertisement">
    <span>Advertisement</span>
  </aside>
)}

<style>
  .ad-slot {
    align-items: center;
    background: rgba(255, 255, 255, 0.38);
    border: 1px dashed rgba(111, 102, 93, 0.22);
    border-radius: var(--radius);
    color: var(--color-muted);
    display: flex;
    justify-content: center;
    margin: 1.5rem 0;
    min-height: 4rem;
    padding: 0.75rem;
    text-align: center;
  }

  .ad-slot span {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0.72;
    text-transform: uppercase;
  }

  .ad-slot--box {
    min-height: 9rem;
  }
</style>

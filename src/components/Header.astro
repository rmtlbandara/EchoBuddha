---
import SearchOverlay from "./SearchOverlay.astro";

const navItems = [
  { href: "/start-here/", label: "Start Here", matches: ["/start-here/"] },
  { href: "/learn/", label: "Learn", matches: ["/learn/"] },
  { href: "/meditation/", label: "Meditation", matches: ["/meditation/", "/meditation-guide/", "/meditation-safety/"] },
  { href: "/articles/", label: "Articles", matches: ["/articles/", "/mindful-living/"] },
  { href: "/quotes/", label: "Quotes", matches: ["/quotes/"] },
  { href: "/daily-reflections/", label: "Daily Reflection", matches: ["/daily-reflections/"] }
];

const currentPath = Astro.url.pathname;
const navState = navItems.map((item) => {
  const active = item.matches.some((prefix) => currentPath === prefix || currentPath.startsWith(prefix));
  return {
    ...item,
    active,
    current: active ? (currentPath === item.href ? "page" : "location") : undefined
  };
});
---

<header class="site-header">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Echo Buddha home">
      <img class="brand-mark" src="/images/buddha-brand-icon.png" alt="" width="96" height="96" aria-hidden="true" />
      <span>Echo Buddha</span>
    </a>
    <nav id="main-navigation" class="main-nav" aria-label="Main navigation" data-main-nav>
      {navState.map((item) => (
        <a class:list={{ active: item.active }} href={item.href} aria-current={item.current}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <SearchOverlay />
      <button
        class="menu-toggle"
        type="button"
        aria-label="Open navigation menu"
        aria-controls="main-navigation"
        aria-expanded="false"
        data-menu-toggle
      >
        Menu
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: rgba(255, 253, 248, 0.92);
    border-bottom: 1px solid var(--color-line);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    min-height: 4.5rem;
  }

  .header-actions {
    align-items: center;
    display: flex;
    flex: 0 0 auto;
    gap: 0.5rem;
  }

  .skip-link {
    background: var(--color-brown);
    color: #fff;
    left: 1rem;
    padding: 0.5rem 0.75rem;
    position: absolute;
    top: -4rem;
    z-index: 20;
  }

  .skip-link:focus {
    top: 0.75rem;
  }

  .brand {
    align-items: center;
    color: var(--color-ink);
    display: inline-flex;
    flex: 0 0 auto;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    gap: 0.6rem;
    text-decoration: none;
  }

  .brand-mark {
    border: 1px solid var(--color-line);
    border-radius: 50%;
    display: block;
    height: 2rem;
    object-fit: cover;
    width: 2rem;
  }

  .main-nav {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    gap: 0.2rem 0.45rem;
    justify-content: flex-end;
  }

  .main-nav a {
    border-radius: var(--radius);
    color: var(--color-muted);
    font-size: 0.93rem;
    font-weight: 750;
    padding: 0.4rem 0.45rem;
    text-decoration: none;
  }

  .main-nav a:hover {
    color: var(--color-green);
  }

  .main-nav a.active {
    background: var(--color-green-soft);
    color: var(--color-green);
  }

  .menu-toggle {
    align-items: center;
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-muted);
    cursor: pointer;
    display: none;
    font: inherit;
    font-size: 0.93rem;
    font-weight: 800;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.5rem 0.7rem;
  }

  .menu-toggle:hover {
    border-color: var(--color-green);
    color: var(--color-green);
  }

  @media (max-width: 860px) {
    .site-header:has(.skip-link:focus) {
      padding-top: 3.5rem;
    }

    .header-inner {
      flex-wrap: wrap;
      gap: 0.65rem;
      min-height: 4rem;
      padding-block: 0.7rem;
    }

    .brand {
      min-width: 0;
    }

    .brand span {
      overflow-wrap: anywhere;
    }

    .header-actions {
      margin-left: auto;
    }

    .site-header[data-menu-ready="true"] .menu-toggle {
      display: inline-flex;
    }

    .main-nav {
      background: rgba(255, 253, 248, 0.96);
      border-top: 1px solid var(--color-line);
      display: grid;
      gap: 0.35rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      order: 3;
      padding-top: 0.7rem;
      width: 100%;
    }

    .site-header[data-menu-ready="true"][data-nav-open="false"] .main-nav {
      display: none;
    }

    .main-nav a {
      align-items: center;
      background: rgba(255, 255, 255, 0.62);
      border: 1px solid var(--color-line);
      display: inline-flex;
      min-height: 2.75rem;
      padding: 0.55rem 0.7rem;
    }

    .main-nav a.active {
      background: var(--color-green-soft);
      border-color: rgba(79, 111, 82, 0.32);
    }
  }

  @media (max-width: 360px) {
    .brand {
      font-size: 1.12rem;
      gap: 0.45rem;
    }

    .brand-mark {
      height: 1.85rem;
      width: 1.85rem;
    }

    .header-actions {
      gap: 0.35rem;
    }

    .main-nav {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  const header = document.querySelector(".site-header");
  const menuToggle = header?.querySelector("[data-menu-toggle]");
  const mainNavigation = header?.querySelector("[data-main-nav]");
  const mobileQuery = window.matchMedia("(max-width: 860px)");

  const setMenu = (open, returnFocus = false) => {
    if (!header || !menuToggle) return;
    header.dataset.navOpen = String(open);
    menuToggle.setAttribute("aria-expanded", String(open));
    menuToggle.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
    if (open) {
      const target = mainNavigation?.querySelector("a[aria-current], a");
      target?.focus();
    } else if (returnFocus) {
      menuToggle.focus();
    }
  };

  if (header && menuToggle) {
    header.dataset.menuReady = "true";
    setMenu(false);
  }

  menuToggle?.addEventListener("click", () => {
    setMenu(header?.dataset.navOpen !== "true");
  });

  mainNavigation?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  document.addEventListener("pointerdown", (event) => {
    if (header?.dataset.navOpen !== "true" || header.contains(event.target)) return;
    setMenu(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || header?.dataset.navOpen !== "true") return;
    setMenu(false, true);
  });

  mobileQuery.addEventListener("change", (event) => {
    if (!event.matches) setMenu(false);
  });
</script>

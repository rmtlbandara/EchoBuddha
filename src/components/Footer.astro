---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href="/">Echo Buddha</a>
      <p>Original Buddhist-inspired wisdom, meditation guidance, and educational reflections for steady daily practice.</p>
      <nav class="footer-social" aria-labelledby="footer-social-heading">
        <h2 id="footer-social-heading">Follow Echo Buddha</h2>
        <div class="footer-social-links">
          {socialLinks.map(({ label, href }) => (
            <a href={href} rel="me" aria-label={`Echo Buddha on ${label}`}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d={socialIconPaths[label]} />
              </svg>
            </a>
          ))}
        </div>
      </nav>
    </div>
    <div class="footer-links">
      <nav aria-labelledby="footer-explore-heading">
        <h2 id="footer-explore-heading">Explore</h2>
        <a href="/start-here/">Start Here</a>
        <a href="/learn/">Learn</a>
        <a href="/meditation/">Meditation</a>
        <a href="/articles/">Articles</a>
        <a href="/daily-reflections/">Daily Reflections</a>
        <a href="/quotes/">Quotes</a>
        <a href="/tools/">Tools</a>
        <a href="/search/">Search</a>
      </nav>
      <nav aria-labelledby="footer-trust-heading">
        <h2 id="footer-trust-heading">About & Trust</h2>
        <a href="/about/">About</a>
        <a href="/authors/echo-buddha-editorial/">Echo Buddha Editorial</a>
        <a href="/editorial-policy/">Editorial Policy</a>
        <a href="/how-echo-buddha-creates-content/">Content Process</a>
        <a href="/buddhist-sources-and-citations/">Sources & Citations</a>
        <a href="/corrections/">Corrections</a>
        <a href="/contact/">Contact</a>
      </nav>
      <nav aria-labelledby="footer-legal-heading">
        <h2 id="footer-legal-heading">Legal & Settings</h2>
        <a href="/privacy-policy/">Privacy Policy</a>
        <button type="button" data-privacy-settings>Privacy Settings</button>
        <a href="/terms-of-use/">Terms of Use</a>
        <a href="/disclaimer/">Disclaimer</a>
        <a href="/sitemap.xml">Sitemap</a>
      </nav>
    </div>
  </div>
  <div class="container footer-bottom">
    <small>&copy; {year} Echo Buddha. All rights reserved.</small>
  </div>
</footer>

<style>
  .site-footer {
    background: #f7f0e5;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.6rem, 4vw, 2.25rem) 0 1rem;
  }

  .footer-grid {
    align-items: start;
    display: grid;
    gap: 1.5rem;
  }

  .footer-brand {
    color: var(--color-ink);
    display: inline-flex;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    text-decoration: none;
  }

  .site-footer p {
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 0;
    max-width: 480px;
  }

  .footer-social {
    margin-top: 1.15rem;
  }

  .footer-social-links {
    align-items: center;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.5rem;
  }

  .site-footer .footer-social-links a {
    flex: 0 0 44px;
    height: 44px;
    justify-content: center;
    width: 44px;
    transition: color 160ms ease;
  }

  .site-footer .footer-social-links a:focus-visible {
    color: var(--color-green);
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .footer-social-links svg {
    flex: none;
    height: 22px;
    width: 22px;
  }

  .footer-links {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .site-footer nav {
    align-content: start;
    display: grid;
    gap: 0.38rem;
  }

  .site-footer nav h2 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    margin-bottom: 0.15rem;
    text-transform: uppercase;
  }

  .site-footer nav a,
  .site-footer nav button {
    align-items: center;
    background: transparent;
    border: 0;
    color: var(--color-muted);
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.35;
    min-height: 1.75rem;
    padding: 0;
    text-align: left;
    text-decoration: none;
  }

  .site-footer nav a:hover,
  .site-footer nav button:hover {
    color: var(--color-green);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-line);
    margin-top: 1.5rem;
    padding-top: 0.75rem;
  }

  @media (min-width: 720px) {
    .footer-grid {
      grid-template-columns: minmax(12rem, 0.65fr) minmax(0, 1.35fr);
    }

    .footer-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .footer-links {
      grid-template-columns: 1fr;
    }
  }
</style>

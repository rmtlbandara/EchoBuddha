---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href="/">Echo Buddha</a>
      <p>Original Buddhist-inspired wisdom, meditation guidance, and educational reflections for steady daily practice.</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href="/about/">About</a>
      <a href="/start-here/">Start Here</a>
      <a href="/learn/">Learn</a>
      <a href="/daily-reflections/">Daily Reflections</a>
      <a href="/tools/">Tools</a>
      <a href="/articles/">Articles</a>
      <a href="/editorial-policy/">Editorial Policy</a>
      <a href="/privacy-policy/">Privacy Policy</a>
      <button type="button" data-privacy-settings>Privacy Settings</button>
      <a href="/terms-of-use/">Terms of Use</a>
      <a href="/disclaimer/">Disclaimer</a>
      <a href="/contact/">Contact</a>
      <a href="/sitemap.xml">Sitemap</a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <small>&copy; {year} Echo Buddha. All rights reserved.</small>
  </div>
</footer>

<style>
  .site-footer {
    background: #f7f0e5;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.6rem, 4vw, 2.25rem) 0 1rem;
  }

  .footer-grid {
    align-items: start;
    display: grid;
    gap: 1.25rem;
  }

  .footer-brand {
    color: var(--color-ink);
    display: inline-flex;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    text-decoration: none;
  }

  .site-footer p {
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 0;
    max-width: 480px;
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }

  .site-footer nav a,
  .site-footer nav button {
    background: transparent;
    border: 0;
    color: var(--color-muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.35;
    padding: 0;
    text-decoration: none;
  }

  .site-footer nav a:hover,
  .site-footer nav button:hover {
    color: var(--color-green);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-line);
    margin-top: 1.25rem;
    padding-top: 0.75rem;
  }

  @media (min-width: 720px) {
    .footer-grid {
      grid-template-columns: minmax(16rem, 1fr) minmax(22rem, 38rem);
    }

    .site-footer nav {
      justify-content: flex-end;
      text-align: right;
    }
  }
</style>

---
type Props = {
  label?: string;
  size?: "wide" | "box";
};

const { label = "Advertisement placeholder", size = "wide" } = Astro.props;
---

<!-- Future AdSense code can be inserted inside this component. Keep policy pages and content quality complete before enabling ads. -->
<aside class:list={["ad-placeholder", `ad-placeholder--${size}`]} aria-label={label}>
  <span>{label}</span>
  <small>Reserved space for future advertising</small>
</aside>

<style>
  .ad-placeholder {
    align-items: center;
    background:
      linear-gradient(135deg, rgba(243, 223, 170, 0.38), rgba(232, 240, 228, 0.48)),
      #fffdf8;
    border: 1px dashed rgba(103, 72, 36, 0.34);
    border-radius: var(--radius);
    color: var(--color-muted);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    justify-content: center;
    margin: 1.5rem 0;
    min-height: 6rem;
    padding: 1rem;
    text-align: center;
  }

  .ad-placeholder span {
    color: var(--color-brown);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .ad-placeholder small {
    font-size: 0.76rem;
  }

  .ad-placeholder--box {
    min-height: 16rem;
  }
</style>

---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import EditorialStandardsLinks from "../../../components/EditorialStandardsLinks.astro";
import LearningCard from "../../../components/LearningCard.astro";
import { getBreadcrumbJsonLd } from "../../../data/learn";
import {
  HANDBOOK_IMAGE,
  HANDBOOK_PATH,
  getHandbookPath,
  getHandbookReadTime,
  handbookPages,
  type HandbookPage
} from "../../../data/handbook";
import { EDITORIAL_AUTHOR_SCHEMA, PUBLISHER_SCHEMA } from "../../../data/editorialGovernance";
import { SITE } from "../../../data/site";
import { formatPublicationDate } from "../../../utils/publicationMetadata";

export function getStaticPaths() {
  return handbookPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: HandbookPage };
const canonicalPath = getHandbookPath(page);
const readTime = getHandbookReadTime(page);
const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Learn", href: "/learn/" },
  { name: "Buddhist Life & Practice Handbook", href: `${HANDBOOK_PATH}/` },
  { name: page.title, href: canonicalPath }
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: page.title,
    description: page.description,
    url: `${SITE.url}${canonicalPath}`,
    mainEntityOfPage: `${SITE.url}${canonicalPath}`,
    image: `${SITE.url}${HANDBOOK_IMAGE}`,
    inLanguage: "en",
    articleSection: "Buddhist Life & Practice Handbook",
    datePublished: page.publishedDate,
    dateModified: page.modifiedDate,
    author: EDITORIAL_AUTHOR_SCHEMA,
    publisher: PUBLISHER_SCHEMA
  },
  getBreadcrumbJsonLd(breadcrumbs)
];
---

<Layout title={page.seoTitle} description={page.description} canonicalPath={canonicalPath} type="article" image={HANDBOOK_IMAGE} publishedDate={page.publishedDate} modifiedDate={page.modifiedDate} author={SITE.author} jsonLd={jsonLd}>
  <article>
    <header class="page-hero handbook-chapter-hero">
      <div class="container prose">
        <Breadcrumbs items={breadcrumbs.map((item, index) => ({ label: item.name, href: index < breadcrumbs.length - 1 ? item.href : undefined }))} />
        <span class="eyebrow">{page.eyebrow}</span>
        <h1>{page.title}</h1>
        <p class="lede">{page.intro}</p>
        <div class="article-meta chapter-meta">
          <span>By <a href="/authors/echo-buddha-editorial/" rel="author">{SITE.author}</a></span>
          <span>Published <time datetime={page.publishedDate}>{formatPublicationDate(page.publishedDate)}</time></span>
          <span>{readTime}</span>
        </div>
      </div>
    </header>

    <div class="container article-shell handbook-shell">
      <div class="prose handbook-body">
        <aside class="surface key-box" aria-labelledby="key-takeaway-heading">
          <h2 id="key-takeaway-heading">Key Takeaway</h2>
          <p>{page.takeaway}</p>
        </aside>

        {page.sections.map((section, index) => (
          <section aria-labelledby={`section-${index + 1}`}>
            <h2 id={`section-${index + 1}`}>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
            {section.points && <ul class="concept-list">{section.points.map((point) => <li set:html={point} />)}</ul>}
          </section>
        ))}

        <section class="sources-section" aria-labelledby="sources-context-heading">
          <h2 id="sources-context-heading">Sources and Tradition Context</h2>
          <p>{page.sourceNote}</p>
          <h3>Selected References</h3>
          <ul class="source-list">
            {page.sources.map((source) => (
              <li>
                <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>
                <span class="source-type">{source.sourceType}</span>
                <p>{source.note}</p>
              </li>
            ))}
          </ul>
        </section>

        <EditorialStandardsLinks />

        <nav class="chapter-navigation" aria-label="Handbook chapter navigation">
          {page.previous && <a class="surface" href={page.previous.href}><span>Previous chapter</span><strong>{page.previous.label}</strong></a>}
          {page.next && <a class="surface chapter-navigation__next" href={page.next.href}><span>Next chapter</span><strong>{page.next.label}</strong></a>}
        </nav>
      </div>

      <aside class="handbook-sidebar" aria-label="Handbook context">
        <div class="surface side-card">
          <span class="eyebrow">Related terms</span>
          <ul>{page.relatedTerms.map((term) => <li>{term}</li>)}</ul>
        </div>
        <div class="surface side-card">
          <span class="eyebrow">Eight-part collection</span>
          <p>Return to the handbook contents or move through the chapters in sequence.</p>
          <a href={`${HANDBOOK_PATH}/`}>Buddhist Life & Practice Handbook</a>
        </div>
      </aside>
    </div>
  </article>

  <section class="section section-band" aria-labelledby="continue-learning-heading">
    <div class="container">
      <span class="eyebrow">Continue learning</span>
      <h2 id="continue-learning-heading">Related Learning</h2>
      <div class="grid grid--3">{page.relatedLinks.map((item) => <LearningCard item={item} />)}</div>
    </div>
  </section>
</Layout>

<style>
  .handbook-chapter-hero { background: linear-gradient(145deg, rgba(245, 237, 220, 0.72), rgba(235, 243, 232, 0.45)); padding-bottom: clamp(2.25rem, 5vw, 3.5rem); }
  .handbook-chapter-hero h1 { font-size: clamp(2.4rem, 6vw, 4.65rem); }
  .chapter-meta span + span::before { color: var(--color-muted); content: "/"; margin-right: 0.75rem; }
  .handbook-shell { padding-bottom: clamp(3rem, 7vw, 5rem); padding-top: clamp(2rem, 5vw, 3.5rem); }
  .handbook-body > section { margin-top: 2.75rem; }
  .handbook-body > section h2 { margin-top: 0; }
  .key-box { border-left: 4px solid var(--color-gold); padding: 1.35rem; }
  .key-box h2 { font-size: 1.45rem; margin-top: 0; }
  .key-box p:last-child, .side-card p:last-of-type, .source-list p { margin-bottom: 0; }
  .concept-list { display: grid; gap: 0.6rem; }
  .sources-section { border-top: 1px solid var(--color-line); padding-top: 2.4rem; }
  .source-list { display: grid; gap: 1rem; list-style: none; padding: 0; }
  .source-list li { border-left: 3px solid var(--color-green-soft); padding-left: 1rem; }
  .source-list a { font-weight: 800; }
  .source-type { color: var(--color-muted); display: block; font-size: 0.85rem; font-weight: 700; margin-top: 0.2rem; text-transform: uppercase; }
  .chapter-navigation { display: grid; gap: 1rem; margin-top: 2.75rem; }
  .chapter-navigation a { display: grid; padding: 1.1rem; text-decoration: none; }
  .chapter-navigation span { color: var(--color-muted); font-size: 0.84rem; text-transform: uppercase; }
  .chapter-navigation strong { margin-top: 0.2rem; }
  .side-card { padding: 1.2rem; }
  .side-card + .side-card { margin-top: 1rem; }
  .side-card ul { margin-bottom: 0; padding-left: 1.2rem; }
  .side-card a { font-weight: 800; }
  @media (max-width: 480px) {
    .chapter-meta { align-items: flex-start; flex-direction: column; gap: 0.35rem; }
    .chapter-meta span + span::before { content: none; }
  }
  @media (min-width: 900px) {
    .handbook-shell { align-items: start; grid-template-columns: minmax(0, 760px) minmax(220px, 1fr); }
    .handbook-sidebar { position: sticky; top: 6.5rem; }
    .chapter-navigation { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .chapter-navigation__next { grid-column: 2; text-align: right; }
  }
</style>

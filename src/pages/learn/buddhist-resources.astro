---
import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../data/site";
import { getBreadcrumbJsonLd, resourceGroups } from "../../data/learn";

const title = "Buddhist Resources";
const description =
  "A curated Echo Buddha resource page for Buddhist texts, meditation learning, dictionaries, beginner Buddhism, Sri Lankan resources, and global Buddhist study.";
const canonicalPath = "/learn/buddhist-resources/";
const internalStudyLinks = [
  { label: "Nirvana", href: "/learn/buddhist-dictionary/nirvana/" },
  { label: "Avoid Evil, Do Good, Purify the Mind", href: "/learn/dhammapada-reflections/avoid-evil-do-good-purify-the-mind/" },
  { label: "The Mind Leads All Things", href: "/learn/dhammapada-reflections/the-mind-leads-all-things/" },
  { label: "Hatred Is Not Ended by Hatred", href: "/learn/dhammapada-reflections/hatred-is-not-ended-by-hatred/" },
  { label: "Peace Comes From a Trained Mind", href: "/learn/dhammapada-reflections/peace-comes-from-a-trained-mind/" },
  { label: "Kalama Sutta and Wise Thinking", href: "/learn/sutta-for-daily-life/kalama-sutta-and-wise-thinking/" },
  { label: "Metta Sutta Explained for Daily Life", href: "/learn/sutta-for-daily-life/metta-sutta-explained-for-daily-life/" },
  { label: "Mindfulness of Breathing Explained Simply", href: "/learn/sutta-for-daily-life/mindfulness-of-breathing-explained-simply/" },
  { label: "Buddha's Teaching on Patience", href: "/learn/sutta-for-daily-life/buddhas-teaching-on-patience/" },
  { label: "Better Than a Thousand Empty Words", href: "/learn/dhammapada-reflections/better-than-a-thousand-empty-words/" }
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: `${SITE.url}${canonicalPath}`
  },
  getBreadcrumbJsonLd([
    { name: "Home", href: "/" },
    { name: "Learn", href: "/learn/" },
    { name: title, href: canonicalPath }
  ])
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <a class="back-link" href="/learn/">Learn</a>
      <span class="eyebrow">Further Reading</span>
      <h1>Buddhist Resources</h1>
      <p class="lede">
        A small, curated list of trusted Buddhist learning resources. External links open in a new tab and are shared
        for education, not endorsement of every view or page on those sites.
      </p>
      <p>
        Echo Buddha includes selected resources for further learning. External resources are provided for educational
        convenience and may represent different Buddhist traditions, translation choices, or editorial approaches.
        Read <a href="/buddhist-sources-and-citations/">Buddhist Sources and Citations</a> for how Echo Buddha handles
        scripture, commentary, paraphrase, translations, and source links.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container resource-grid">
      {resourceGroups.map((group) => (
        <section class="surface resource-card">
          <h2>{group.title}</h2>
          <p>{group.description}</p>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                <span>{link.description}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <section class="surface resource-card internal-study">
        <h2>Echo Buddha Text Study Starting Points</h2>
        <p>
          Begin with these source-aware internal guides, then compare the external resources above for fuller study and
          different translation choices.
        </p>
        <ul>
          {internalStudyLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
              <span>Internal beginner guide with practical reflection and source context.</span>
            </li>
          ))}
        </ul>
      </section>
      <section class="surface resource-card internal-study">
        <h2>Source and Attribution Standards</h2>
        <p>
          These trust pages explain how Echo Buddha keeps traditional sources, original explanation, and quote
          attribution visible for readers.
        </p>
        <ul>
          <li>
            <a href="/buddhist-sources-and-citations/">Buddhist Sources and Citations</a>
            <span>How source links, translations, paraphrases, and Echo Buddha explanations are handled.</span>
          </li>
          <li>
            <a href="/quote-attribution-policy/">Quote Attribution Policy</a>
            <span>How original reflections, verified quotes, popular sayings, and corrections are labeled.</span>
          </li>
        </ul>
      </section>
    </div>
  </section>
</Layout>

<style>
  .back-link {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .resource-grid {
    display: grid;
    gap: 1.25rem;
  }

  .resource-card {
    padding: 1.25rem;
  }

  .resource-card h2 {
    font-size: 1.45rem;
  }

  .resource-card p,
  .resource-card span {
    color: var(--color-muted);
  }

  .resource-card ul {
    display: grid;
    gap: 0.85rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .resource-card a {
    display: inline-flex;
    font-weight: 800;
  }

  .resource-card span {
    display: block;
    font-size: 0.92rem;
  }

  @media (min-width: 760px) {
    .resource-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
import Layout from "../../layouts/Layout.astro";
import LearningCard from "../../components/LearningCard.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { SITE, fullArticles } from "../../data/site";

const title = "Noble Eightfold Path for Daily Life";
const description =
  "Learn the Noble Eightfold Path as a practical Buddhist training in wisdom, ethical conduct, effort, mindfulness, and meditation.";
const canonicalPath = "/learn/eightfold-path/";
const pathFactors = [
  { label: "Right View", href: "/learn/buddhism-101/the-four-noble-truths-explained/", description: "See suffering, change, intention, and practice more clearly." },
  { label: "Right Intention", href: "/quotes/practice/right-intention-turns-the-heart/", description: "Turn the heart toward non-harming, renunciation, and goodwill." },
  { label: "Right Speech", href: "/articles/right-speech-buddhism/", description: "Speak truthfully, kindly, usefully, and at the right time." },
  { label: "Right Action", href: "/learn/buddhism-101/five-precepts-buddhism/", description: "Let conduct reduce harm and support trust." },
  { label: "Right Livelihood", href: "/learn/buddhism-101/right-livelihood-buddhism/", description: "Bring honesty and non-harming into work." },
  { label: "Right Effort", href: "/learn/buddhism-101/a-simple-daily-buddhist-practice/", description: "Cultivate wholesome states without harshness." },
  { label: "Right Mindfulness", href: "/learn/buddhism-101/what-is-mindfulness/", description: "Remember awareness in body, feeling, mind, and daily life." },
  { label: "Right Concentration", href: "/meditation/meditation-for-beginners/", description: "Train steadiness through meditation and gentle returning." }
];
const trainingGroups = [
  {
    label: "Wisdom",
    factors: "Right view and right intention",
    description: "Understand suffering and its causes, then orient the mind toward letting go, goodwill, and non-harming."
  },
  {
    label: "Ethical conduct",
    factors: "Right speech, right action, and right livelihood",
    description: "Train the outward choices that protect life, trust, relationships, and the conditions needed for a less burdened mind."
  },
  {
    label: "Cultivation of mind",
    factors: "Right effort, right mindfulness, and right concentration",
    description: "Prevent and release unhelpful states, cultivate helpful ones, remember the field of experience, and develop steadiness."
  }
];
const relatedArticles = ["noble-eightfold-path-practical-guide", "eightfold-path-explained", "eightfold-path-explained-daily-life", "right-speech-buddhism"]
  .map((slug) => fullArticles.find((article) => article.slug === slug))
  .filter(Boolean);
const sourceLinks = [
  {
    label: "Magga-vibhanga Sutta (SN 45.8)",
    href: "https://suttacentral.net/sn45.8/en/sujato",
    note: "An early-discourse analysis of right view, intention, speech, action, livelihood, effort, mindfulness, and concentration."
  },
  {
    label: "Right Livelihood overview",
    href: "https://www.accesstoinsight.org/ptf/dhamma/sacca/sacca4/samma-ajivo/index.html",
    note: "Supports the daily-life framing of right livelihood."
  }
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    url: `${SITE.url}${canonicalPath}`,
    author: { "@type": "Organization", name: SITE.author },
    publisher: { "@type": "Organization", name: SITE.name, url: SITE.url }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
      { "@type": "ListItem", position: 2, name: "Learn", item: `${SITE.url}/learn/` },
      { "@type": "ListItem", position: 3, name: "Eightfold Path", item: `${SITE.url}${canonicalPath}` }
    ]
  }
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} type="article" jsonLd={jsonLd}>
  <article>
    <header class="page-hero">
      <div class="container prose">
        <a class="back-link" href="/learn/">Learn</a>
        <span class="eyebrow">Core practice hub</span>
        <h1>The Noble Eightfold Path for Daily Life</h1>
        <p class="lede">
          The Noble Eightfold Path is a practical training in wisdom, ethical conduct, mindfulness, and meditation. It
          becomes real through speech, work, effort, attention, and daily choices.
        </p>
      </div>
    </header>

    <section class="section section--tight">
      <div class="container">
        <div class="grid grid--2">
          {pathFactors.map((item) => <LearningCard item={item} />)}
        </div>
      </div>
    </section>

    <section class="section section-band">
      <div class="container prose">
        <h2>One Path, Three Areas of Training</h2>
        <p>
          A common teaching arrangement groups the factors as wisdom, ethical conduct, and cultivation of mind. The
          grouping is a study aid, not a sequence in which ethics can be skipped until meditation is mastered. Conduct
          affects the mind; view affects conduct; attention helps us notice both.
        </p>
        <div class="training-groups">
          {trainingGroups.map((group) => (
            <div>
              <h3>{group.label}</h3>
              <strong>{group.factors}</strong>
              <p>{group.description}</p>
            </div>
          ))}
        </div>
        <h2>What “Right” Means Here</h2>
        <p>
          “Right” translates <em>sammā</em> in the factor names. It does not mean declaring oneself morally superior or
          finding whatever feels right personally. The factors are oriented toward the ending of dukkha and away from
          greed, ill will, cruelty, deception, and heedlessness. Translators sometimes choose terms such as right,
          skillful, or appropriate; no single English substitute carries every shade of the Pali term.
        </p>
        <h2>A Worked Example: Before Sending a Harsh Reply</h2>
        <p>
          A message arrives that feels unfair. Right view notices both the facts and the suffering being produced. Right
          intention checks whether the aim is clarification or retaliation. Right speech rules out lying, abuse, and
          deliberate division. Right action may mean documenting the issue or seeking help rather than escalating.
          Right effort stops rehearsing the cruelest response and develops a useful one. Right mindfulness keeps body,
          feeling, and aim in view. Right concentration supplies enough steadiness to finish the response without being
          pulled into every angry thought. Livelihood matters when the exchange is part of work and power.
        </p>
        <p>
          This is an editorial application, not a claim that one email completes the path. It shows how several factors
          can cooperate in one ordinary decision.
        </p>
        <h2>A Focused Practice</h2>
        <p>
          Choose one consequential conversation. Before it begins, write the three factors most relevant to it and a
          behavior that would express each one. Afterward, review the result without turning the path into a scorecard.
          The aim is to see conditions more clearly and train the next response.
        </p>
        <h2>Source Notes</h2>
        <p>
          SN 45.8 supplies the factor definitions. The threefold grouping, modern scenario, and practice are explanatory
          and editorial. Translation terms differ, especially for intention/purpose and concentration/immersion; readers
          doing formal study should compare translations and learn with a reputable teacher or community.
        </p>
        <ul class="source-list">
          {sourceLinks.map((source) => (
            <li>
              <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>
              <span>{source.note}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <span class="eyebrow">Related reading</span>
        <h2>Continue Learning</h2>
        <div class="grid grid--3">
          {relatedArticles.map((article) => <ArticleCard article={article} />)}
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  .back-link {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .source-list {
    display: grid;
    gap: 0.65rem;
    list-style: none;
    padding-left: 0;
  }

  .source-list li {
    border-left: 3px solid var(--color-gold);
    padding-left: 0.85rem;
  }

  .source-list span {
    color: var(--color-muted);
    display: block;
    font-size: 0.94rem;
    margin-top: 0.15rem;
  }

  .training-groups {
    display: grid;
    gap: 0.9rem;
    margin-block: 1.5rem;
  }

  .training-groups > div {
    border-left: 3px solid var(--color-gold);
    padding-left: 1rem;
  }

  .training-groups h3 {
    margin-bottom: 0.2rem;
  }

  .training-groups strong {
    color: var(--color-green);
    display: block;
    font-size: 0.92rem;
    margin-bottom: 0.35rem;
  }

  .training-groups p {
    margin: 0;
  }
</style>

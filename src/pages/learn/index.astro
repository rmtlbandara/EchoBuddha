---
import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../data/site";
import { getBreadcrumbJsonLd } from "../../data/learn";

const title = "Learn Buddhist Wisdom for Daily Life";
const description =
  "Explore Echo Buddha's calm learning library with beginner-friendly Buddhist teachings, dictionary terms, meditation guidance, Dhammapada reflections, sutta notes, and practical daily wisdom.";
const canonicalPath = "/learn/";

const learningGroups = [
  {
    eyebrow: "Begin",
    title: "New to Buddhism",
    description: "Start with orientation and the core foundations in a useful order.",
    links: [
      { label: "Buddhism for Beginners", href: "/learn/buddhism-for-beginners/" },
      { label: "Buddhism 101", href: "/learn/buddhism-101/" },
      { label: "Questions About Buddhism", href: "/learn/questions-about-buddhism/" }
    ]
  },
  {
    eyebrow: "Foundations",
    title: "Understand the Core Teachings",
    description: "Follow the broad learning owners before narrower examples and articles.",
    links: [
      { label: "Four Noble Truths", href: "/learn/four-noble-truths/" },
      { label: "Noble Eightfold Path", href: "/learn/eightfold-path/" },
      { label: "Three Jewels", href: "/learn/buddhism-101/the-three-jewels-explained/" },
      { label: "Five Precepts", href: "/learn/buddhism-101/five-precepts-buddhism/" }
    ]
  },
  {
    eyebrow: "Clarify",
    title: "Look Up a Buddhist Term",
    description: "Use plain-language definitions when a teaching introduces an unfamiliar word.",
    links: [
      { label: "Buddhist Dictionary", href: "/learn/buddhist-dictionary/" },
      { label: "Dhamma", href: "/learn/buddhist-dictionary/dhamma/" },
      { label: "Karma", href: "/learn/buddhist-dictionary/karma/" },
      { label: "Mettā", href: "/learn/buddhist-dictionary/metta/" }
    ]
  },
  {
    eyebrow: "Study sources",
    title: "Read Texts With Context",
    description: "Move into source-aware Dhammapada and sutta notes when you want deeper study.",
    links: [
      { label: "Dhammapada Reflections", href: "/learn/dhammapada-reflections/" },
      { label: "Sutta for Daily Life", href: "/learn/sutta-for-daily-life/" },
      { label: "Buddhist Resources", href: "/learn/buddhist-resources/" },
      { label: "How Sources and Citations Work", href: "/buddhist-sources-and-citations/" }
    ]
  }
];

const deeperLearning = [
  {
    title: "Continue through the foundations",
    links: [
      { label: "The Middle Way", href: "/learn/buddhism-101/middle-way-explained-for-beginners/" },
      { label: "The Threefold Training", href: "/learn/buddhism-101/threefold-training-sila-samadhi-panna/" },
      { label: "The Four Brahmavihāras", href: "/learn/buddhism-101/four-brahmaviharas/" }
    ]
  },
  {
    title: "Read selected text notes",
    links: [
      { label: "Avoid Evil, Do Good, Purify the Mind", href: "/learn/dhammapada-reflections/avoid-evil-do-good-purify-the-mind/" },
      { label: "Better Than a Thousand Empty Words", href: "/learn/dhammapada-reflections/better-than-a-thousand-empty-words/" },
      { label: "Hatred Is Not Ended by Hatred", href: "/learn/dhammapada-reflections/hatred-is-not-ended-by-hatred/" },
      { label: "Kālāma Sutta and Wise Thinking", href: "/learn/sutta-for-daily-life/kalama-sutta-and-wise-thinking/" },
      { label: "First Teaching Context", href: "/learn/sutta-for-daily-life/dhammacakkappavattana-sutta-four-noble-truths/" },
      { label: "Eightfold Path Source Note", href: "/learn/sutta-for-daily-life/magga-vibhanga-sutta-eightfold-path/" }
    ]
  }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: `${SITE.url}${canonicalPath}`,
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url }
  },
  getBreadcrumbJsonLd([
    { name: "Home", href: "/" },
    { name: "Learn", href: "/learn/" }
  ])
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Structured learning</span>
      <h1>Learn Buddhist Wisdom for Daily Life</h1>
      <p class="lede">
        Begin with the foundations, clarify unfamiliar terms, and move into source study when you are ready. Articles
        explore situations; Learn keeps the teaching sequence clear.
      </p>
      <a class="button" href="/learn/buddhism-for-beginners/">Begin with Buddhism for Beginners</a>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <section class="handbook-feature surface" aria-labelledby="handbook-feature-heading">
        <picture>
          <source srcset="/images/handbook/refined/buddhist-life-practice-handbook-800.avif 800w, /images/handbook/refined/buddhist-life-practice-handbook.avif 1600w" sizes="(min-width: 900px) 42vw, 100vw" type="image/avif" />
          <img src="/images/handbook/refined/buddhist-life-practice-handbook.webp" srcset="/images/handbook/refined/buddhist-life-practice-handbook-800.webp 800w, /images/handbook/refined/buddhist-life-practice-handbook.webp 1600w" sizes="(min-width: 900px) 42vw, 100vw" alt="A Bodhi tree, palm-leaf manuscript, alms bowl, and path toward a stupa at dawn" width="1600" height="900" loading="eager" decoding="async" fetchpriority="high" />
        </picture>
        <div>
          <span class="eyebrow">Part I · The Triple Gem & Refuge</span>
          <h2 id="handbook-feature-heading">Buddhist Life & Practice Handbook</h2>
          <p>Follow eight substantial chapters from the Buddha, Dhamma, and Saṅgha through refuge, lived tradition, respectful practice, and healthy lay–monastic relationships.</p>
          <a class="button" href="/learn/buddhist-handbook/">Open Part I</a>
        </div>
      </section>
      <span class="eyebrow">Choose your learning need</span>
      <h2>Four Ways Into the Learning Library</h2>
      <div class="learning-grid">
        {learningGroups.map((group) => (
          <section class="surface learning-group">
            <span class="eyebrow">{group.eyebrow}</span>
            <h3>{group.title}</h3>
            <p>{group.description}</p>
            <ul>
              {group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
            </ul>
          </section>
        ))}
      </div>
      <div class="search-entry surface">
        <div>
          <h2>Know What You Want?</h2>
          <p>Search by teaching, term, sutta, Dhammapada theme, meditation, or everyday question.</p>
        </div>
        <a class="button button--secondary" href="/search/">Search Echo Buddha</a>
      </div>
      <section class="deeper-learning" aria-labelledby="deeper-learning-heading">
        <span class="eyebrow">Continue when ready</span>
        <h2 id="deeper-learning-heading">Specific Lessons Beyond the Starting Path</h2>
        <div class="deeper-grid">
          {deeperLearning.map((group) => (
            <section>
              <h3>{group.title}</h3>
              <ul>
                {group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
              </ul>
            </section>
          ))}
        </div>
      </section>
    </div>
  </section>

  <section class="section section-band">
    <div class="container split">
      <div>
        <span class="eyebrow">A simple progression</span>
        <h2>Learn, Then Test One Teaching in Life</h2>
        <p class="lede">
          Understanding becomes useful when it shapes attention, speech, conduct, and care. You do not need to read
          the library as a checklist.
        </p>
      </div>
      <ol class="progression surface">
        <li><a href="/learn/buddhism-101/what-is-buddhism/">Understand what Buddhism is</a></li>
        <li><a href="/learn/four-noble-truths/">Learn the Four Noble Truths</a></li>
        <li><a href="/learn/eightfold-path/">See how the path is practiced</a></li>
        <li><a href="/meditation/meditation-for-beginners/">Try a beginner meditation</a></li>
      </ol>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container next-choice">
      <div>
        <span class="eyebrow">Different purpose</span>
        <h2>Looking for Application Rather Than a Sequence?</h2>
        <p>
          Use Articles for practical situations and Daily Reflections for one brief recurring prompt. These sections
          support Learn without replacing its foundational owners.
        </p>
      </div>
      <nav aria-label="Learning support sections">
        <a href="/articles/">Read practical articles</a>
        <a href="/daily-reflections/today/">Read today's reflection</a>
        <a href="/meditation/">Choose a practice</a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .learning-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .learning-group {
    padding: 1.25rem;
  }

  .learning-group h3 {
    font-size: 1.35rem;
  }

  .learning-group p {
    color: var(--color-muted);
  }

  .learning-group ul,
  .progression {
    display: grid;
    gap: 0.55rem;
    margin-bottom: 0;
    padding-left: 1.2rem;
  }

  .learning-group a,
  .progression a,
  .next-choice nav a {
    font-weight: 800;
  }

  .search-entry {
    align-items: center;
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1.25rem;
  }

  .search-entry h2 {
    font-size: 1.45rem;
  }

  .search-entry p {
    color: var(--color-muted);
    margin-bottom: 0;
  }

  .deeper-learning {
    border-top: 1px solid var(--color-line);
    margin-top: 2rem;
    padding-top: 2rem;
  }

  .handbook-feature {
    align-items: center;
    display: grid;
    gap: 1.25rem 2rem;
    margin-top: 1rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
    overflow: hidden;
    padding: 1rem;
  }

  .handbook-feature picture,
  .handbook-feature img {
    display: block;
  }

  .handbook-feature img {
    aspect-ratio: 16 / 9;
    border-radius: calc(var(--radius) * 0.75);
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .handbook-feature h2 {
    font-size: 1.7rem;
  }

  .handbook-feature p {
    color: var(--color-muted);
  }

  .deeper-learning h2 {
    font-size: 1.7rem;
  }

  .deeper-grid {
    display: grid;
    gap: 1.25rem 2rem;
    margin-top: 1rem;
  }

  .deeper-grid h3 {
    font-size: 1.15rem;
  }

  .deeper-grid ul {
    display: grid;
    gap: 0.45rem;
    margin-bottom: 0;
    padding-left: 1.2rem;
  }

  .deeper-grid a {
    font-weight: 750;
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .progression {
    counter-reset: learning-step;
    list-style: none;
    padding: 1.25rem;
  }

  .progression li {
    align-items: start;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: auto minmax(0, 1fr);
  }

  .progression li::before {
    align-items: center;
    background: var(--color-green-soft);
    border-radius: 50%;
    color: var(--color-green);
    content: counter(learning-step);
    counter-increment: learning-step;
    display: inline-flex;
    font-weight: 800;
    height: 1.8rem;
    justify-content: center;
    width: 1.8rem;
  }

  .next-choice {
    display: grid;
    gap: 1rem 2rem;
  }

  .next-choice p {
    color: var(--color-muted);
  }

  .next-choice nav {
    display: grid;
    gap: 0.55rem;
  }

  @media (min-width: 720px) {
    .handbook-feature {
      grid-template-columns: minmax(220px, 0.75fr) minmax(0, 1.25fr);
      padding: 1.25rem;
    }

    .learning-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .search-entry,
    .next-choice {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .deeper-grid {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    }
  }
</style>

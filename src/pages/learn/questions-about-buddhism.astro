---
import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../data/site";
import { getBreadcrumbJsonLd, questionsAboutBuddhism } from "../../data/learn";
import { buddhistQuestions, getBuddhistQuestionPath } from "../../data/buddhistQuestions";

const title = "Questions About Buddhism";
const description =
  "Beginner-friendly answers to common questions about Buddhism, meditation, suffering, compassion, attachment, and home practice.";
const canonicalPath = "/learn/questions-about-buddhism/";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: questionsAboutBuddhism.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  },
  getBreadcrumbJsonLd([
    { name: "Home", href: "/" },
    { name: "Learn", href: "/learn/" },
    { name: title, href: canonicalPath }
  ])
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <a class="back-link" href="/learn/">Learn</a>
      <span class="eyebrow">Beginner Questions</span>
      <h1>Questions About Buddhism</h1>
      <p class="lede">
        Clear, gentle answers for readers beginning Buddhist study or exploring Buddhist-inspired mindfulness and
        daily practice.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container prose">
      <div class="faq-list">
        {questionsAboutBuddhism.map((item) => (
          <details class="surface">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
            <div class="faq-links">
              {item.links.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section deeper-questions" aria-labelledby="deeper-questions-heading">
    <div class="container">
      <div class="prose section-intro">
        <span class="eyebrow">Source-aware study</span>
        <h2 id="deeper-questions-heading">Deeper Questions About Buddhist Tradition</h2>
        <p>
          Some Buddhist questions need more than a short answer. These explanations distinguish early texts, later
          tradition, historical evidence, and modern interpretation where that distinction matters.
        </p>
      </div>
      <div class="question-grid">
        {buddhistQuestions.map((question) => (
          <article class="surface question-card">
            <span class="eyebrow">{question.eyebrow}</span>
            <h3><a href={getBuddhistQuestionPath(question)}>{question.title}</a></h3>
            <p>{question.description}</p>
            <a class="question-card__link" href={getBuddhistQuestionPath(question)}>
              Read the full answer <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .back-link {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .faq-list {
    display: grid;
    gap: 0.85rem;
  }

  details {
    padding: 1rem 1.15rem;
  }

  summary {
    color: var(--color-ink);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.18rem;
    font-weight: 700;
  }

  details p {
    color: var(--color-muted);
    margin-top: 0.75rem;
  }

  .faq-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .deeper-questions {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .section-intro {
    margin-bottom: 1.5rem;
  }

  .section-intro h2 {
    margin-top: 0;
  }

  .section-intro p {
    color: var(--color-muted);
  }

  .question-grid {
    display: grid;
    gap: 1.25rem;
  }

  .question-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.3rem;
  }

  .question-card h3 {
    font-size: clamp(1.45rem, 3vw, 1.8rem);
  }

  .question-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .question-card h3 a:hover {
    color: var(--color-green);
  }

  .question-card p {
    color: var(--color-muted);
  }

  .question-card__link {
    font-weight: 800;
    margin-top: auto;
  }

  @media (min-width: 760px) {
    .question-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
import Layout from "../../../layouts/Layout.astro";
import LearningCard from "../../../components/LearningCard.astro";
import AdSlot from "../../../components/AdSlot.astro";
import { SITE } from "../../../data/site";
import { getBreadcrumbJsonLd, learningSections } from "../../../data/learn";

export function getStaticPaths() {
  return learningSections.map((section) => ({
    params: { section: section.slug },
    props: { section }
  }));
}

const { section } = Astro.props;
const canonicalPath = section.href;
const dictionaryLetters = section.slug === "buddhist-dictionary"
  ? [...new Set(section.items.map((item) => item.title[0].toUpperCase()))].sort()
  : [];
const sectionGuidance = {
  "buddhism-101": {
    title: "How to use Buddhism 101",
    text:
      "Read these lessons slowly rather than as a checklist. Each page explains one foundation, gives a daily-life example, and points toward a related practice, article, or Buddhist term.",
    links: [
      { label: "Questions About Buddhism", href: "/learn/questions-about-buddhism/" },
      { label: "Meditation for Beginners", href: "/meditation/meditation-for-beginners/" },
      { label: "Buddhist Dictionary", href: "/learn/buddhist-dictionary/" }
    ]
  },
  "buddhist-dictionary": {
    title: "More than short definitions",
    text:
      "This dictionary explains Buddhist terms through practice, daily examples, and related teachings. Use it when an article, quote, or meditation guide mentions a word you want to understand more deeply.",
    links: [
      { label: "Anicca", href: "/learn/buddhist-dictionary/anicca/" },
      { label: "Dukkha", href: "/learn/buddhist-dictionary/dukkha/" },
      { label: "Mindfulness", href: "/learn/buddhist-dictionary/mindfulness/" }
    ]
  },
  "dhammapada-reflections": {
    title: "Read as reflection, not quotation collecting",
    text:
      "These pages use original, public-domain-safe paraphrase and practical reflection. They are meant to help a theme become speech, patience, attention, or kindness in daily life.",
    links: [
      { label: "Practice Quotes", href: "/quotes/practice/" },
      { label: "Right Speech", href: "/learn/sutta-for-daily-life/right-speech-in-daily-life/" },
      { label: "Daily Buddhist Practice", href: "/learn/buddhism-101/a-simple-daily-buddhist-practice/" }
    ]
  },
  "sutta-for-daily-life": {
    title: "Traditional themes in plain English",
    text:
      "These pages introduce selected sutta themes through simple background, practical examples, and gentle reflection. They do not replace formal study with teachers or full translations.",
    links: [
      { label: "Buddhist Resources", href: "/learn/buddhist-resources/" },
      { label: "Metta", href: "/learn/buddhist-dictionary/metta/" },
      { label: "Breathing Meditation", href: "/meditation/breathing-meditation/" }
    ]
  }
}[section.slug];
const buddhism101LearningOrder = [
  {
    label: "Who Was the Buddha?",
    href: "/learn/buddhism-101/who-was-the-buddha/",
    text: "Begin with the human teacher and the spirit of careful investigation."
  },
  {
    label: "What Is Buddhism?",
    href: "/learn/buddhism-101/what-is-buddhism/",
    text: "Understand Buddhism as wisdom, ethics, meditation, compassion, and practice."
  },
  {
    label: "The Three Jewels",
    href: "/learn/buddhism-101/the-three-jewels-explained/",
    text: "Learn how the Buddha, Dhamma, and Sangha orient Buddhist life."
  },
  {
    label: "The Four Noble Truths",
    href: "/learn/buddhism-101/the-four-noble-truths-explained/",
    text: "See how suffering, craving, release, and the path fit together."
  },
  {
    label: "The Noble Eightfold Path",
    href: "/learn/buddhism-101/the-noble-eightfold-path-explained/",
    text: "Turn understanding into speech, action, livelihood, mindfulness, and meditation."
  },
  {
    label: "The Five Precepts",
    href: "/learn/buddhism-101/five-precepts-buddhism/",
    text: "Bring Buddhist ethics into ordinary choices and relationships."
  },
  {
    label: "The Three Marks of Existence",
    href: "/learn/buddhism-101/three-marks-of-existence/",
    text: "Explore impermanence, unsatisfactoriness, and non-self gently."
  },
  {
    label: "Karma",
    href: "/learn/buddhism-101/what-is-karma-in-buddhism/",
    text: "Learn how intention and repeated action shape habits and consequences."
  },
  {
    label: "Mindfulness",
    href: "/learn/buddhism-101/what-is-mindfulness/",
    text: "Practice remembering the body, feelings, mind, and present conditions."
  },
  {
    label: "Simple Daily Buddhist Practice",
    href: "/learn/buddhism-101/a-simple-daily-buddhist-practice/",
    text: "Make learning repeatable through small daily practices."
  },
  {
    label: "How to Practice Buddhism at Home",
    href: "/learn/buddhism-101/how-to-practice-buddhism-at-home/",
    text: "Bring study, meditation, ethics, and reflection into home life."
  }
];
const dictionarySourceNote =
  "Dictionary definitions are simplified for general readers. For deeper study, compare reputable Buddhist teachers, translations, study communities, and tradition-specific explanations.";
const sourceLinksBySection = {
  "buddhism-101": [
    {
      label: "Dhammacakkappavattana Sutta (SN 56.11)",
      href: "https://www.accesstoinsight.org/tipitaka/sn/sn56/sn56.011.than.html",
      note: "Background source for the Four Noble Truths and path orientation used across beginner lessons."
    },
    {
      label: "Magga-vibhanga Sutta (SN 45.8)",
      href: "https://www.accesstoinsight.org/tipitaka/sn/sn45/sn45.008.than.html",
      note: "Background source for the Eightfold Path lessons."
    }
  ],
  "buddhist-dictionary": [
    {
      label: "Access to Insight glossary",
      href: "https://www.accesstoinsight.org/glossary.html",
      note: "Used as one comparison point for Pali terms and traditional teaching context."
    },
    {
      label: "Dhammapada, Maggavagga",
      href: "https://www.accesstoinsight.org/tipitaka/kn/dhp/dhp.20.budd.html",
      note: "Supports key terms such as anicca, dukkha, and anatta."
    }
  ],
  "dhammapada-reflections": [
    {
      label: "Dhammapada, Yamakavagga",
      href: "https://www.accesstoinsight.org/tipitaka/kn/dhp/dhp.01.budd.html",
      note: "Traditional source background for several reflection themes."
    },
    {
      label: "Dhammapada, Buddhavagga",
      href: "https://www.accesstoinsight.org/tipitaka/kn/dhp/dhp.14.budd.html",
      note: "Traditional source background for purification, patience, and refuge themes."
    }
  ],
  "sutta-for-daily-life": [
    {
      label: "Karaniya Metta Sutta (Sn 1.8)",
      href: "https://www.accesstoinsight.org/tipitaka/kn/snp/snp.1.08.than.html",
      note: "Source background for goodwill and loving-kindness practice."
    },
    {
      label: "Kalama Sutta (AN 3.65)",
      href: "https://www.accesstoinsight.org/tipitaka/an/an03/an03.065.than.html",
      note: "Source background for wise inquiry and testing what leads to welfare."
    }
  ]
}[section.slug] ?? [];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: section.title,
    description: section.description,
    url: `${SITE.url}${canonicalPath}`,
    numberOfItems: section.items.length,
    isPartOf: {
      "@type": "CollectionPage",
      name: "Learn",
      url: `${SITE.url}/learn/`
    }
  },
  ...(section.slug === "buddhist-dictionary"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "DefinedTermSet",
          name: "Echo Buddha Buddhist Dictionary",
          description: section.description,
          url: `${SITE.url}${canonicalPath}`,
          hasDefinedTerm: section.items.map((item) => ({
            "@type": "DefinedTerm",
            name: item.title,
            description: item.description,
            url: `${SITE.url}/learn/${section.slug}/${item.slug}/`
          }))
        }
      ]
    : []),
  getBreadcrumbJsonLd([
    { name: "Home", href: "/" },
    { name: "Learn", href: "/learn/" },
    { name: section.title, href: canonicalPath }
  ])
];
---

<Layout title={section.title} description={section.description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <a class="back-link" href="/learn/">Learn</a>
      <span class="eyebrow">{section.eyebrow}</span>
      <h1>{section.title}</h1>
      <p class="lede">{section.intro}</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container" data-filter-root={section.slug === "buddhist-dictionary" ? "" : undefined}>
      {sectionGuidance && (
        <div class="surface guidance-card">
          <div>
            <span class="eyebrow">Learning guide</span>
            <h2>{sectionGuidance.title}</h2>
            <p>{sectionGuidance.text}</p>
          </div>
          <div class="guidance-links">
            {sectionGuidance.links.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
        </div>
      )}
      {section.slug === "buddhism-101" && (
        <section class="surface learning-order" aria-labelledby="learning-order-heading">
          <span class="eyebrow">Suggested learning order</span>
          <h2 id="learning-order-heading">A Gentle Path Through Buddhism 101</h2>
          <ol>
            {buddhism101LearningOrder.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
                <p>{item.text}</p>
              </li>
            ))}
          </ol>
        </section>
      )}
      {section.slug === "buddhist-dictionary" && (
        <>
          <div class="surface filter-panel">
            <label for="dictionary-filter">Search Buddhist terms</label>
            <div class="filter-controls">
              <input
                id="dictionary-filter"
                type="search"
                data-filter-input
                autocomplete="off"
                placeholder="Search anicca, dukkha, metta, mindfulness, karma..."
              />
              <button type="button" data-filter-clear>Clear</button>
            </div>
            <nav class="letter-list" aria-label="Dictionary letters represented in this glossary">
              {dictionaryLetters.map((letter) => <span>{letter}</span>)}
            </nav>
            <p class="filter-empty" data-filter-empty hidden>No terms found. Try anicca, metta, karma, or mindfulness.</p>
          </div>
          <p class="source-helper">{dictionarySourceNote}</p>
        </>
      )}
      {sourceLinksBySection.length > 0 && (
        <section class="source-panel" aria-label={`${section.title} sources`}>
          <span class="eyebrow">Source context</span>
          <p>
            Echo Buddha uses original beginner-friendly explanations. These references give readers a starting point
            for checking traditional context and comparing translations.
          </p>
          <ul class="source-list">
            {sourceLinksBySection.map((source) => (
              <li>
                <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>
                <span>{source.note}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
      {(section.slug === "dhammapada-reflections" || section.slug === "sutta-for-daily-life") && (
        <section class="surface study-note" aria-labelledby="study-note-heading">
          <span class="eyebrow">Study note</span>
          <h2 id="study-note-heading">Read With Source Awareness</h2>
          <p>
            These pages are not a substitute for full translation study. They offer original Echo Buddha explanations
            that help a reader test one traditional theme in speech, attention, patience, and non-harming.
          </p>
          <p>
            When a passage matters to you, compare translations and teacher commentaries. A short reflection becomes
            stronger when it leads to careful reading rather than replacing it.
          </p>
        </section>
      )}
      <div class="grid grid--3">
        {section.items.map((item) => (
          <div
            data-filter-item={section.slug === "buddhist-dictionary" ? "" : undefined}
            data-filter-text={section.slug === "buddhist-dictionary" ? `${item.title} ${item.description} ${item.terms?.join(" ") ?? ""}` : undefined}
          >
            <LearningCard
              item={{
                label: item.title,
                href: `/learn/${section.slug}/${item.slug}/`,
                description: item.description
              }}
            />
          </div>
        ))}
      </div>
      <AdSlot />
    </div>
  </section>
</Layout>

<style>
  .back-link {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .guidance-card {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1.25rem;
  }

  .guidance-card h2 {
    font-size: 1.4rem;
  }

  .guidance-card p {
    color: var(--color-muted);
    margin-bottom: 0;
  }

  .guidance-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .guidance-links a {
    background: var(--color-green-soft);
    border-radius: 999px;
    color: var(--color-green);
    font-size: 0.88rem;
    font-weight: 800;
    padding: 0.3rem 0.75rem;
    text-decoration: none;
  }

  .guidance-links a:hover {
    color: var(--color-brown);
  }

  .learning-order {
    margin-bottom: 1.5rem;
    padding: 1.25rem;
  }

  .learning-order h2 {
    font-size: 1.45rem;
  }

  .learning-order ol {
    counter-reset: lesson;
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .learning-order li {
    background: rgba(247, 240, 229, 0.55);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    counter-increment: lesson;
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 0.9rem 0.8rem 3rem;
    position: relative;
  }

  .learning-order li::before {
    align-items: center;
    background: var(--color-green-soft);
    border-radius: 50%;
    color: var(--color-green);
    content: counter(lesson);
    display: inline-flex;
    font-size: 0.8rem;
    font-weight: 800;
    height: 1.7rem;
    justify-content: center;
    left: 0.8rem;
    position: absolute;
    top: 0.8rem;
    width: 1.7rem;
  }

  .learning-order a {
    font-weight: 800;
  }

  .learning-order p,
  .source-helper {
    color: var(--color-muted);
    margin: 0;
  }

  .source-helper {
    font-size: 0.94rem;
    margin: -0.5rem 0 1.5rem;
  }

	  .source-panel {
    border-block: 1px solid var(--color-line);
    margin: 1.5rem 0;
    padding: 1.25rem 0;
	  }

  .study-note {
    margin: 1.5rem 0;
    padding: 1.25rem;
  }

  .study-note h2 {
    font-size: 1.45rem;
  }

  .study-note p {
    color: var(--color-muted);
  }

  .study-note p:last-child {
    margin-bottom: 0;
  }

  .source-panel p {
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .source-list {
    display: grid;
    gap: 0.65rem;
    list-style: none;
    padding-left: 0;
  }

  .source-list li {
    border-left: 3px solid var(--color-gold);
    padding-left: 0.85rem;
  }

  .source-list span {
    color: var(--color-muted);
    display: block;
    font-size: 0.94rem;
    margin-top: 0.15rem;
  }

  .filter-panel {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding: 1.25rem;
  }

  .filter-panel label {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .filter-controls {
    display: grid;
    gap: 0.65rem;
  }

  .filter-controls input {
    background: #fffdf8;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-ink);
    font: inherit;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    width: 100%;
  }

  .filter-controls button {
    background: transparent;
    border: 1px solid var(--color-brown);
    border-radius: var(--radius);
    color: var(--color-brown);
    cursor: pointer;
    font: inherit;
    font-weight: 800;
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
  }

  .filter-controls button:hover {
    background: var(--color-green-soft);
    border-color: var(--color-green);
    color: var(--color-green);
  }

  .letter-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .letter-list span {
    background: var(--color-green-soft);
    border-radius: var(--radius);
    color: var(--color-green);
    display: inline-flex;
    font-size: 0.86rem;
    font-weight: 800;
    justify-content: center;
    min-width: 2rem;
    padding: 0.35rem 0.55rem;
    text-align: center;
  }

  .filter-empty {
    color: var(--color-muted);
    margin-bottom: 0;
  }

  @media (min-width: 620px) {
    .filter-controls {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>

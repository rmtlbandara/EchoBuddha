---
import Layout from "../../../layouts/Layout.astro";
import AdSlot from "../../../components/AdSlot.astro";
import LearningCard from "../../../components/LearningCard.astro";
import {
  getAllLearningPages,
  getBreadcrumbJsonLd,
  getLearningBreadcrumbs,
  getLearningSection,
  type LearningPage
} from "../../../data/learn";
import { SITE } from "../../../data/site";

export function getStaticPaths() {
  return getAllLearningPages().map((page) => ({
    params: { section: page.section, slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props as { page: LearningPage };
const section = getLearningSection(page.section);
const canonicalPath = `/learn/${page.section}/${page.slug}/`;
const breadcrumbs = getLearningBreadcrumbs(page);
const relatedItems = page.relatedLinks.map((item) => ({ ...item, description: item.description ?? "" }));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: page.title,
    description: page.description,
    url: `${SITE.url}${canonicalPath}`,
    inLanguage: "en",
    author: {
      "@type": "Organization",
      name: SITE.author,
      url: `${SITE.url}/authors/echo-buddha-editorial/`
    },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      url: SITE.url
    },
    articleSection: section?.title ?? "Learn"
  },
  getBreadcrumbJsonLd(breadcrumbs)
];
---

<Layout
  title={page.seoTitle ?? page.title}
  description={page.description}
  canonicalPath={canonicalPath}
  type="article"
  jsonLd={jsonLd}
>
  <article>
    <header class="page-hero">
      <div class="container prose">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          {breadcrumbs.slice(0, -1).map((item, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              <a href={item.href}>{item.name}</a>
            </>
          ))}
        </nav>
        <span class="eyebrow">{page.eyebrow}</span>
        <h1>{page.title}</h1>
        <p class="lede">{page.intro}</p>
      </div>
    </header>

    <div class="container article-shell">
      <div class="prose learning-body">
        <aside class="surface key-box">
          <h2>Key Takeaway</h2>
          <p>{page.takeaway}</p>
        </aside>

        {page.sections.map((section, index) => (
          <>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
            {index === 1 && <AdSlot />}
          </>
        ))}

        {page.practice && (
          <aside class="surface practice-box">
            <h2>Practice Today</h2>
            <p>{page.practice}</p>
          </aside>
        )}

        {page.sourceNote && (
          <section>
            <h2>Further Reading / Source Note</h2>
            <p>{page.sourceNote}</p>
          </section>
        )}
      </div>

      <aside>
        {page.terms && page.terms.length > 0 && (
          <div class="surface side-card">
            <span class="eyebrow">Related terms</span>
            <ul>
              {page.terms.map((term) => <li>{term}</li>)}
            </ul>
          </div>
        )}
        <AdSlot size="box" />
      </aside>
    </div>
  </article>

  <section class="section section-band">
    <div class="container">
      <span class="eyebrow">Continue learning</span>
      <h2>Related Learning Links</h2>
      <div class="grid grid--3">
        {relatedItems.map((item) => <LearningCard item={item} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .breadcrumbs {
    align-items: center;
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.86rem;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--color-muted);
  }

  .key-box,
  .practice-box,
  .side-card {
    padding: 1.25rem;
  }

  .key-box h2,
  .practice-box h2,
  .side-card h2 {
    font-size: 1.35rem;
    margin-top: 0;
  }

  .side-card {
    margin-bottom: 1rem;
  }

  .side-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .side-card li {
    background: var(--color-green-soft);
    border-radius: 999px;
    color: var(--color-green);
    font-size: 0.84rem;
    font-weight: 800;
    padding: 0.25rem 0.7rem;
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }
</style>

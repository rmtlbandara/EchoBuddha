---
import Layout from "../../../layouts/Layout.astro";
import AdSlot from "../../../components/AdSlot.astro";
import LearningCard from "../../../components/LearningCard.astro";
import {
  getAllLearningPages,
  getBreadcrumbJsonLd,
  getLearningBreadcrumbs,
  getLearningQualityNote,
  getLearningSection,
  getSourceLinks,
  getTermLinks,
  type LearningPage
} from "../../../data/learn";
import { SITE } from "../../../data/site";
import { getTopicRole } from "../../../data/editorialGovernance";

export function getStaticPaths() {
  return getAllLearningPages().map((page) => ({
    params: { section: page.section, slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props as { page: LearningPage };
const section = getLearningSection(page.section);
const canonicalPath = `/learn/${page.section}/${page.slug}/`;
const breadcrumbs = getLearningBreadcrumbs(page);
const relatedItems = page.relatedLinks.map((item) => ({ ...item, description: item.description ?? "" }));
const qualityNote = getLearningQualityNote(page);
const termLinks = getTermLinks(page.terms);
const sourceLinks = getSourceLinks(page);
const learningRole = getTopicRole(canonicalPath);
const sourceNoteText =
  page.section === "buddhist-dictionary"
    ? `${page.title} is explained in simplified language for general readers. Compare this definition with reputable Buddhist teachers, translations, and study communities for deeper tradition-specific learning.`
    : page.section === "meditation"
      ? "This is educational meditation guidance based on general Buddhist practice themes. It is not medical or mental health advice; adapt gently and seek qualified support when needed."
      : page.sourceNote;
const articleJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: page.title,
    description: page.description,
    url: `${SITE.url}${canonicalPath}`,
    inLanguage: "en",
    author: {
      "@type": "Organization",
      name: SITE.author,
      url: `${SITE.url}/authors/echo-buddha-editorial/`
    },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      url: SITE.url
    },
    articleSection: section?.title ?? "Learn"
  },
  getBreadcrumbJsonLd(breadcrumbs)
];
const dictionaryJsonLd = page.section === "buddhist-dictionary"
  ? [
      {
        "@context": "https://schema.org",
        "@type": "DefinedTerm",
        name: page.title,
        description: page.description,
        url: `${SITE.url}${canonicalPath}`,
        inDefinedTermSet: {
          "@type": "DefinedTermSet",
          name: "Echo Buddha Buddhist Dictionary",
          url: `${SITE.url}/learn/buddhist-dictionary/`
        }
      }
    ]
  : [];
const jsonLd = [...articleJsonLd, ...dictionaryJsonLd];
---

<Layout
  title={page.seoTitle ?? page.title}
  description={page.description}
  canonicalPath={canonicalPath}
  type="article"
  jsonLd={jsonLd}
>
  <article>
    <header class="page-hero">
      <div class="container prose">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          {breadcrumbs.slice(0, -1).map((item, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              <a href={item.href}>{item.name}</a>
            </>
          ))}
        </nav>
        <span class="eyebrow">{page.eyebrow}</span>
        <h1>{page.title}</h1>
        <p class="lede">{page.intro}</p>
        {learningRole && <p class="page-role-note">{learningRole.publicSummary}</p>}
      </div>
    </header>

    <div class="container article-shell">
      <div class="prose learning-body">
        <aside class="surface key-box">
          <h2>Key Takeaway</h2>
          <p>{page.takeaway}</p>
        </aside>

        {qualityNote && (
          <section class="learning-note" aria-labelledby="why-this-matters-heading">
            <h2 id="why-this-matters-heading">Why This Matters</h2>
            <p>{qualityNote.why}</p>
          </section>
        )}

        {page.sections.map((section, index) => (
          <>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
            {index === 1 && <AdSlot />}
          </>
        ))}

        {qualityNote && (
          <aside class="surface clarification-box">
            <h2>A Helpful Clarification</h2>
            <p>{qualityNote.clarification}</p>
          </aside>
        )}

        {page.practice && (
          <aside class="surface practice-box">
            <h2>Practice Today</h2>
            <p>{page.practice}</p>
          </aside>
        )}

        {qualityNote && (
          <aside class="surface reflection-box">
            <h2>Reflection Question</h2>
            <p>{qualityNote.question}</p>
          </aside>
        )}

        {sourceNoteText && (
          <section>
            <h2>Further Reading / Source Note</h2>
            <p>{sourceNoteText}</p>
            {learningRole && (
              <p>
                This page serves as a <strong>{learningRole.role}</strong> in the {learningRole.cluster} topic
                cluster. It is written as original Echo Buddha educational guidance and remains open to formal
                Buddhist studies review where doctrine, translation, or tradition-specific interpretation matters.
              </p>
            )}
            <p>
              For source standards and correction requests, see the <a href="/editorial-policy/">Editorial Policy</a>.
              For study pathways beyond beginner summaries, visit <a href="/learn/buddhist-resources/">Buddhist
              Resources</a>.
            </p>
            {sourceLinks.length > 0 && (
              <>
                <h3>Traditional References</h3>
                <ul class="source-list">
                  {sourceLinks.map((source) => (
                    <li>
                      <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>
                      <span>{source.note}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )}
      </div>

      <aside>
        {termLinks.length > 0 && (
          <div class="surface side-card">
            <span class="eyebrow">Related terms</span>
            <ul>
              {termLinks.map((term) => (
                <li>{term.href ? <a href={term.href}>{term.label}</a> : <span>{term.label}</span>}</li>
              ))}
            </ul>
          </div>
        )}
        <AdSlot size="box" />
      </aside>
    </div>
  </article>

  <section class="section section-band">
    <div class="container">
      <span class="eyebrow">Continue learning</span>
      <h2>Related Learning Links</h2>
      <div class="grid grid--3">
        {relatedItems.map((item) => <LearningCard item={item} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .breadcrumbs {
    align-items: center;
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.86rem;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--color-muted);
  }

  .page-role-note {
    color: var(--color-muted);
    font-size: 0.95rem;
    font-weight: 700;
    margin-top: 0.9rem;
  }

  .key-box,
  .practice-box,
  .clarification-box,
  .reflection-box,
  .side-card {
    padding: 1.25rem;
  }

  .key-box h2,
  .practice-box h2,
  .clarification-box h2,
  .reflection-box h2,
  .side-card h2 {
    font-size: 1.35rem;
    margin-top: 0;
  }

  .clarification-box,
  .reflection-box {
    margin: 2rem 0;
  }

  .learning-note {
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 2rem;
    padding-bottom: 0.5rem;
  }

  .source-list {
    display: grid;
    gap: 0.65rem;
    list-style: none;
    padding-left: 0;
  }

  .source-list li {
    border-left: 3px solid var(--color-gold);
    padding-left: 0.85rem;
  }

  .source-list span {
    color: var(--color-muted);
    display: block;
    font-size: 0.94rem;
    margin-top: 0.15rem;
  }

  .side-card {
    margin-bottom: 1rem;
  }

  .side-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .side-card li a,
  .side-card li span {
    background: var(--color-green-soft);
    border-radius: 999px;
    color: var(--color-green);
    display: inline-flex;
    font-size: 0.84rem;
    font-weight: 800;
    padding: 0.25rem 0.7rem;
    text-decoration: none;
  }

  .side-card li a:hover {
    color: var(--color-brown);
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }
</style>

---
import Layout from "../../layouts/Layout.astro";
import LearningCard from "../../components/LearningCard.astro";
import { SITE } from "../../data/site";

const title = "Buddhism for Beginners - Simple Buddhist Teachings";
const description =
  "Start learning Buddhism with a calm 7-day path through the Buddha, Four Noble Truths, Eightfold Path, mindfulness, ethics, compassion, karma, and meditation.";
const canonicalPath = "/learn/buddhism-for-beginners/";
const beginnerLinks = [
  { label: "Who Was the Buddha?", href: "/learn/buddhism-101/who-was-the-buddha/", description: "Begin with the Buddha as a human teacher and awakened guide." },
  { label: "What Is Buddhism?", href: "/learn/buddhism-101/what-is-buddhism/", description: "Understand Buddhism as practice, not only belief." },
  { label: "The Three Jewels", href: "/learn/buddhism-101/the-three-jewels-explained/", description: "Learn Buddha, Dhamma, and Sangha as sources of refuge." },
  { label: "Four Noble Truths", href: "/learn/four-noble-truths/", description: "A clear hub for the Buddha's teaching on suffering and release." },
  { label: "Noble Eightfold Path", href: "/learn/eightfold-path/", description: "A practical path through wisdom, conduct, and mental training." },
  { label: "What Is Mindfulness?", href: "/learn/buddhism-101/what-is-mindfulness/", description: "Learn mindfulness as careful remembering, not only relaxation." },
  { label: "What Is Impermanence?", href: "/learn/buddhism-101/what-is-impermanence/", description: "Understand change as a doorway into less clinging." },
  { label: "Five Precepts", href: "/learn/buddhism-101/five-precepts-buddhism/", description: "Begin Buddhist ethics as voluntary training in reducing harm." },
  { label: "Karma", href: "/learn/buddhism-101/what-is-karma-in-buddhism/", description: "Study intention, action, and consequence without blame." },
  { label: "Compassion", href: "/learn/buddhist-dictionary/compassion/", description: "Connect kindness with wisdom, boundaries, and non-harming." },
  { label: "Beginner Meditation", href: "/meditation/meditation-for-beginners/", description: "Start with a gentle, non-performative practice." }
];
const firstPath = [
  { day: "Day 1", label: "Meet the Buddha", href: "/learn/buddhism-101/who-was-the-buddha/", note: "Read for orientation, not hero worship." },
  { day: "Day 2", label: "Understand the Four Noble Truths", href: "/learn/four-noble-truths/", note: "Notice suffering and the possibility of release." },
  { day: "Day 3", label: "Learn the Eightfold Path", href: "/learn/eightfold-path/", note: "See practice as wisdom, ethics, and mental training." },
  { day: "Day 4", label: "Practice Mindfulness", href: "/learn/buddhism-101/what-is-mindfulness/", note: "Use one ordinary activity as the reminder to return." },
  { day: "Day 5", label: "Study the Five Precepts", href: "/learn/buddhism-101/five-precepts-buddhism/", note: "Look at speech, care, honesty, and heedfulness." },
  { day: "Day 6", label: "Try Beginner Meditation", href: "/meditation/meditation-for-beginners/", note: "Keep it short and gentle; stop or adapt if needed." },
  { day: "Day 7", label: "Choose One Daily Practice", href: "/learn/buddhism-101/a-simple-daily-buddhist-practice/", note: "Repeat one small action instead of collecting more ideas." }
];
const practiceMap = [
  {
    label: "Understand",
    description: "Learn how dukkha, change, intention, and clinging are described. Understanding gives practice a direction; it is not a demand to accept every claim without examination."
  },
  {
    label: "Live ethically",
    description: "Use the Five Precepts and path factors such as right speech and right action to reduce avoidable harm. Ethics is part of the training, not a preliminary that meditation replaces."
  },
  {
    label: "Train attention",
    description: "Meditation and mindfulness help reveal habits as they form. The point is not to force a blank or permanently calm mind, but to see experience with more steadiness and less automatic reaction."
  }
];
const sourceLinks = [
  {
    label: "Dhammacakkappavattana Sutta (SN 56.11)",
    href: "https://suttacentral.net/sn56.11/en/sujato",
    note: "An early-discourse source for the middle way, the Four Noble Truths, and the tasks associated with them."
  },
  {
    label: "Analysis of the Eightfold Path (SN 45.8)",
    href: "https://suttacentral.net/sn45.8/en/sujato",
    note: "An early-discourse analysis of the eight path factors. Translation choices vary, so Echo Buddha paraphrases rather than reproducing the text."
  }
];
const faqItems = [
  {
    question: "What should a beginner learn first in Buddhism?",
    answer: "Start with the Buddha, the Four Noble Truths, the Noble Eightfold Path, mindfulness, the Five Precepts, compassion, karma, meditation, and one simple daily practice."
  },
  {
    question: "Do I need special beliefs to begin?",
    answer: "You can begin by learning, reflecting, and practicing carefully. Echo Buddha presents beginner-friendly educational material rather than asking for blind belief."
  }
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: `${SITE.url}${canonicalPath}`
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
      { "@type": "ListItem", position: 2, name: "Learn", item: `${SITE.url}/learn/` },
      { "@type": "ListItem", position: 3, name: "Buddhism for Beginners", item: `${SITE.url}${canonicalPath}` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer }
    }))
  }
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <a class="back-link" href="/learn/">Learn</a>
      <span class="eyebrow">Beginner hub</span>
      <h1>Buddhism for Beginners</h1>
      <p class="lede">
        Buddhism is a path of understanding suffering, reducing harm, training attention, and cultivating wisdom and
        compassion. Begin here slowly: learn one teaching, test it in one ordinary moment, then continue.
      </p>
      <p class="page-role-note">
        This is the main beginner learning hub. <a href="/start-here/">Start Here</a> is the orientation page for
        choosing a path through the site; this page is the study hub for Buddhist basics.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="grid grid--3">
        {beginnerLinks.map((item) => <LearningCard item={item} />)}
      </div>
    </div>
  </section>

  <section class="section section-band">
    <div class="container prose">
      <span class="eyebrow">A usable map</span>
      <h2>What a Beginner Is Actually Learning to Do</h2>
      <p>
        Buddhism is not only a set of ideas and not only a meditation technique. Across Buddhist traditions, learning,
        ethical conduct, and cultivation of the mind support one another. A beginner can use these three activities as
        a map without pretending that every Buddhist school explains or practices them in exactly the same way.
      </p>
      <div class="practice-map">
        {practiceMap.map((item) => (
          <div>
            <h3>{item.label}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
      <p>
        These are directions for training, not a test of whether someone is a “good Buddhist.” If a teaching is new,
        first understand how the tradition uses it. Then notice what happens when it is applied to speech, attention,
        consumption, conflict, or care. Questions and gradual learning are more useful than collecting unfamiliar terms.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">First week</span>
          <h2>A Simple 7-Day First Path</h2>
        </div>
        <a href="/start-here/">Need orientation?</a>
      </div>
      <ol class="path-list">
        {firstPath.map((item) => (
          <li>
            <span>{item.day}</span>
            <a href={item.href}>{item.label}</a>
            <p>{item.note}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container prose">
      <span class="eyebrow">Beginner guardrails</span>
      <h2>What This Page Does and Does Not Try to Do</h2>
      <p>
        Echo Buddha introduces Buddhism in plain language, but Buddhist traditions are diverse. A Theravada explanation,
        a Zen teaching story, a Pure Land devotional practice, and a Vajrayana ritual context may emphasize different
        things. Beginner pages here use careful, general framing and point toward deeper study rather than pretending
        one short page can speak for every Buddhist community.
      </p>
      <p>
        The most useful beginning is not collecting concepts. It is learning enough to practice with less harm: a more
        honest sentence, a pause before anger, a kinder response to suffering, or a few steady breaths. When a topic
        becomes important to your life, compare teachers, translations, and communities with care.
      </p>
      <h2>Source and Interpretation Boundary</h2>
      <p>
        The traditional sources below anchor two central frameworks used throughout this learning path. The surrounding
        explanations, examples, sequence, and seven-day plan are Echo Buddha's modern editorial application. They are
        not presented as a translation, a complete account of all Buddhist traditions, or a substitute for a teacher or
        practice community.
      </p>
      <ul class="source-list">
        {sourceLinks.map((source) => (
          <li>
            <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>
            <span>{source.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .back-link {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .page-role-note {
    color: var(--color-muted);
    font-size: 0.95rem;
    font-weight: 700;
    margin-top: 0.9rem;
  }

  .practice-map {
    display: grid;
    gap: 1rem;
    margin-block: 1.5rem;
  }

  .practice-map > div {
    border-left: 3px solid var(--color-gold);
    padding-left: 1rem;
  }

  .practice-map h3 {
    margin-bottom: 0.35rem;
  }

  .practice-map p {
    margin: 0;
  }

  .source-list {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    padding-left: 0;
  }

  .source-list li {
    border-left: 3px solid var(--color-gold);
    padding-left: 0.85rem;
  }

  .source-list span {
    color: var(--color-muted);
    display: block;
    font-size: 0.94rem;
    margin-top: 0.15rem;
  }

  .section-heading {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .section-heading h2 {
    font-size: clamp(1.7rem, 4vw, 2.25rem);
  }

  .section-heading a {
    font-weight: 800;
  }

  .path-list {
    counter-reset: path;
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .path-list li {
    border-bottom: 1px solid var(--color-line);
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 0;
  }

  .path-list span {
    color: var(--color-green);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .path-list a {
    color: var(--color-brown);
    font-size: 1.08rem;
    font-weight: 900;
  }

  .path-list p {
    color: var(--color-muted);
    margin: 0;
  }
</style>

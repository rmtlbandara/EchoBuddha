---
import Layout from "../layouts/Layout.astro";

const title = "Terms and Conditions";
const description = "Read the terms and conditions for using Echo Buddha educational articles, quotes, and meditation guidance.";
---

<Layout title={title} description={description} canonicalPath="/terms-and-conditions/">
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Terms</span>
      <h1>Terms and Conditions</h1>
      <p class="lede">Last updated: June 22, 2026</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container prose">
      <h2>Use of the Website</h2>
      <p>
        By using Echo Buddha, you agree to use the website respectfully and lawfully. The content is provided for
        general educational and reflective purposes.
      </p>
      <h2>Content Ownership</h2>
      <p>
        Unless otherwise stated, articles, quotes, design, and original materials on this site belong to Echo Buddha.
        You may share short excerpts with clear attribution and a link back to the original page.
      </p>
      <h2>No Guarantee</h2>
      <p>
        Echo Buddha aims to provide thoughtful and accurate introductory content, but it does not guarantee that every
        article will be complete, error-free, or suitable for every reader.
      </p>
      <h2>Changes</h2>
      <p>
        These terms may be updated as the website grows, especially if newsletter, analytics, advertising, or community
        features are added.
      </p>
    </div>
  </section>
</Layout>

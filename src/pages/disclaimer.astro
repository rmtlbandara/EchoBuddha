---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/site";

const title = "Disclaimer";
const description = "Read the Echo Buddha disclaimer about educational content, meditation guidance, wellness topics, and spiritual study.";
const canonicalPath = "/disclaimer/";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: `${SITE.url}${canonicalPath}`,
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url
  }
};
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Disclaimer</span>
      <h1>Disclaimer</h1>
      <p class="lede">
        Echo Buddha is an educational website and should be read as a general reflective resource.
      </p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container prose">
      <h2>Educational Content</h2>
      <p>
        Articles and quotes are written as original, introductory reflections inspired by Buddhist themes. They are not
        a substitute for direct instruction from qualified teachers or careful study of Buddhist traditions.
      </p>
      <p>
        Buddhist teachings are summarized in plain language for general readers. Readers are encouraged to compare
        important teachings with reputable translations, qualified teachers, temples, and practice communities.
      </p>
      <h2>Meditation and Wellbeing</h2>
      <p>
        Meditation can be helpful for many people, but experiences vary. If meditation causes distress or if you are
        dealing with serious mental health concerns, consider seeking support from a qualified professional.
      </p>
      <p>
        Stop or shorten a practice if it feels overwhelming. Echo Buddha meditation pages are educational guides, not
        treatment plans, diagnoses, or crisis support.
      </p>
      <p>
        Breath-focused practice, silence, forgiveness, grief, anger, or difficult-person exercises may not be suitable
        in every situation. Open your eyes, use ordinary grounding, choose a different anchor, maintain necessary
        boundaries, or stop the practice when that is the safer choice.
      </p>
      <p>
        Read <a href="/meditation-safety/">Meditation Safety and Gentle Practice</a> for the site's fuller practice
        boundaries.
      </p>
      <h2>No Professional Advice</h2>
      <p>
        Echo Buddha does not provide medical, mental health, legal, financial, or individualized religious advice.
        Content should not be used to delay or replace help from a qualified professional.
      </p>
      <h2>External Resources</h2>
      <p>
        Links to external websites are provided for convenience and education. Echo Buddha does not control
        external content and does not endorse every view expressed outside this website.
      </p>
      <h2>Corrections</h2>
      <p>
        To report a source, quote, typo, clarity, or safety concern, use
        <a href="/corrections/">Corrections and Editorial Updates</a>.
      </p>
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";

const title = "Contact";
const description = "Contact Echo Buddha with questions, suggestions, article ideas, or general feedback about the website.";
---

<Layout title={title} description={description} canonicalPath="/contact/">
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Contact</span>
      <h1>Contact Echo Buddha</h1>
      <p class="lede">
        Send questions, corrections, topic suggestions, or thoughtful feedback about Echo Buddha.
      </p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container prose">
      <div class="surface contact-panel">
        <span class="eyebrow">Email</span>
        <h2>Write to Echo Buddha</h2>
        <p>Contact the editorial team at:</p>
        <p><a class="email-link" href="mailto:info.echobuddha@gmail.com">info.echobuddha@gmail.com</a></p>
        <p>
          Please include the page URL when reporting a correction. Personal medical, legal, or spiritual counseling
          cannot be provided by email.
        </p>
      </div>
      <div>
        <h2>Content Suggestions</h2>
        <p>
          Echo Buddha welcomes topic ideas about meditation, compassion, mindful living, and beginner-friendly
          Buddhist education.
        </p>
        <h2>Corrections</h2>
        <p>
          Accuracy and clarity matter. If you notice an error, unclear wording, or a broken link, contact us with
          enough detail to review the issue.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-panel {
    margin-bottom: 2rem;
    padding: 1.25rem;
  }

  .contact-panel h2 {
    font-size: clamp(1.7rem, 4vw, 2.25rem);
    margin-top: 0;
  }

  .email-link {
    font-size: clamp(1rem, 3vw, 1.25rem);
    font-weight: 800;
    overflow-wrap: anywhere;
  }
</style>

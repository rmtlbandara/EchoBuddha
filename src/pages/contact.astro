---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/site";
import { PUBLISHER_SCHEMA } from "../data/editorialGovernance";

const title = "Contact";
const description = "Contact Echo Buddha with questions, suggestions, article ideas, or general feedback about the website.";
const canonicalPath = "/contact/";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: title,
  description,
  url: `${SITE.url}${canonicalPath}`,
  mainEntity: {
    ...PUBLISHER_SCHEMA,
    email: SITE.email
  }
};
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Contact</span>
      <h1>Contact Echo Buddha</h1>
      <p class="lede">
        Send questions, corrections, topic suggestions, or thoughtful feedback about Echo Buddha.
      </p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container prose">
      <div class="surface contact-panel">
        <span class="eyebrow">Email</span>
        <h2>Write to Echo Buddha</h2>
        <p>Contact the Echo Buddha publisher at:</p>
        <p><a class="email-link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p>
          Please include the page URL when reporting a correction. Personal medical, legal, or spiritual counseling
          cannot be provided by email.
        </p>
        <p>
          Echo Buddha reads messages for editorial feedback, correction requests, and topic suggestions. A reply is not
          guaranteed, but clear correction reports are reviewed carefully. Read
          <a href="/corrections/">Corrections and Editorial Updates</a> for what to include.
        </p>
        <p>
          “Echo Buddha Editorial” is the site's organizational publication byline. It does not identify a named person
          or claim that an expert review team exists.
        </p>
      </div>
      <div>
        <h2>Content Suggestions</h2>
        <p>
          Echo Buddha welcomes topic ideas about meditation, compassion, mindful living, and beginner-friendly
          Buddhist education. Suggestions are most useful when they describe the reader question, not only a keyword.
        </p>
        <h2>Corrections</h2>
        <p>
          Accuracy and clarity matter. If you notice an error, unclear wording, or a broken link, contact us with
          enough detail to review the issue.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-panel {
    margin-bottom: 2rem;
    padding: 1.25rem;
  }

  .contact-panel h2 {
    font-size: clamp(1.7rem, 4vw, 2.25rem);
    margin-top: 0;
  }

  .email-link {
    font-size: clamp(1rem, 3vw, 1.25rem);
    font-weight: 800;
    overflow-wrap: anywhere;
  }
</style>

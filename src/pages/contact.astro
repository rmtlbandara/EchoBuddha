---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/site";
import { PUBLISHER_CONTACT_SCHEMA } from "../data/editorialGovernance";

const title = "Contact";
const description =
  "Contact Echo Buddha for editorial inquiries, corrections, content suggestions, accessibility, privacy settings, or website support.";
const canonicalPath = "/contact/";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: title,
  description,
  url: `${SITE.url}${canonicalPath}`,
  mainEntity: PUBLISHER_CONTACT_SCHEMA
};
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Contact</span>
      <h1>Contact Echo Buddha</h1>
      <p class="lede">
        Contact Echo Buddha about published content, thoughtful suggestions, corrections, or problems using the
        website.
      </p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container prose">
      <div class="contact-grid">
        <article class="surface contact-panel">
          <span class="eyebrow">General &amp; Editorial</span>
          <h2>Published content and general inquiries</h2>
          <p>
            Use this address for general or publisher inquiries, editorial feedback, content suggestions, source or
            quotation concerns, and correction reports.
          </p>
          <p>
            <a class="email-link" href={`mailto:${SITE.editorialEmail}`}>{SITE.editorialEmail}</a>
          </p>
        </article>
        <article class="surface contact-panel">
          <span class="eyebrow">Website Support</span>
          <h2>Help using the website</h2>
          <p>
            Use this address for technical problems, accessibility issues, privacy or consent settings, and trouble
            accessing site features.
          </p>
          <p>
            <a class="email-link" href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>
          </p>
        </article>
      </div>
      <div>
        <h2>Content Suggestions</h2>
        <p>
          Echo Buddha welcomes topic ideas about meditation, compassion, mindful living, and beginner-friendly
          Buddhist education. Suggestions are most useful when they describe the reader question, not only a keyword.
        </p>
        <h2>Reporting a Correction</h2>
        <p>
          A useful correction report includes the affected page URL, the relevant passage or section, an explanation
          of the concern, and a source or reference when applicable. Read
          <a href="/corrections/">Corrections and Editorial Updates</a> for the review process.
        </p>
        <p>
          Echo Buddha cannot provide individual medical, mental-health, legal, crisis, or personalized spiritual
          counseling by email. A reply is not guaranteed, but clear correction reports are reviewed carefully.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .contact-panel {
    padding: 1.25rem;
  }

  .contact-panel h2 {
    font-size: clamp(1.7rem, 4vw, 2.25rem);
    margin-top: 0;
  }

  .email-link {
    font-size: clamp(1rem, 3vw, 1.25rem);
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  @media (min-width: 760px) {
    .contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

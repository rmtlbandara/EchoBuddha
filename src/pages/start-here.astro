---
import Layout from "../layouts/Layout.astro";
import DailyReflectionCard from "../components/DailyReflectionCard.astro";
import { dailyReflections } from "../data/dailyReflections";
import { SITE } from "../data/site";

const title = "Start Here - Begin Your Buddhist Wisdom and Mindfulness Journey";
const description =
  "New to Echo Buddha? Start with simple Buddhist teachings, beginner meditation, daily reflections, and practical mindfulness guidance.";
const canonicalPath = "/start-here/";

const startingPaths = [
  {
    title: "I am new to Buddhism",
    description: "Learn what Buddhism is, then follow the foundations in a calm order.",
    href: "/learn/buddhism-for-beginners/",
    action: "Begin with Buddhism for Beginners"
  },
  {
    title: "I want to practice",
    description: "Choose a short, gentle meditation by experience, method, or difficulty.",
    href: "/meditation/",
    action: "Choose a meditation"
  },
  {
    title: "I want one thing for today",
    description: "Read a brief reflection with one practice and one journal question.",
    href: "/daily-reflections/today/",
    action: "Read today's reflection"
  }
];

const firstLearningSteps = [
  { label: "Understand what Buddhism is", href: "/learn/buddhism-101/what-is-buddhism/" },
  { label: "Learn the Four Noble Truths", href: "/learn/four-noble-truths/" },
  { label: "See the Noble Eightfold Path", href: "/learn/eightfold-path/" },
  { label: "Try meditation for beginners", href: "/meditation/meditation-for-beginners/" }
];

const laterPaths = [
  { label: "Look up a Buddhist term", href: "/learn/buddhist-dictionary/" },
  { label: "Read Dhammapada reflections", href: "/learn/dhammapada-reflections/" },
  { label: "Study a sutta in daily-life context", href: "/learn/sutta-for-daily-life/" },
  { label: "Read the first teaching context", href: "/learn/sutta-for-daily-life/dhammacakkappavattana-sutta-four-noble-truths/" },
  { label: "Read the Eightfold Path source note", href: "/learn/sutta-for-daily-life/magga-vibhanga-sutta-eightfold-path/" },
  { label: "Set up a comfortable meditation posture", href: "/meditation/meditation-posture-for-beginners/" },
  { label: "Try a 10-minute meditation", href: "/meditation/10-minute-meditation-practice/" },
  { label: "Search for a specific topic", href: "/search/" }
];

const faqItems = [
  {
    question: "Do I need prior Buddhist knowledge?",
    answer: "No. Start Here is an orientation page, and the beginner learning path explains terms as they appear."
  },
  {
    question: "Is Start Here the same as Buddhism for Beginners?",
    answer: "No. Start Here helps you choose what to do on Echo Buddha. Buddhism for Beginners teaches what to learn first about Buddhism."
  },
  {
    question: "Can I begin with meditation instead?",
    answer: "Yes. Choose a short beginner practice and use the linked safety guidance whenever you need to shorten, adapt, pause, or seek qualified support."
  }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: `${SITE.url}${canonicalPath}`,
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
      { "@type": "ListItem", position: 2, name: "Start Here", item: `${SITE.url}${canonicalPath}` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer }
    }))
  }
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">New to Echo Buddha</span>
      <h1>Begin Your Buddhist Wisdom and Mindfulness Journey</h1>
      <p class="lede">
        You do not need to understand every section of the site. Choose the reason you came, take one useful step,
        and return when you are ready.
      </p>
      <a class="button" href="/learn/buddhism-for-beginners/">Start learning about Buddhism</a>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">Choose your first action</span>
      <h2>What Would Help Today?</h2>
      <div class="path-grid">
        {startingPaths.map((path) => (
          <a class="surface path-card" href={path.href}>
            <h3>{path.title}</h3>
            <p>{path.description}</p>
            <strong>{path.action}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-band">
    <div class="container split">
      <div>
        <span class="eyebrow">If you are a complete newcomer</span>
        <h2>Four First Steps</h2>
        <p class="lede">
          Learn one foundation at a time. These pages explain the path; Start Here only gives you the order.
        </p>
        <ol class="first-steps">
          {firstLearningSteps.map((step) => <li><a href={step.href}>{step.label}</a></li>)}
        </ol>
      </div>
      <DailyReflectionCard reflection={dailyReflections[0]} compact />
    </div>
  </section>

  <section class="section">
    <div class="container later-grid">
      <div>
        <span class="eyebrow">When you know what you need</span>
        <h2>Go Deeper Without Starting Over</h2>
        <p>
          Dictionary and source-study pages are available when a term or teaching needs more context. They do not
          need to be part of your first visit.
        </p>
      </div>
      <nav class="later-links surface" aria-label="Later learning and search paths">
        {laterPaths.map((path) => <a href={path.href}>{path.label}</a>)}
      </nav>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">Before you begin</span>
      <h2>Helpful Questions</h2>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="surface faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .path-grid,
  .faq-list {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }

  .path-card {
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    text-decoration: none;
  }

  .path-card p {
    color: var(--color-muted);
  }

  .path-card strong {
    color: var(--color-green);
    margin-top: auto;
  }

  .path-card:hover,
  .path-card:focus-visible {
    border-color: var(--color-green);
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .first-steps {
    display: grid;
    gap: 0.65rem;
    padding-left: 1.25rem;
  }

  .first-steps a,
  .later-links a {
    font-weight: 800;
  }

  .later-grid {
    display: grid;
    gap: 1.25rem 2rem;
  }

  .later-grid p {
    color: var(--color-muted);
  }

  .later-links {
    display: grid;
    gap: 0;
    padding: 0.5rem 1.1rem;
  }

  .later-links a {
    padding: 0.7rem 0;
  }

  .later-links a + a {
    border-top: 1px solid var(--color-line);
  }

  .faq-item {
    padding: 1rem 1.1rem;
  }

  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-serif);
    font-weight: 700;
  }

  .faq-item p {
    color: var(--color-muted);
    margin: 0.75rem 0 0;
  }

  @media (min-width: 720px) {
    .path-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .later-grid {
      align-items: start;
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr);
    }
  }
</style>

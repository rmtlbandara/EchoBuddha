---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { SITE, fullArticles } from "../../data/site";
import { EDITORIAL_AUTHOR_SCHEMA, EDITORIAL_IDENTITY, PUBLISHER_SCHEMA } from "../../data/editorialGovernance";

const title = "Echo Buddha Editorial";
const description = "Understand the organizational Echo Buddha Editorial byline used for accessible Buddhist-inspired education, reflection, and meditation guidance.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: title,
  description,
  url: `${SITE.url}/authors/echo-buddha-editorial/`,
  mainEntity: {
    ...EDITORIAL_AUTHOR_SCHEMA,
    description:
      "The organizational publication byline used for original educational and reflective material published by Echo Buddha. It is not a named person or professional credential.",
    parentOrganization: PUBLISHER_SCHEMA
  },
  publisher: PUBLISHER_SCHEMA
};
---

<Layout title={title} description={description} canonicalPath="/authors/echo-buddha-editorial/" jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Editorial profile</span>
      <h1>Echo Buddha Editorial</h1>
      <p class="lede">
        The organizational publication byline used for original articles, quote reflections, and meditation guidance
        published by Echo Buddha.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container prose">
      <h2>What This Byline Means</h2>
      <p>
        “Echo Buddha Editorial” is a publication label, not the name of a person, a claim that a multi-person editorial
        team exists, or a professional credential. It identifies material published under the Echo Buddha name.
        Echo Buddha remains responsible for publication decisions and corrections through its public contact at
        <a href={`mailto:${EDITORIAL_IDENTITY.contactEmail}`}>{EDITORIAL_IDENTITY.contactEmail}</a>.
      </p>
      <p>
        The publication focuses on clear, respectful introductions to Buddhist-inspired wisdom, mindfulness,
        compassion, reflection, and meditation practice. It does not claim monastic status, religious rank, academic
        endorsement, clinical expertise, or personal spiritual authority. An internal source, safety, editorial, or
        technical check is not external expert certification.
      </p>
      <p>
        The aim is to put contemplative themes into practical language while acknowledging the depth and diversity of
        Buddhist traditions. Readers seeking formal religious instruction should learn from appropriately qualified
        teachers and established communities.
      </p>
      <p>
        Review the <a href="/editorial-policy/">Editorial Policy</a> or
        <a href="/how-echo-buddha-creates-content/">how Echo Buddha creates content</a>. To report a source, quote,
        typo, or safety concern, use <a href="/corrections/">Corrections and Editorial Updates</a>.
      </p>
    </div>
  </section>

  <section class="section section-band">
    <div class="container">
      <span class="eyebrow">Selected writing</span>
      <h2>Articles by Echo Buddha Editorial</h2>
      <div class="grid grid--3">
        {fullArticles.slice(0, 6).map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }
</style>

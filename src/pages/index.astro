---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import ArticleCard from "../components/ArticleCard.astro";
import QuoteCard from "../components/QuoteCard.astro";
import { SITE, fullArticles, quotes, type Quote } from "../data/site";

const title = SITE.title;
const description =
  "Echo Buddha shares beginner-friendly Buddhist wisdom, meditation guides, Dhammapada reflections, and practical mindfulness articles for a calmer daily life.";
const ogTitle = SITE.title;
const ogDescription = description;
const twitterTitle = SITE.title;
const twitterDescription = description;

const getPublishedTime = (date: string) => {
  const timestamp = Date.parse(date);
  return Number.isNaN(timestamp) ? Number.NEGATIVE_INFINITY : timestamp;
};

const homepageArticles = [...fullArticles]
  .sort((a, b) => getPublishedTime(b.date) - getPublishedTime(a.date))
  .slice(0, 6);

const featuredQuoteThemes = [
  "Mindfulness",
  "Compassion",
  "Patience",
  "Awareness",
  "Letting Go",
  "Practice",
  "Meditation",
  "Wisdom"
];

const featuredQuotes = featuredQuoteThemes
  .map((theme) => quotes.find((quote) => quote.theme === theme))
  .filter((quote): quote is Quote => Boolean(quote));

const guideCards = [
  {
    title: "Learn Buddhist Wisdom",
    href: "/learn/",
    description: "Learn core ideas with gentle, practical explanations made for everyday reflection.",
    tone: "wisdom"
  },
  {
    title: "Buddhist Dictionary",
    href: "/learn/buddhist-dictionary/",
    description: "Explore clear meanings for Buddhist terms such as metta, karma, anicca, and mindfulness.",
    tone: "dictionary"
  },
  {
    title: "Dhammapada Reflections",
    href: "/learn/dhammapada-reflections/",
    description: "Read simple reflections inspired by classic Buddhist wisdom for daily life.",
    tone: "dhammapada"
  },
  {
    title: "Meditation Practice",
    href: "/meditation/",
    description: "Start with breathing, walking, loving-kindness, and short mindful practice guides.",
    tone: "meditation"
  },
  {
    title: "Questions About Buddhism",
    href: "/learn/questions-about-buddhism/",
    description: "Find beginner-friendly answers to common questions about Buddhist ideas and practice.",
    tone: "questions"
  },
  {
    title: "Latest Articles",
    href: "/articles/",
    description: "Read practical Buddhist-inspired articles on wisdom, mindfulness, compassion, and letting go.",
    tone: "articles"
  }
];

const resourceLinks = [
  { label: "Daily Mindfulness", href: "/learn/buddhism-101/what-is-mindfulness/" },
  { label: "Meditation Guide", href: "/meditation-guide/" },
  { label: "Buddhist Quotes", href: "/quotes/" },
  { label: "Search Echo Buddha", href: "/search/" }
];

const practiceSteps = [
  "Sit comfortably and let the shoulders soften.",
  "Notice one natural breath from beginning to end.",
  "Return gently when the mind becomes distracted.",
  "End with one kind intention for the day."
];

const faqItems = [
  {
    question: "What is Echo Buddha?",
    answer:
      "Echo Buddha is a calm online space for original Buddhist-inspired articles, quotes, learning pages, and meditation guidance for daily life."
  },
  {
    question: "Is Echo Buddha suitable for beginners?",
    answer:
      "Yes. The writing is simple, respectful, and practical, so new readers can begin with basic Buddhist wisdom, mindfulness, and meditation without needing prior study."
  },
  {
    question: "What can I read first?",
    answer:
      "A good first step is the beginner article library, the meditation guide, or a short quote story that gives you one idea to reflect on during the day."
  },
  {
    question: "Does Echo Buddha provide meditation guidance?",
    answer:
      "Echo Buddha offers simple educational meditation guidance, including breathing, posture, and gentle attention practices. It is not a replacement for medical or mental health care."
  }
];

const homepageJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: SITE.url
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Featured Echo Buddha articles",
    itemListElement: homepageArticles.map((article, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: article.title,
      url: `${SITE.url}/articles/${article.slug}/`
    }))
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  twitterTitle={twitterTitle}
  twitterDescription={twitterDescription}
  jsonLd={homepageJsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Buddhist wisdom for daily life</span>
        <h1>Echo Buddha</h1>
        <p class="hero-subtitle">
          A calm learning space for Buddhist wisdom, mindfulness, meditation, and daily reflection.
        </p>
        <p class="lede">
          Read original, beginner-friendly reflections written for peaceful daily practice. Explore short quotes,
          thoughtful articles, and simple meditation guidance without noise or pressure.
        </p>
        <div class="hero-actions" aria-label="Homepage quick links">
          <a class="button" href="/articles/">Read Articles</a>
          <a class="button button--secondary" href="/meditation-guide/">Start Meditating</a>
          <a class="hero-text-link" href="/quotes/">Explore Quotes</a>
        </div>
        <ul class="hero-values" aria-label="Echo Buddha values">
          <li>Original reflections</li>
          <li>Beginner-friendly guides</li>
          <li>Calm daily practice</li>
        </ul>
      </div>
      <picture class="hero-visual">
        <source
          media="(max-width: 639px)"
          srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
        />
        <img
          class="hero-art"
          src="/images/hero-buddha.avif"
          alt="Peaceful Buddha illustration with lotus and soft natural colors"
          width="960"
          height="960"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </div>
  </section>

  <section class="section guide-section">
    <div class="container">
      <div class="section-intro">
        <span class="eyebrow">Start gently</span>
        <h2>Choose a Gentle Place to Begin</h2>
        <p>
          Follow the path that fits your day, whether you want a short reflection, a practical teaching,
          or a few quiet minutes with the breath.
        </p>
      </div>
      <div class="guide-grid">
        {
          guideCards.map((card) => (
            <a class="guide-card surface" href={card.href}>
              <span class:list={["guide-icon", `guide-icon--${card.tone}`]} aria-hidden="true">
                <span></span>
              </span>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <span class="guide-link">Begin here</span>
            </a>
          ))
        }
      </div>
      <nav class="resource-links" aria-label="More learning resources">
        {resourceLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="search-callout surface">
        <div>
          <h3>Looking for a teaching, term, or quote?</h3>
          <p>Search the Echo Buddha library by topic, practice, Buddhist term, article, or quote theme.</p>
        </div>
        <a class="button button--secondary" href="/search/">Open search</a>
      </div>
    </div>
  </section>

  <div class="container ad-placement">
    <AdSlot />
  </div>

  <section class="section section-band">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Latest articles</span>
          <h2>New Reflections</h2>
          <p>
            Beginner-friendly readings on Buddhist wisdom, mindful living, ethical speech, letting go,
            and a steadier relationship with thought.
          </p>
        </div>
      </div>

      <div class="article-grid">
        {homepageArticles.map((article) => <ArticleCard article={article} />)}
      </div>
      <div class="section-end-link">
        <a class="button button--secondary" href="/articles/">View all articles</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading section-heading--simple">
        <div>
          <span class="eyebrow">Featured quotes</span>
          <h2>Small Lines for a Steady Day</h2>
          <p>Short original reflections with story pages for quiet reading and gentle daily reminders.</p>
        </div>
      </div>
      <div class="quote-grid">
        {featuredQuotes.map((quote) => <QuoteCard quote={quote} />)}
      </div>
      <div class="section-end-link">
        <a class="button button--secondary" href="/quotes/">View all quotes</a>
      </div>
    </div>
  </section>

  <section class="section meditation-section">
    <div class="container split">
      <div>
        <span class="eyebrow">Meditation guidance</span>
        <h2>Begin With One Breath</h2>
        <p class="lede">
          Meditation does not need to begin with a long session. A few quiet minutes can teach the mind to notice,
          return, and meet the day with a softer kind of attention.
        </p>
        <a class="button" href="/meditation-guide/">Open the meditation guide</a>
      </div>
      <div class="practice-panel surface">
        <h3>A Four-Step Starter Practice</h3>
        <ol>
          {practiceSteps.map((step) => <li>{step}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section about-section">
    <div class="container about-grid">
      <div>
        <span class="eyebrow">About Echo Buddha</span>
        <h2>Why Echo Buddha Exists</h2>
      </div>
      <div class="about-copy">
        <p>
          Echo Buddha publishes original Buddhist-inspired educational reflections for readers who want calm,
          practical wisdom in daily life. The writing is designed to be clear, respectful, and useful rather
          than loud or commercial.
        </p>
        <p>
          Readers can learn through articles, quote stories, meditation guidance, and simple paths through
          Buddhist ideas without needing to rush.
        </p>
        <div class="about-links" aria-label="Trust and contact links">
          <a href="/about/">About</a>
          <a href="/editorial-policy/">Editorial Policy</a>
          <a href="/contact/">Contact</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container">
      <div class="section-intro">
        <span class="eyebrow">Quick questions</span>
        <h2>Beginner FAQ</h2>
      </div>
      <div class="faq-list">
        {
          faqItems.map((item) => (
            <details class="faq-item surface">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <div class="container ad-placement ad-placement--lower">
    <AdSlot />
  </div>
</Layout>

<style>
  .hero {
    padding: 3.25rem 0 2.75rem;
  }

  .hero-grid {
    align-items: center;
    display: grid;
    gap: 2.25rem;
  }

  .hero-subtitle {
    color: var(--color-brown);
    font-family: var(--font-serif);
    font-size: 1.45rem;
    line-height: 1.32;
    margin-bottom: 1rem;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero-text-link {
    color: var(--color-green);
    display: inline-flex;
    font-weight: 800;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.55rem 0.25rem;
  }

  .hero-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 1.35rem 0 0;
    padding: 0;
  }

  .hero-values li {
    background: rgba(255, 253, 248, 0.82);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-muted);
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.48rem 0.72rem;
  }

  .hero-visual {
    display: block;
    margin-inline: auto;
    width: min(76vw, 24rem);
  }

  .hero-art {
    aspect-ratio: 1;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .section-intro {
    max-width: 46rem;
    margin-bottom: 1.5rem;
  }

  .section-intro p,
  .section-heading p {
    color: var(--color-muted);
    margin-bottom: 0;
  }

  .guide-section {
    padding-top: 2rem;
  }

  .guide-grid,
  .article-grid,
  .quote-grid {
    display: grid;
    gap: 1.15rem;
  }

  .guide-card {
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    min-height: 13.25rem;
    padding: 1.35rem;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .guide-card:hover,
  .guide-card:focus-visible {
    border-color: rgba(95, 127, 98, 0.42);
    box-shadow: 0 18px 42px rgba(74, 55, 31, 0.1);
    transform: translateY(-2px);
  }

  .guide-card h3 {
    font-size: 1.25rem;
    margin-top: 1rem;
  }

  .guide-card p {
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .guide-icon {
    align-items: center;
    background: rgba(185, 133, 36, 0.1);
    border: 1px solid rgba(185, 133, 36, 0.18);
    border-radius: 50%;
    display: inline-flex;
    height: 3rem;
    justify-content: center;
    width: 3rem;
  }

  .guide-icon span {
    background: var(--color-gold);
    border-radius: 50%;
    box-shadow:
      0 0.58rem 0 rgba(95, 127, 98, 0.45),
      0.58rem 0 0 rgba(151, 93, 47, 0.34),
      -0.58rem 0 0 rgba(151, 93, 47, 0.28);
    display: block;
    height: 0.72rem;
    width: 0.72rem;
  }

  .guide-icon--meditation {
    background: rgba(95, 127, 98, 0.12);
    border-color: rgba(95, 127, 98, 0.2);
  }

  .guide-icon--meditation span,
  .guide-icon--questions span {
    background: var(--color-green);
  }

  .guide-icon--dictionary span,
  .guide-icon--dhammapada span {
    background: var(--color-brown);
  }

  .guide-icon--articles {
    background: rgba(151, 93, 47, 0.1);
    border-color: rgba(151, 93, 47, 0.18);
  }

  .guide-link {
    color: var(--color-green);
    display: inline-block;
    font-weight: 800;
    margin-top: auto;
  }

  .resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.25rem;
  }

  .resource-links a {
    background: rgba(255, 253, 248, 0.72);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-brown);
    font-size: 0.9rem;
    font-weight: 800;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
  }

  .resource-links a:hover,
  .resource-links a:focus-visible {
    border-color: rgba(95, 127, 98, 0.4);
    color: var(--color-green);
  }

  .search-callout {
    align-items: center;
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
    padding: 1.2rem;
  }

  .search-callout h3 {
    font-size: 1.25rem;
  }

  .search-callout p {
    color: var(--color-muted);
    margin-bottom: 0;
  }

  .search-callout .button {
    width: 100%;
  }

  .ad-placement {
    padding: 0.5rem 0;
  }

  .ad-placement :global(.ad-slot) {
    background: rgba(255, 255, 255, 0.46);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    margin: 0.25rem 0;
    min-height: 4.75rem;
  }

  .ad-placement--lower :global(.ad-slot) {
    margin: 0.25rem 0 1.75rem;
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .section-heading {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-heading > div {
    max-width: 46rem;
  }

  .section-heading--simple {
    align-items: start;
  }

  .article-grid :global(.article-card),
  .quote-grid :global(.quote-card) {
    height: 100%;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .article-grid :global(.article-card:hover),
  .article-grid :global(.article-card:focus-within),
  .quote-grid :global(.quote-card:hover),
  .quote-grid :global(.quote-card:focus-within) {
    border-color: rgba(95, 127, 98, 0.38);
    box-shadow: 0 18px 42px rgba(74, 55, 31, 0.1);
    transform: translateY(-2px);
  }

  .article-grid :global(.article-body > p:not(.article-kicker)) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .article-grid :global(.article-body h3) {
    line-height: 1.2;
  }

  .quote-grid :global(.quote-card) {
    display: flex;
    flex-direction: column;
    min-height: 12.25rem;
    overflow: hidden;
    padding: 1.35rem;
  }

  .quote-grid :global(.quote-card::before) {
    color: rgba(185, 133, 36, 0.14);
    font-size: 3.1rem;
    top: 0.55rem;
  }

  .quote-grid :global(.quote-card blockquote) {
    font-size: 1.18rem;
    line-height: 1.5;
    margin: 1rem 0 1.1rem;
  }

  .quote-grid :global(.quote-card figcaption) {
    border-top: 1px solid rgba(232, 223, 210, 0.84);
    margin-top: auto;
    padding-top: 0.85rem;
  }

  .quote-grid :global(.quote-card .story-link) {
    color: var(--color-brown);
    font-weight: 800;
  }

  .section-end-link {
    display: flex;
    justify-content: flex-start;
    margin-top: 1.35rem;
  }

  .meditation-section {
    background:
      linear-gradient(180deg, rgba(255, 253, 248, 0) 0%, rgba(247, 240, 229, 0.5) 100%);
  }

  .practice-panel {
    padding: 1.5rem;
  }

  .practice-panel h3 {
    font-size: 1.35rem;
  }

  .practice-panel ol {
    counter-reset: step;
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin-bottom: 0;
    padding-left: 0;
  }

  .practice-panel li {
    align-items: start;
    color: var(--color-muted);
    display: grid;
    gap: 0.75rem;
    grid-template-columns: auto minmax(0, 1fr);
  }

  .practice-panel li::before {
    align-items: center;
    background: rgba(95, 127, 98, 0.12);
    border: 1px solid rgba(95, 127, 98, 0.22);
    border-radius: 50%;
    color: var(--color-green);
    content: counter(step);
    counter-increment: step;
    display: inline-flex;
    font-size: 0.84rem;
    font-weight: 800;
    height: 1.75rem;
    justify-content: center;
    width: 1.75rem;
  }

  .about-section {
    background: rgba(255, 253, 248, 0.54);
    border-block: 1px solid var(--color-line);
  }

  .about-grid {
    display: grid;
    gap: 1rem;
  }

  .about-copy {
    color: var(--color-muted);
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .about-links a {
    color: var(--color-green);
    font-weight: 800;
  }

  .faq-list {
    display: grid;
    gap: 0.85rem;
  }

  .faq-item {
    padding: 1.1rem 1.2rem;
  }

  .faq-item summary {
    color: var(--color-ink);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .faq-item p {
    color: var(--color-muted);
    margin: 0.75rem 0 0;
  }

  @media (min-width: 640px) {
    .guide-grid,
    .article-grid,
    .quote-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .search-callout {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .search-callout .button {
      width: auto;
    }
  }

  @media (max-width: 639px) {
    .hero {
      padding: 2.65rem 0 2rem;
    }

    .hero-grid {
      gap: 0;
    }

    .hero-visual {
      display: none;
    }

    .hero-subtitle {
      margin-bottom: 0.85rem;
    }

    .hero-actions {
      margin-top: 1.25rem;
    }

    .hero-actions .button {
      min-height: 3rem;
      padding-inline: 1rem;
    }

    .hero-values {
      margin-top: 1.15rem;
    }

    .guide-section {
      padding-top: 1.25rem;
    }

    .guide-card,
    .search-callout,
    .practice-panel,
    .faq-item {
      padding: 1.15rem;
    }

    .quote-grid :global(.quote-card) {
      min-height: 0;
      padding: 1.2rem;
    }
  }

  @media (min-width: 820px) {
    .hero {
      padding: 5rem 0 3.75rem;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.78fr);
      gap: 3rem;
    }

    .hero-subtitle {
      font-size: 1.8rem;
    }

    .guide-grid,
    .article-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .quote-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .about-grid {
      grid-template-columns: minmax(12rem, 0.8fr) minmax(0, 1.3fr);
    }

    .section-end-link {
      justify-content: flex-end;
    }
  }
</style>

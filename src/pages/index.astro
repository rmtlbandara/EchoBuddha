---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import ArticleCard from "../components/ArticleCard.astro";
import QuoteCard from "../components/QuoteCard.astro";
import { SITE, fullArticles, quotes } from "../data/site";

const title = "Echo Buddha | Buddhist Wisdom, Quotes & Meditation for Daily Life";
const description = "Read original Buddhist-inspired quotes, meditation guidance, and practical mindfulness articles for a calmer daily life.";
const featuredQuotes = quotes.slice(0, 6);
const latestArticles = fullArticles.slice(0, 6);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    email: SITE.email
  }
];
---

<Layout title={title} description={description} canonicalPath="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Buddhist wisdom for daily life</span>
        <h1>Echo Buddha</h1>
        <p class="hero-subtitle">Timeless Buddhist wisdom for a peaceful mind</p>
        <p class="lede">
          Explore original reflections, gentle meditation guidance, and simple teachings inspired by Buddhist practice.
          Echo Buddha is built for quiet reading, steady learning, and a kinder relationship with the mind.
        </p>
        <div class="hero-actions">
          <a class="button" href="/articles/">Read Articles</a>
          <a class="button button--secondary" href="/meditation-guide/">Start Meditating</a>
        </div>
      </div>
      <div class="hero-visual">
        <img
          class="hero-art"
          src="/images/hero-mindful-lotus.webp"
          alt="Minimal lotus, sun, and leaf illustration for mindful Buddhist reflection"
          width="960"
          height="960"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <div class="container">
    <AdSlot />
  </div>

  <section class="section section-band">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Latest articles</span>
          <h2>New Reflections</h2>
        </div>
      </div>
      <div class="grid grid--3">
        {latestArticles.map((article) => <ArticleCard article={article} />)}
      </div>
      <div class="section-end-link">
        <a href="/articles/">View all articles</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Featured quotes</span>
      <h2>Small Lines for a Steady Day</h2>
      <div class="grid grid--3">
        {featuredQuotes.map((quote) => <QuoteCard quote={quote} />)}
      </div>
      <div class="section-end-link">
        <a href="/quotes/">View all quotes</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Meditation guidance</span>
        <h2>Begin With One Breath</h2>
        <p class="lede">
          A calm meditation practice can begin in a few minutes. Learn posture, breathing, gentle attention,
          and how to return when the mind wanders.
        </p>
        <a class="button" href="/meditation-guide/">Open the guide</a>
      </div>
      <div class="practice-panel surface">
        <h3>Simple Daily Rhythm</h3>
        <ol>
          <li>Pause and notice the body.</li>
          <li>Follow three natural breaths.</li>
          <li>Return with kindness when distracted.</li>
          <li>End by choosing one compassionate action.</li>
        </ol>
      </div>
    </div>
  </section>

  <div class="container">
    <AdSlot />
  </div>
</Layout>

<style>
  .hero {
    padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(2rem, 6vw, 4rem);
  }

  .hero-grid {
    align-items: center;
    display: grid;
    gap: 2rem;
  }

  .hero-subtitle {
    color: var(--color-brown);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero-visual {
    margin-inline: auto;
    width: min(78vw, 24rem);
  }

  .hero-art {
    aspect-ratio: 1;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .section-heading {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .section-heading a {
    font-weight: 800;
  }

  .section-end-link {
    margin-top: 1.25rem;
    text-align: right;
  }

  .section-end-link a {
    font-weight: 800;
  }

  .practice-panel {
    padding: 1.5rem;
  }

  .practice-panel ol {
    margin-bottom: 0;
    padding-left: 1.25rem;
  }

  @media (min-width: 820px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.75fr);
    }
  }
</style>

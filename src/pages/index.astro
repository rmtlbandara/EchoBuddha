---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getBuddhistQuestion, getBuddhistQuestionPath } from "../data/buddhistQuestions";
import { dailyReflections } from "../data/dailyReflections";
import { fullArticles } from "../data/site";

const title = "Buddhist Wisdom, Learning & Meditation | Echo Buddha";
const description =
  "Explore Buddhist teachings, practical meditation, and everyday application through clear, source-aware guidance for beginners and returning readers.";
const ogTitle = title;
const ogDescription = description;
const twitterTitle = title;
const twitterDescription = description;

const featuredGuideSlugs = [
  "right-speech-buddhism",
  "three-poisons-buddhism-explained",
  "how-to-let-go-of-attachment-in-buddhism"
] as const;

const featuredGuides = featuredGuideSlugs.map((slug) => {
  const article = fullArticles.find((candidate) => candidate.slug === slug);
  if (!article) throw new Error(`Missing curated homepage guide: ${slug}`);
  return article;
});

const corePaths = [
  {
    eyebrow: "Understand",
    title: "Learn Buddhism",
    href: "/learn/",
    description: "Follow a clear sequence through Buddhist foundations, key terms, and source-aware study.",
    linkLabel: "Explore the learning paths"
  },
  {
    eyebrow: "Practice",
    title: "Practice Meditation",
    href: "/meditation/",
    description: "Choose a beginner, breathing, walking, loving-kindness, or short practice with safety guidance.",
    linkLabel: "Choose a meditation practice"
  },
  {
    eyebrow: "Live",
    title: "Apply the Teachings",
    href: "/mindful-living/",
    description: "Bring Buddhist perspectives to speech, work, relationships, emotions, and everyday choices.",
    linkLabel: "Explore mindful living"
  }
];

const beginnerPath = [
  {
    label: "What Is Buddhism?",
    href: "/learn/buddhism-101/what-is-buddhism/",
    description: "Meet Buddhism as a path of understanding, ethics, and practice."
  },
  {
    label: "Four Noble Truths",
    href: "/learn/four-noble-truths/",
    description: "Understand suffering, its causes, release, and the work of the path."
  },
  {
    label: "Noble Eightfold Path",
    href: "/learn/eightfold-path/",
    description: "See how wisdom, conduct, and mental training support one another."
  },
  {
    label: "Meditation for Beginners",
    href: "/meditation/meditation-for-beginners/",
    description: "Try a short, gentle practice with clear ways to adapt or stop."
  }
];

const todayUtilities = [
  {
    label: "Try a 10-minute meditation",
    href: "/meditation/10-minute-meditation-practice/",
    description: "A short guided practice for a little more space in the day."
  },
  {
    label: "Use the practice tools",
    href: "/tools/",
    description: "Open the timer, daily prompt, glossary, or seven-day practice."
  }
];

const featuredQuestion = getBuddhistQuestion("respecting-buddha-after-parinibbana");
if (!featuredQuestion) throw new Error("Missing curated homepage Buddhist question");

const featuredDailyReflection = dailyReflections[0];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  twitterTitle={twitterTitle}
  twitterDescription={twitterDescription}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Echo Buddha · Learning, practice, everyday life</span>
        <h1>Buddhist Wisdom for Everyday Life</h1>
        <p class="lede">
          Learn Buddhist foundations, choose a meditation practice, and apply the teachings through clear,
          source-aware guidance—no prior study needed.
        </p>
        <div class="hero-actions" aria-label="Homepage starting points">
          <a class="button" href="/start-here/">Start Here</a>
          <a class="button button--secondary" href="/meditation/">Choose a Meditation</a>
        </div>
      </div>
      <picture class="hero-visual">
        <source
          media="(max-width: 819px)"
          srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
        />
        <img
          class="hero-art"
          src="/images/hero-buddha.avif"
          alt="Peaceful Buddha illustration with lotus and soft natural colors"
          width="960"
          height="960"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </div>
  </section>

  <section class="section pathway-section">
    <div class="container">
      <div class="section-intro">
        <span class="eyebrow">Choose by what you need</span>
        <h2>Choose Your Path</h2>
        <p>Start with understanding, a practice, or one area of daily life. Each route has a distinct purpose.</p>
      </div>
      <nav class="pathway-grid" aria-label="Core Echo Buddha pathways">
        {corePaths.map((path) => (
          <a class="pathway-card surface" href={path.href}>
            <span class="eyebrow">{path.eyebrow}</span>
            <h3>{path.title}</h3>
            <p>{path.description}</p>
            <strong>{path.linkLabel}</strong>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section section-band foundations-section">
    <div class="container">
      <div class="section-intro">
        <span class="eyebrow">New to Buddhism?</span>
        <h2>Start With the Foundations</h2>
        <p>These four pages form a focused first sequence. Read one at a time; no prior study is assumed.</p>
      </div>
      <ol class="beginner-path">
        {beginnerPath.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
            <span>{item.description}</span>
          </li>
        ))}
      </ol>
      <a class="text-cta" href="/learn/buddhism-for-beginners/">Open the complete Buddhism for Beginners guide <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section guides-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Recommended reading</span>
          <h2>Featured Guides</h2>
          <p>
            Three intentionally selected guides cover ethical speech, the roots of unskillful action, and letting go.
            They are featured for their usefulness—not simply because they are newest.
          </p>
        </div>
        <a class="text-cta" href="/articles/">Browse the article library <span aria-hidden="true">→</span></a>
      </div>
      <div class="article-grid">
        {featuredGuides.map((article) => <ArticleCard article={article} showShare={false} />)}
      </div>
    </div>
  </section>

  <section class="section handbook-home" aria-labelledby="homepage-handbook-heading">
    <div class="container handbook-home__grid">
      <picture>
        <source srcset="/images/handbook/refined/buddhist-life-practice-handbook-800.avif 800w, /images/handbook/refined/buddhist-life-practice-handbook.avif 1600w" sizes="(min-width: 900px) 44vw, 100vw" type="image/avif" />
        <img src="/images/handbook/refined/buddhist-life-practice-handbook.webp" srcset="/images/handbook/refined/buddhist-life-practice-handbook-800.webp 800w, /images/handbook/refined/buddhist-life-practice-handbook.webp 1600w" sizes="(min-width: 900px) 44vw, 100vw" alt="A Bodhi tree, palm-leaf manuscript, alms bowl, and path toward a stupa at dawn" width="1600" height="900" loading="lazy" decoding="async" />
      </picture>
      <div>
        <span class="eyebrow">Structured study · Eight chapters</span>
        <h2 id="homepage-handbook-heading">Buddhist Life & Practice Handbook</h2>
        <p class="lede">Study the Triple Gem, taking refuge, Theravāda traditions, respectful practice, and the relationship between laypeople and the Saṅgha in one source-aware sequence.</p>
        <a class="button button--secondary" href="/learn/buddhist-handbook/">Explore the Handbook</a>
      </div>
    </div>
  </section>

  <section class="section section-band today-section">
    <div class="container today-grid">
      <div class="today-reflection">
        <span class="eyebrow">A useful moment for today</span>
        <h2>Pause With One Reflection</h2>
        <blockquote>“{featuredDailyReflection.reflection}”</blockquote>
        <p>
          Today's page pairs one original Echo Buddha reflection with a brief meaning, practice, and journal question.
        </p>
        <a class="button" href="/daily-reflections/today/">Open Today's Reflection</a>
      </div>
      <nav class="today-links" aria-label="Short daily practice options">
        {todayUtilities.map((path) => (
          <a href={path.href}>
            <strong>{path.label}</strong>
            <span>{path.description}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section deeper-questions" aria-labelledby="homepage-deeper-questions-heading">
    <div class="container question-gateway">
      <div>
        <span class="eyebrow">Source-aware study</span>
        <h2 id="homepage-deeper-questions-heading">Questions About Buddhist Tradition</h2>
        <p>
          Explore careful answers that distinguish early texts, later traditions, historical evidence, and modern
          interpretation when those layers matter.
        </p>
        <a class="text-cta" href="/learn/questions-about-buddhism/">Explore all Questions About Buddhism <span aria-hidden="true">→</span></a>
      </div>
      <article class="question-highlight">
        <span class="eyebrow">From the question library</span>
        <h3><a href={getBuddhistQuestionPath(featuredQuestion)}>{featuredQuestion.title}</a></h3>
        <p>{featuredQuestion.description}</p>
        <a class="question-highlight__link" href={getBuddhistQuestionPath(featuredQuestion)}>Read this source-aware answer <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <section class="section about-section">
    <div class="container about-grid">
      <div>
        <span class="eyebrow">About Echo Buddha</span>
        <h2>Why Readers Can Trust the Care Behind the Work</h2>
      </div>
      <div class="about-copy">
        <p>
          Echo Buddha publishes original editorial explanations and practical reflections. Traditional sources,
          paraphrase, later commentary, historical evidence, and original Echo Buddha writing are distinguished where
          those differences matter.
        </p>
        <p>
          The publication does not claim monastic, academic, medical, or institutional authority. Its content process,
          source approach, author identity, corrections path, and meditation-safety boundaries are open to readers.
        </p>
        <div class="about-links" aria-label="Publisher and editorial trust links">
          <a href="/about/">About</a>
          <a href="/authors/echo-buddha-editorial/">Echo Buddha Editorial</a>
          <a href="/how-echo-buddha-creates-content/">Content Process</a>
          <a href="/buddhist-sources-and-citations/">Sources & Citations</a>
          <a href="/corrections/">Corrections</a>
          <a href="/meditation-safety/">Meditation Safety</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero {
    padding: 3.25rem 0 2.75rem;
  }

  .hero-grid {
    align-items: center;
    display: grid;
    gap: 2.25rem;
  }

  .hero h1 {
    font-size: clamp(2.65rem, 6.4vw, 5.15rem);
    max-width: 16ch;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero-visual {
    display: block;
    margin-inline: auto;
    width: min(76vw, 24rem);
  }

  .hero-art {
    aspect-ratio: 1;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .section-intro {
    margin-bottom: 1.5rem;
    max-width: 46rem;
  }

  .section-intro p,
  .section-heading p,
  .pathway-card p,
  .question-gateway p,
  .today-reflection p,
  .about-copy {
    color: var(--color-muted);
  }

  .pathway-section {
    padding-top: 2rem;
  }

  .pathway-grid,
  .article-grid {
    display: grid;
    gap: 1.15rem;
  }

  .pathway-card {
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    min-height: 15rem;
    padding: 1.4rem;
    text-decoration: none;
  }

  .pathway-card h3 {
    font-size: 1.45rem;
  }

  .pathway-card strong {
    color: var(--color-green);
    margin-top: auto;
  }

  .pathway-card:hover,
  .pathway-card:focus-visible {
    border-color: rgba(79, 111, 82, 0.42);
  }

  .pathway-card:nth-child(1) {
    border-top: 4px solid var(--color-gold);
  }

  .pathway-card:nth-child(2) {
    border-top: 4px solid var(--color-green);
  }

  .pathway-card:nth-child(3) {
    border-top: 4px solid var(--color-brown);
  }

  .beginner-path {
    counter-reset: foundation-step;
    display: grid;
    gap: 1.15rem;
    list-style: none;
    margin: 1.75rem 0 1.4rem;
    padding: 0;
  }

  .beginner-path li {
    border-top: 1px solid var(--color-line);
    counter-increment: foundation-step;
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    padding-top: 1rem;
  }

  .beginner-path li::before {
    color: var(--color-green);
    content: "0" counter(foundation-step);
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .beginner-path a,
  .text-cta {
    font-weight: 800;
  }

  .beginner-path a {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.25;
    text-decoration: none;
  }

  .beginner-path a:hover {
    color: var(--color-green);
  }

  .beginner-path span {
    color: var(--color-muted);
    font-size: 0.94rem;
  }

  .text-cta {
    align-items: center;
    color: var(--color-green);
    display: inline-flex;
    min-height: 2.75rem;
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .section-heading {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-heading > div {
    max-width: 46rem;
  }

  .handbook-home {
    background: linear-gradient(135deg, rgba(235, 243, 232, 0.58), rgba(247, 240, 229, 0.64));
    border-bottom: 1px solid var(--color-line);
  }

  .handbook-home__grid {
    align-items: center;
    display: grid;
    gap: 1.5rem 3rem;
  }

  .handbook-home picture,
  .handbook-home img {
    display: block;
  }

  .handbook-home img {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius) * 1.25);
    box-shadow: var(--shadow-soft);
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .article-grid :global(.article-card) {
    height: 100%;
  }

  .today-grid {
    display: grid;
    gap: 1.5rem 2.5rem;
  }

  .today-reflection {
    max-width: 42rem;
  }

  .today-reflection blockquote {
    border-left: 3px solid var(--color-gold);
    color: var(--color-brown);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 3vw, 1.65rem);
    line-height: 1.45;
    margin: 1.15rem 0;
    padding-left: 1rem;
  }

  .today-links {
    align-content: start;
    display: grid;
    gap: 0.65rem;
  }

  .today-links a {
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-ink);
    display: grid;
    gap: 0.18rem;
    padding: 0.9rem 1rem;
    text-decoration: none;
  }

  .today-links a:hover,
  .today-links a:focus-visible {
    border-color: var(--color-green);
  }

  .today-links strong {
    color: var(--color-green);
  }

  .today-links span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .deeper-questions {
    background: rgba(255, 253, 248, 0.54);
  }

  .question-gateway {
    align-items: start;
    display: grid;
    gap: 1.75rem 3rem;
  }

  .question-highlight {
    border-left: 3px solid var(--color-gold);
    min-width: 0;
    padding-left: 1.25rem;
  }

  .question-highlight h3 {
    font-size: clamp(1.4rem, 3vw, 1.75rem);
  }

  .question-highlight h3 a {
    color: var(--color-ink);
    display: inline-block;
    text-decoration: none;
  }

  .question-highlight h3 a:hover {
    color: var(--color-green);
  }

  .question-highlight__link {
    font-weight: 800;
  }

  .about-section {
    background: rgba(255, 253, 248, 0.54);
    border-block: 1px solid var(--color-line);
  }

  .about-grid {
    display: grid;
    gap: 1rem;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .about-links a {
    color: var(--color-green);
    font-weight: 800;
  }

  @media (min-width: 640px) {
    .pathway-grid,
    .article-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .beginner-path {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 819px) {
    .hero {
      padding: 2rem 0 1.6rem;
    }

    .hero-grid {
      gap: 0;
    }

    .hero-visual {
      display: none;
    }

    .hero-actions .button {
      min-height: 3rem;
    }

    .pathway-card {
      min-height: 0;
    }
  }

  @media (max-width: 360px) {
    .hero h1 {
      font-size: 2.3rem;
      max-width: none;
    }
  }

  @media (min-width: 820px) {
    .handbook-home__grid {
      grid-template-columns: minmax(300px, 0.9fr) minmax(0, 1.1fr);
    }

    .hero {
      padding: 4.5rem 0 3.5rem;
    }

    .hero-grid {
      gap: 3rem;
      grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.78fr);
    }

    .today-grid,
    .question-gateway {
      align-items: start;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .about-grid {
      grid-template-columns: minmax(12rem, 0.8fr) minmax(0, 1.3fr);
    }
  }

  @media (min-width: 960px) {
    .beginner-path {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

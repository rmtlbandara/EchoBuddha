---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import DailyReflectionCard from "../components/DailyReflectionCard.astro";
import { getBuddhistQuestion, getBuddhistQuestionPath } from "../data/buddhistQuestions";
import { dailyReflections } from "../data/dailyReflections";
import { SITE, fullArticles } from "../data/site";

const title = "Echo Buddha - Buddhist Wisdom for a Calmer Everyday Life";
const description =
  "Explore simple Buddhist teachings, daily reflections, quote meanings, beginner meditation guides, and mindfulness practices for a calmer everyday life.";
const ogTitle = title;
const ogDescription = description;
const twitterTitle = SITE.title;
const twitterDescription = description;

const getPublishedTime = (date: string) => {
  const timestamp = Date.parse(date);
  return Number.isNaN(timestamp) ? Number.NEGATIVE_INFINITY : timestamp;
};

const homepageArticles = [...fullArticles]
  .sort((a, b) => getPublishedTime(b.date) - getPublishedTime(a.date))
  .slice(0, 3);

const corePaths = [
  {
    eyebrow: "Understand",
    title: "Learn Buddhist Teachings",
    href: "/learn/",
    description: "Begin with Buddhism, follow the foundations, learn key terms, or read source-aware text notes.",
    linkLabel: "Choose a learning path"
  },
  {
    eyebrow: "Practice",
    title: "Choose a Meditation",
    href: "/meditation/",
    description: "Find a beginner, breathing, walking, loving-kindness, or short practice that fits today.",
    linkLabel: "Find a suitable practice"
  },
  {
    eyebrow: "Read & reflect",
    title: "Explore Everyday Wisdom",
    href: "/articles/",
    description: "Read editorial guidance on Buddhist ideas, mindful living, relationships, speech, and daily choices.",
    linkLabel: "Browse practical articles"
  }
];

const beginnerPath = [
  { label: "What Is Buddhism?", href: "/learn/buddhism-101/what-is-buddhism/" },
  { label: "Four Noble Truths", href: "/learn/four-noble-truths/" },
  { label: "Noble Eightfold Path", href: "/learn/eightfold-path/" },
  { label: "Beginner Meditation", href: "/meditation/meditation-for-beginners/" }
];

const returnPaths = [
  {
    label: "Read Today's Reflection",
    href: "/daily-reflections/today/",
    description: "One short reflection, practice, and journal question."
  },
  {
    label: "Browse Original Quotes",
    href: "/quotes/",
    description: "Clearly labelled Echo Buddha lines with fuller reflection stories."
  },
  {
    label: "Open Practice Tools",
    href: "/tools/",
    description: "Use a timer, daily prompt, glossary, or simple seven-day practice."
  }
];

const homepageQuestionSlugs = [
  "did-buddha-order-buddha-images",
  "respecting-buddha-after-parinibbana",
  "is-buddha-image-only-uddesika-cetiya"
] as const;

const homepageQuestions = homepageQuestionSlugs.map((slug) => {
  const question = getBuddhistQuestion(slug);

  if (!question) {
    throw new Error(`Missing curated homepage Buddhist question: ${slug}`);
  }

  return question;
});

const featuredDailyReflection = dailyReflections[0];

const faqItems = [
  {
    question: "What is Echo Buddha?",
    answer:
      "Echo Buddha is a calm online space for original Buddhist-inspired articles, quotes, learning pages, and meditation guidance for daily life."
  },
  {
    question: "Is Echo Buddha suitable for beginners?",
    answer:
      "Yes. The writing is simple, respectful, and practical, so new readers can begin with basic Buddhist wisdom, mindfulness, and meditation without needing prior study."
  },
  {
    question: "What can I read first?",
    answer:
      "A good first step is the beginner article library, the meditation guide, or a short quote story that gives you one idea to reflect on during the day."
  },
  {
    question: "Does Echo Buddha provide meditation guidance?",
    answer:
      "Echo Buddha offers simple educational meditation guidance, including breathing, posture, and gentle attention practices. It is not a replacement for medical or mental health care."
  }
];

const homepageJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: SITE.url
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Featured Echo Buddha articles",
    itemListElement: homepageArticles.map((article, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: article.title,
      url: `${SITE.url}/articles/${article.slug}/`
    }))
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/"
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  twitterTitle={twitterTitle}
  twitterDescription={twitterDescription}
  jsonLd={homepageJsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Buddhist wisdom for a calmer everyday life</span>
        <h1>Echo Buddha</h1>
        <p class="hero-subtitle">Learn Buddhist teachings, practice meditation, and reflect in daily life.</p>
        <p class="lede">
          Clear, source-aware learning and gentle practices for beginners and returning readers—without requiring
          prior Buddhist knowledge.
        </p>
        <div class="hero-actions" aria-label="Homepage starting points">
          <a class="button" href="/start-here/">New here? Start here</a>
          <a class="button button--secondary" href="/daily-reflections/today/">Today's Reflection</a>
          <a class="hero-text-link" href="/meditation/">Choose a meditation</a>
        </div>
      </div>
      <picture class="hero-visual">
        <source
          media="(max-width: 639px)"
          srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=="
        />
        <img
          class="hero-art"
          src="/images/hero-buddha.avif"
          alt="Peaceful Buddha illustration with lotus and soft natural colors"
          width="960"
          height="960"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </div>
  </section>

  <section class="section pathway-section">
    <div class="container">
      <div class="section-intro">
        <span class="eyebrow">Choose by what you need</span>
        <h2>Learn, Practice, or Read and Reflect</h2>
        <p>Each path has a different purpose. You can begin with one and leave the rest for another day.</p>
      </div>
      <nav class="pathway-grid" aria-label="Core Echo Buddha pathways">
        {corePaths.map((path) => (
          <a class="pathway-card surface" href={path.href}>
            <span class="eyebrow">{path.eyebrow}</span>
            <h3>{path.title}</h3>
            <p>{path.description}</p>
            <strong>{path.linkLabel}</strong>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section section-band">
    <div class="container split">
      <div>
        <span class="eyebrow">A beginner's first steps</span>
        <h2>Start With the Foundations</h2>
        <p class="lede">
          Start Here explains how to use Echo Buddha. When you are ready to learn, these four pages form a simple
          first sequence.
        </p>
        <ol class="beginner-path">
          {beginnerPath.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ol>
        <a class="button button--secondary beginner-link" href="/start-here/">See the newcomer guide</a>
      </div>
      <DailyReflectionCard reflection={featuredDailyReflection} compact />
    </div>
  </section>


  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Editorial reading</span>
          <h2>Recent Articles for Daily Life</h2>
          <p>
            Practical articles explore situations and questions in more depth. For a structured sequence, use the
            Learn section instead.
          </p>
        </div>
        <a class="button button--secondary" href="/articles/">Browse all articles</a>
      </div>
      <div class="article-grid">
        {homepageArticles.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section section-band">
    <div class="container return-grid">
      <div class="return-intro">
        <span class="eyebrow">For a quiet return</span>
        <h2>Come Back for One Useful Moment</h2>
        <p>
          You do not need to follow a long path each time. Read one reflection, sit for a few minutes, or keep one
          original line with you through the day.
        </p>
      </div>
      <nav class="return-links" aria-label="Returning visitor paths">
        {returnPaths.map((path) => (
          <a href={path.href}>
            <strong>{path.label}</strong>
            <span>{path.description}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section deeper-questions" aria-labelledby="homepage-deeper-questions-heading">
    <div class="container">
      <div class="section-intro">
        <span class="eyebrow">Source-aware study</span>
        <h2 id="homepage-deeper-questions-heading">Deeper Questions About Buddhist Tradition</h2>
        <p>
          Some Buddhist questions deserve a longer, source-aware answer. Explore explanations that carefully
          distinguish early texts, later tradition, historical evidence, and modern interpretation when those layers
          matter.
        </p>
      </div>
      <div class="question-grid">
        {homepageQuestions.map((question) => (
          <article class="surface question-card">
            <span class="eyebrow">{question.eyebrow}</span>
            <h3><a href={getBuddhistQuestionPath(question)}>{question.title}</a></h3>
            <p>{question.description}</p>
            <a class="question-card__link" href={getBuddhistQuestionPath(question)}>
              Read the full answer <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
      <a
        class="button button--secondary deeper-questions__cta"
        href="/learn/questions-about-buddhism/#deeper-questions-heading"
      >
        Explore all deeper questions <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section about-section">
    <div class="container about-grid">
      <div>
        <span class="eyebrow">About Echo Buddha</span>
        <h2>A Calm, Accountable Publication</h2>
      </div>
      <div class="about-copy">
        <p>
          Echo Buddha publishes original Buddhist-inspired educational reflections for readers who want calm,
          practical wisdom in daily life. The writing is designed to be clear, respectful, and useful rather than loud
          or commercial.
        </p>
        <p>
          Sources, editorial responsibility, quote origins, correction paths, and meditation-safety boundaries remain
          available for readers who want to verify how the publication works.
        </p>
        <div class="about-links" aria-label="Publisher and editorial trust links">
          <a href="/about/">About</a>
          <a href="/how-echo-buddha-creates-content/">Content Process</a>
          <a href="/buddhist-sources-and-citations/">Sources & Citations</a>
          <a href="/corrections/">Corrections</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container">
      <div class="section-intro">
        <span class="eyebrow">Quick questions</span>
        <h2>Beginner FAQ</h2>
      </div>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item surface">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero {
    padding: 3.25rem 0 2.75rem;
  }

  .hero-grid {
    align-items: center;
    display: grid;
    gap: 2.25rem;
  }

  .hero-subtitle {
    color: var(--color-brown);
    font-family: var(--font-serif);
    font-size: 1.45rem;
    line-height: 1.32;
    margin-bottom: 1rem;
    max-width: 42rem;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero-text-link {
    align-items: center;
    color: var(--color-green);
    display: inline-flex;
    font-weight: 800;
    min-height: 2.75rem;
    padding: 0.55rem 0.25rem;
  }

  .hero-visual {
    display: block;
    margin-inline: auto;
    width: min(76vw, 24rem);
  }

  .hero-art {
    aspect-ratio: 1;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .section-intro {
    margin-bottom: 1.5rem;
    max-width: 46rem;
  }

  .section-intro p,
  .section-heading p,
  .pathway-card p,
  .question-card p,
  .return-intro p,
  .about-copy {
    color: var(--color-muted);
  }

  .pathway-section {
    padding-top: 2rem;
  }

  .pathway-grid,
  .article-grid {
    display: grid;
    gap: 1.15rem;
  }

  .pathway-card {
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
    min-height: 15rem;
    padding: 1.4rem;
    text-decoration: none;
  }

  .pathway-card h3 {
    font-size: 1.45rem;
  }

  .pathway-card strong {
    color: var(--color-green);
    margin-top: auto;
  }

  .pathway-card:hover,
  .pathway-card:focus-visible {
    border-color: rgba(79, 111, 82, 0.42);
  }

  .beginner-path {
    display: grid;
    gap: 0.55rem;
    margin: 1.25rem 0;
    padding-left: 1.25rem;
  }

  .beginner-path a {
    font-weight: 800;
  }

  .beginner-link {
    margin-top: 0.25rem;
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .section-heading {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-heading > div {
    max-width: 46rem;
  }

  .article-grid :global(.article-card) {
    height: 100%;
  }

  .return-grid {
    display: grid;
    gap: 1.5rem 2.5rem;
  }

  .return-intro {
    max-width: 35rem;
  }

  .return-links {
    display: grid;
    gap: 0.65rem;
  }

  .return-links a {
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-ink);
    display: grid;
    gap: 0.18rem;
    padding: 0.9rem 1rem;
    text-decoration: none;
  }

  .return-links a:hover,
  .return-links a:focus-visible {
    border-color: var(--color-green);
  }

  .return-links strong {
    color: var(--color-green);
  }

  .return-links span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .deeper-questions {
    background: rgba(255, 253, 248, 0.54);
  }

  .question-grid {
    display: grid;
    gap: 1.15rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .question-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.35rem;
  }

  .question-card h3 {
    font-size: 1.45rem;
  }

  .question-card h3 a {
    color: var(--color-ink);
    display: inline-block;
  }

  .question-card h3 a:hover {
    color: var(--color-green);
  }

  .question-card__link {
    font-weight: 800;
    margin-top: auto;
  }

  .deeper-questions__cta {
    margin-top: 1.5rem;
  }

  .question-card__link span,
  .deeper-questions__cta span {
    margin-left: 0.2rem;
  }

  .about-section {
    background: rgba(255, 253, 248, 0.54);
    border-block: 1px solid var(--color-line);
  }

  .about-grid {
    display: grid;
    gap: 1rem;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .about-links a {
    color: var(--color-green);
    font-weight: 800;
  }

  .faq-list {
    display: grid;
    gap: 0.85rem;
  }

  .faq-item {
    padding: 1.1rem 1.2rem;
  }

  .faq-item summary {
    color: var(--color-ink);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .faq-item p {
    color: var(--color-muted);
    margin: 0.75rem 0 0;
  }

  .ad-placement {
    padding: 0.5rem 0;
  }

  .ad-placement :global(.ad-slot) {
    background: rgba(255, 255, 255, 0.46);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    margin: 0.25rem 0;
    min-height: 4.75rem;
  }

  .ad-placement--lower :global(.ad-slot) {
    margin: 0.25rem 0 1.75rem;
  }

  @media (min-width: 640px) {
    .pathway-grid,
    .article-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .hero {
      padding: 2.65rem 0 2rem;
    }

    .hero-grid {
      gap: 0;
    }

    .hero-visual {
      display: none;
    }

    .hero-actions .button {
      min-height: 3rem;
    }

    .pathway-card {
      min-height: 0;
    }
  }

  @media (min-width: 820px) {
    .hero {
      padding: 5rem 0 3.75rem;
    }

    .hero-grid {
      gap: 3rem;
      grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.78fr);
    }

    .hero-subtitle {
      font-size: 1.8rem;
    }

    .return-grid {
      align-items: start;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .about-grid {
      grid-template-columns: minmax(12rem, 0.8fr) minmax(0, 1.3fr);
    }
  }
</style>

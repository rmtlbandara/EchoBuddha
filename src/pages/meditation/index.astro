---
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { SITE } from "../../data/site";
import { getBreadcrumbJsonLd } from "../../data/learn";

const title = "Beginner Meditation Guides and Mindfulness Practices";
const description =
  "Learn simple meditation practices, breathing exercises, walking meditation, and mindful awareness techniques for beginners.";
const canonicalPath = "/meditation/";

const practiceGroups = [
  {
    eyebrow: "Start",
    title: "New or Short on Time",
    description: "Begin gently, learn a comfortable posture, or choose a short session.",
    links: [
      { label: "Meditation for Beginners", href: "/meditation/meditation-for-beginners/" },
      { label: "5-Minute Meditation", href: "/meditation/5-minute-meditation-practice/" },
      { label: "10-Minute Meditation", href: "/meditation/10-minute-meditation-practice/" },
      { label: "Meditation Posture", href: "/meditation/meditation-posture-for-beginners/" }
    ]
  },
  {
    eyebrow: "Choose a method",
    title: "Match the Practice to the Day",
    description: "Use breath, movement, loving-kindness, or daily activity as the practice support.",
    links: [
      { label: "Breathing Meditation", href: "/meditation/breathing-meditation/" },
      { label: "Walking Meditation", href: "/meditation/walking-meditation/" },
      { label: "Loving-Kindness Meditation", href: "/meditation/loving-kindness-meditation/" },
      { label: "Mindfulness in Daily Life", href: "/meditation/mindfulness-in-daily-life/" }
    ]
  },
  {
    eyebrow: "Adapt",
    title: "When Practice Feels Difficult",
    description: "Shorten, ground, change method, or pause rather than turning meditation into a performance.",
    links: [
      { label: "When Meditation Feels Hard", href: "/meditation/when-meditation-feels-hard/" },
      { label: "Five Hindrances", href: "/learn/buddhism-101/five-hindrances-in-buddhism/" },
      { label: "Meditation Safety", href: "/meditation-safety/" }
    ]
  }
];

const sourceLinks = [
  {
    label: "Anapanasati Sutta (MN 118)",
    href: "https://www.accesstoinsight.org/tipitaka/mn/mn.118.than.html",
    note: "Classical source for mindfulness of breathing."
  },
  {
    label: "Maha-satipatthana Sutta (DN 22)",
    href: "https://www.accesstoinsight.org/tipitaka/dn/dn.22.0.than.html",
    note: "Traditional source for mindfulness in posture, walking, and ordinary activities."
  }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: `${SITE.url}${canonicalPath}`,
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url }
  },
  getBreadcrumbJsonLd([
    { name: "Home", href: "/" },
    { name: "Meditation", href: "/meditation/" }
  ])
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Practice</span>
      <h1>Beginner Meditation Guides and Mindfulness Practices</h1>
      <p class="lede">
        Choose a practice by experience, method, or difficulty. Each guide explains what to do without demanding a
        special result.
      </p>
      <a class="button" href="/meditation/meditation-for-beginners/">Start with beginner meditation</a>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">Find a suitable practice</span>
      <h2>Start, Choose a Method, or Get Help</h2>
      <div class="practice-grid">
        {practiceGroups.map((group) => (
          <section class="surface practice-group">
            <span class="eyebrow">{group.eyebrow}</span>
            <h3>{group.title}</h3>
            <p>{group.description}</p>
            <ul>
              {group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
            </ul>
          </section>
        ))}
      </div>
      <AdSlot />
    </div>
  </section>

  <section class="section section-band">
    <div class="container safety-grid">
      <div>
        <span class="eyebrow">Safety and adaptation</span>
        <h2>Practice Gently</h2>
        <p class="lede">
          Meditation is educational and reflective. It is not a replacement for medical or mental health care. If
          practice feels overwhelming, open your eyes, feel your feet, shorten the session, or seek qualified support.
        </p>
        <p>
          Read <a href="/meditation-safety/">Meditation Safety and Gentle Practice</a> for the full safety standard
          used across Echo Buddha meditation pages.
        </p>
      </div>
      <aside class="surface source-note" aria-labelledby="practice-sources-heading">
        <h3 id="practice-sources-heading">Practice Sources</h3>
        <ul>
          {sourceLinks.map((source) => (
            <li>
              <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>
              <span>{source.note}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container practice-next">
      <div>
        <span class="eyebrow">Practice context</span>
        <h2>Meditation Is a Training, Not a Performance</h2>
        <p>
          In Buddhist contexts, meditation is connected with ethics, wisdom, attention, compassion, and understanding
          the mind—not only relaxation. A short honest session can be more useful than forcing a long one.
        </p>
      </div>
      <nav aria-label="Meditation support links">
        <a href="/meditation-guide/">Read the full meditation guide</a>
        <a href="/tools/#timer-heading">Use the meditation timer</a>
        <a href="/learn/buddhism-101/what-is-mindfulness/">Understand mindfulness</a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .practice-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .practice-group,
  .source-note {
    padding: 1.25rem;
  }

  .practice-group h3 {
    font-size: 1.35rem;
  }

  .practice-group p,
  .practice-next p {
    color: var(--color-muted);
  }

  .practice-group ul,
  .source-note ul {
    display: grid;
    gap: 0.55rem;
    margin-bottom: 0;
    padding-left: 1.2rem;
  }

  .practice-group a,
  .source-note a,
  .practice-next a {
    font-weight: 800;
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .safety-grid,
  .practice-next {
    display: grid;
    gap: 1.5rem 2rem;
  }

  .source-note li {
    display: grid;
    gap: 0.2rem;
  }

  .source-note span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .practice-next nav {
    display: grid;
    gap: 0.55rem;
  }

  @media (min-width: 720px) {
    .practice-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .safety-grid,
    .practice-next {
      align-items: start;
      grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.75fr);
    }
  }
</style>

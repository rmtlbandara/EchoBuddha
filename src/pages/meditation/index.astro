---
import Layout from "../../layouts/Layout.astro";
import LearningCard from "../../components/LearningCard.astro";
import AdSlot from "../../components/AdSlot.astro";
import { SITE } from "../../data/site";
import { getBreadcrumbJsonLd, meditationHubTopics } from "../../data/learn";

const title = "Beginner Meditation Guides and Mindfulness Practices";
const description =
  "Learn simple meditation practices, breathing exercises, walking meditation, and mindful awareness techniques for beginners.";
const canonicalPath = "/meditation/";
const guideChoices = [
  { need: "New to meditation", label: "Meditation for Beginners", href: "/meditation/meditation-for-beginners/" },
  { need: "Busy day", label: "5-Minute Meditation", href: "/meditation/5-minute-meditation-practice/" },
  { need: "Restless mind", label: "Breathing Meditation", href: "/meditation/breathing-meditation/" },
  { need: "Emotional heaviness", label: "Loving-Kindness Meditation", href: "/meditation/loving-kindness-meditation/" },
  { need: "Cannot sit still", label: "Walking Meditation", href: "/meditation/walking-meditation/" },
  { need: "Daily awareness", label: "Mindfulness in Daily Life", href: "/meditation/mindfulness-in-daily-life/" },
  { need: "Need consistency", label: "10-Minute Meditation", href: "/meditation-guide/#ten-minute-practice" }
];
const meditationPathways = [
  {
    title: "Choose by Time",
    description: "Begin with a short session when the day is full.",
    links: [
      { label: "5-Minute Meditation", href: "/meditation/5-minute-meditation-practice/" },
      { label: "10-Minute Practice", href: "/meditation-guide/#ten-minute-practice" },
      { label: "Meditation Timer", href: "/tools/#timer-heading" }
    ]
  },
  {
    title: "Choose by Practice",
    description: "Let the practice fit the body and the day.",
    links: [
      { label: "Breathing Meditation", href: "/meditation/breathing-meditation/" },
      { label: "Walking Meditation", href: "/meditation/walking-meditation/" },
      { label: "Loving-Kindness Meditation", href: "/meditation/loving-kindness-meditation/" }
    ]
  },
  {
    title: "Choose by Difficulty",
    description: "Meet distraction, restlessness, and inconsistency without turning meditation into a performance.",
    links: [
      { label: "Meditation for Beginners", href: "/meditation/meditation-for-beginners/" },
      { label: "Common Difficulties", href: "/meditation-guide/#common-challenges" },
      { label: "Mindfulness in Daily Life", href: "/meditation/mindfulness-in-daily-life/" }
    ]
  },
  {
    title: "Safety-First Guidance",
    description: "Pause, shorten, ground, or seek qualified support when practice feels overwhelming.",
    links: [
      { label: "Meditation Safety", href: "/meditation-safety/" },
      { label: "Beginner Meditation", href: "/meditation/meditation-for-beginners/" },
      { label: "Daily Reflections", href: "/daily-reflections/" }
    ]
  }
];
const sourceLinks = [
  {
    label: "Anapanasati Sutta (MN 118)",
    href: "https://www.accesstoinsight.org/tipitaka/mn/mn.118.than.html",
    note: "Classical source for mindfulness of breathing."
  },
  {
    label: "Maha-satipatthana Sutta (DN 22)",
    href: "https://www.accesstoinsight.org/tipitaka/dn/dn.22.0.than.html",
    note: "Traditional source for mindfulness in posture, walking, and ordinary activities."
  }
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: `${SITE.url}${canonicalPath}`,
    isPartOf: {
      "@type": "WebSite",
      name: SITE.name,
      url: SITE.url
    }
  },
  getBreadcrumbJsonLd([
    { name: "Home", href: "/" },
    { name: "Meditation", href: "/meditation/" }
  ])
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Meditation</span>
      <h1>Beginner Meditation Guides and Mindfulness Practices</h1>
      <p class="lede">
        Gentle meditation guides for beginners, including breathing meditation, loving-kindness, walking meditation,
        daily mindfulness, and short practices for ordinary life.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <section class="surface pathway-chooser" aria-labelledby="meditation-pathway-heading">
        <span class="eyebrow">Practice pathways</span>
        <h2 id="meditation-pathway-heading">Choose a Practice Gently</h2>
        <div class="pathway-grid">
          {meditationPathways.map((path) => (
            <section class="pathway-card">
              <h3>{path.title}</h3>
              <p>{path.description}</p>
              <ul>
                {path.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
              </ul>
            </section>
          ))}
        </div>
      </section>
      <section class="surface guide-chooser" aria-labelledby="guide-chooser-heading">
        <span class="eyebrow">Choose your meditation guide</span>
        <h2 id="guide-chooser-heading">Start Where You Are Today</h2>
        <div class="guide-choice-grid">
          {guideChoices.map((choice) => (
            <a href={choice.href}>
              <span>{choice.need}</span>
              <strong>{choice.label}</strong>
            </a>
          ))}
        </div>
      </section>
      <div class="grid grid--3">
        {meditationHubTopics.map((item) => <LearningCard item={item} />)}
      </div>
      <AdSlot />
    </div>
  </section>

	  <section class="section section-band">
    <div class="container split">
      <div>
        <span class="eyebrow">Safety note</span>
        <h2>Practice Gently</h2>
        <p class="lede">
          Meditation is educational and reflective. It is not a replacement for medical or mental health care. If
          practice feels overwhelming, open your eyes, feel your feet, shorten the session, or seek qualified support.
        </p>
        <p>
          Read <a href="/meditation-safety/">Meditation Safety and Gentle Practice</a> for the full safety standard
          used across Echo Buddha meditation pages.
        </p>
        <div class="source-note">
          <h3>Practice Sources</h3>
          <ul class="source-list">
            {sourceLinks.map((source) => (
              <li>
                <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>
                <span>{source.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <a class="button" href="/meditation-guide/">Open the full meditation guide</a>
    </div>
	  </section>

  <section class="section section--tight">
    <div class="container prose">
      <span class="eyebrow">Practice context</span>
      <h2>Meditation Is a Training, Not a Performance</h2>
      <p>
        These guides present meditation as a gentle educational practice. In Buddhist contexts, meditation is often
        connected with ethics, wisdom, attention, compassion, and understanding the mind; it is not only a relaxation
        technique. A short honest session can be more useful than forcing a long session that leaves the body tense.
      </p>
      <p>
        If you are new, begin with posture, breath, and returning. If practice stirs distress, pause and ground yourself.
        Meditation can support wellbeing for some readers, but it should not replace medical or mental-health care when
        qualified support is needed.
      </p>
    </div>
  </section>
</Layout>

<style>
  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .guide-chooser {
    margin-bottom: 1.5rem;
    padding: 1.25rem;
  }

  .pathway-chooser {
    margin-bottom: 1.5rem;
    padding: 1.25rem;
  }

  .guide-chooser h2 {
    font-size: 1.45rem;
  }

  .pathway-chooser h2 {
    font-size: 1.45rem;
  }

  .pathway-grid {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .pathway-card {
    background: rgba(247, 240, 229, 0.58);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 0.95rem;
  }

  .pathway-card h3 {
    font-size: 1.12rem;
  }

  .pathway-card p {
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .pathway-card ul {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 0;
    padding-left: 1rem;
  }

  .guide-choice-grid {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .guide-choice-grid a {
    background: rgba(247, 240, 229, 0.58);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem;
    text-decoration: none;
  }

  .guide-choice-grid a:hover {
    border-color: var(--color-green);
  }

  .guide-choice-grid span {
    color: var(--color-muted);
    font-size: 0.84rem;
    font-weight: 800;
  }

  .guide-choice-grid strong {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1rem;
  }

  .source-note {
    margin-top: 1rem;
  }

  .source-note h3 {
    font-size: 1.2rem;
  }

  .source-list {
    display: grid;
    gap: 0.65rem;
    list-style: none;
    padding-left: 0;
  }

  .source-list li {
    border-left: 3px solid var(--color-gold);
    padding-left: 0.85rem;
  }

  .source-list span {
    color: var(--color-muted);
    display: block;
    font-size: 0.94rem;
    margin-top: 0.15rem;
  }

  @media (min-width: 720px) {
    .guide-choice-grid,
    .pathway-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .guide-choice-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

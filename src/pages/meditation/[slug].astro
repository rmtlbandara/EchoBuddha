---
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import LearningCard from "../../components/LearningCard.astro";
import { SITE } from "../../data/site";
import { allMeditationPages, getBreadcrumbJsonLd, type LearningPage } from "../../data/learn";

export function getStaticPaths() {
  return allMeditationPages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props as { page: LearningPage };
const canonicalPath = `/meditation/${page.slug}/`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: page.title,
    description: page.description,
    url: `${SITE.url}${canonicalPath}`,
    articleSection: "Meditation",
    author: {
      "@type": "Organization",
      name: SITE.author,
      url: `${SITE.url}/authors/echo-buddha-editorial/`
    },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      url: SITE.url
    }
  },
  getBreadcrumbJsonLd([
    { name: "Home", href: "/" },
    { name: "Meditation", href: "/meditation/" },
    { name: page.title, href: canonicalPath }
  ])
];
---

<Layout title={page.title} description={page.description} canonicalPath={canonicalPath} type="article" jsonLd={jsonLd}>
  <article>
    <header class="page-hero">
      <div class="container prose">
        <a class="back-link" href="/meditation/">Meditation</a>
        <span class="eyebrow">{page.eyebrow}</span>
        <h1>{page.title}</h1>
        <p class="lede">{page.intro}</p>
      </div>
    </header>

    <div class="container article-shell">
      <div class="prose">
        <aside class="surface key-box">
          <h2>Key Takeaway</h2>
          <p>{page.takeaway}</p>
        </aside>
        {page.sections.map((section, index) => (
          <>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
            {index === 1 && <AdSlot />}
          </>
        ))}
        {page.practice && (
          <aside class="surface key-box">
            <h2>Practice Today</h2>
            <p>{page.practice}</p>
          </aside>
        )}
        {page.sourceNote && (
          <section>
            <h2>Safety Note</h2>
            <p>{page.sourceNote}</p>
          </section>
        )}
      </div>
      <aside>
        <AdSlot size="box" />
      </aside>
    </div>
  </article>

  <section class="section section-band">
    <div class="container">
      <span class="eyebrow">Related meditation links</span>
      <h2>Continue Practice</h2>
      <div class="grid grid--3">
        {page.relatedLinks.map((item) => <LearningCard item={item} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .back-link {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .key-box {
    margin-bottom: 2rem;
    padding: 1.25rem;
  }

  .key-box h2 {
    font-size: 1.35rem;
    margin-top: 0;
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }
</style>

---
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import LearningCard from "../../components/LearningCard.astro";
import { SITE } from "../../data/site";
import {
  allMeditationPages,
  getBreadcrumbJsonLd,
  getLearningQualityNote,
  getSourceLinks,
  getTermLinks,
  type LearningPage
} from "../../data/learn";
import { getMeditationSafetyNotice, getTopicRole } from "../../data/editorialGovernance";

export function getStaticPaths() {
  return allMeditationPages.map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props as { page: LearningPage };
const canonicalPath = `/meditation/${page.slug}/`;
const qualityNote = getLearningQualityNote(page);
const termLinks = getTermLinks(page.terms);
const sourceLinks = getSourceLinks(page);
const meditationRole = getTopicRole(canonicalPath);
const safetyNotice = getMeditationSafetyNotice();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: page.title,
    description: page.description,
    url: `${SITE.url}${canonicalPath}`,
    articleSection: "Meditation",
    author: {
      "@type": "Organization",
      name: SITE.author,
      url: `${SITE.url}/authors/echo-buddha-editorial/`
    },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      url: SITE.url
    }
  },
  getBreadcrumbJsonLd([
    { name: "Home", href: "/" },
    { name: "Meditation", href: "/meditation/" },
    { name: page.title, href: canonicalPath }
  ])
];
---

<Layout title={page.title} description={page.description} canonicalPath={canonicalPath} type="article" jsonLd={jsonLd}>
  <article>
    <header class="page-hero">
      <div class="container prose">
        <a class="back-link" href="/meditation/">Meditation</a>
        <span class="eyebrow">{page.eyebrow}</span>
        <h1>{page.title}</h1>
        <p class="lede">{page.intro}</p>
        {meditationRole && <p class="page-role-note">{meditationRole.publicSummary}</p>}
      </div>
    </header>

    <div class="container article-shell">
      <div class="prose">
        <aside class="surface key-box">
          <h2>Practice in Brief</h2>
          <p>{page.takeaway}</p>
        </aside>
        <aside class="surface safety-box" aria-labelledby="meditation-safety-heading">
          <h2 id="meditation-safety-heading">Practice Safety</h2>
          {safetyNotice.map((notice) => <p>{notice}</p>)}
          <p>
            Read <a href="/meditation-safety/">Meditation Safety and Gentle Practice</a> for the fuller practice
            boundaries used across Echo Buddha.
          </p>
        </aside>
        {qualityNote && (
          <section class="learning-note" aria-labelledby="why-this-meditation-matters-heading">
            <h2 id="why-this-meditation-matters-heading">Purpose of This Practice</h2>
            <p>{qualityNote.why}</p>
          </section>
        )}
	        {page.sections.map((section, index) => (
	          <>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
            {index === 1 && <AdSlot />}
          </>
	        ))}
        <section class="practice-context" aria-labelledby="practice-context-heading">
          <h2 id="practice-context-heading">Before and After Practice</h2>
          <p>
            Before you begin, choose a length and posture that your body can sustain without strain. Buddhist meditation
            is often taught with ethics and wisdom, so the aim is not to perform calm but to notice experience clearly
            and respond with less harm.
          </p>
          <p>
            Afterward, take a moment before returning to the day. Notice whether speech, attention, or intention feels a
            little more workable. If practice feels agitating, shorten it, open your eyes, or return to ordinary grounding.
          </p>
        </section>
	        {qualityNote && (
          <aside class="surface key-box">
            <h2>A Difficulty to Expect</h2>
            <p>{qualityNote.clarification}</p>
          </aside>
        )}
        {page.practice && (
          <aside class="surface key-box">
            <h2>Try One Session</h2>
            <p>{page.practice}</p>
          </aside>
        )}
        {qualityNote && (
          <aside class="surface key-box">
            <h2>After the Session</h2>
            <p>{qualityNote.question}</p>
          </aside>
        )}
        {page.sourceNote && (
          <section>
            <h2>Safety Note</h2>
            <p>{page.sourceNote}</p>
            {meditationRole && (
              <p>
                This page serves as a <strong>{meditationRole.role}</strong> in the {meditationRole.cluster} topic
                cluster. Keep future advertising away from practice steps and safety guidance.
              </p>
            )}
            <p>
              Read the <a href="/meditation-safety/">Meditation Safety</a> and
              <a href="/disclaimer/">Disclaimer</a> for the site's meditation and wellbeing limitations, and the
              <a href="/editorial-policy/">Editorial Policy</a> for review standards.
            </p>
            {sourceLinks.length > 0 && (
              <>
                <h3>Practice Sources</h3>
                <ul class="source-list">
                  {sourceLinks.map((source) => (
                    <li>
                      <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>
                      <span>{source.note}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )}
      </div>
      <aside>
        {termLinks.length > 0 && (
          <div class="surface side-card">
            <span class="eyebrow">Related terms</span>
            <ul>
              {termLinks.map((term) => (
                <li>{term.href ? <a href={term.href}>{term.label}</a> : <span>{term.label}</span>}</li>
              ))}
            </ul>
          </div>
        )}
        <AdSlot size="box" />
      </aside>
    </div>
  </article>

  <section class="section section-band">
    <div class="container">
      <span class="eyebrow">Related meditation links</span>
      <h2>Continue Practice</h2>
      <div class="grid grid--3">
        {page.relatedLinks.map((item) => <LearningCard item={item} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .back-link {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .key-box,
  .safety-box {
    margin-bottom: 2rem;
    padding: 1.25rem;
  }

  .key-box h2,
  .safety-box h2 {
    font-size: 1.35rem;
    margin-top: 0;
  }

  .safety-box {
    border-left: 4px solid var(--color-green);
  }

  .safety-box p {
    color: var(--color-muted);
  }

  .page-role-note {
    color: var(--color-muted);
    font-size: 0.95rem;
    font-weight: 700;
    margin-top: 0.9rem;
  }

	  .learning-note {
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 2rem;
    padding-bottom: 0.5rem;
	  }

  .practice-context {
    border-block: 1px solid var(--color-line);
    margin: 2rem 0;
    padding: 0.5rem 0 1rem;
  }

  .source-list {
    display: grid;
    gap: 0.65rem;
    list-style: none;
    padding-left: 0;
  }

  .source-list li {
    border-left: 3px solid var(--color-gold);
    padding-left: 0.85rem;
  }

  .source-list span {
    color: var(--color-muted);
    display: block;
    font-size: 0.94rem;
    margin-top: 0.15rem;
  }

  .side-card {
    margin-bottom: 1rem;
    padding: 1.25rem;
  }

  .side-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .side-card li a,
  .side-card li span {
    background: var(--color-green-soft);
    border-radius: 999px;
    color: var(--color-green);
    display: inline-flex;
    font-size: 0.84rem;
    font-weight: 800;
    padding: 0.25rem 0.7rem;
    text-decoration: none;
  }

  .side-card li a:hover {
    color: var(--color-brown);
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }
</style>

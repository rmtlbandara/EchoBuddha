---
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ArticleShare from "../../components/ArticleShare.astro";
import QuoteCard from "../../components/QuoteCard.astro";
import {
  SITE,
  fullArticles,
  getArticleCategory,
  getArticleReadTime,
  getArticleSeoDetails,
  getArticleWordCount,
  getQuoteCategory,
  getQuoteThemeForArticleCategory,
  quotes,
  slugify
} from "../../data/site";

export function getStaticPaths() {
  return fullArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const canonicalPath = `/articles/${article.slug}/`;
const formattedDate = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric"
}).format(new Date(`${article.date}T00:00:00Z`));
const articleUrl = `${SITE.url}${canonicalPath}`;
const articleImageUrl = new URL(article.thumbnail, SITE.url).toString();
const category = getArticleCategory(article.category);
const seoDetails = getArticleSeoDetails(article.slug);
const readTime = getArticleReadTime(article);
const wordCount = getArticleWordCount(article);
const formattedReviewedDate = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric"
}).format(new Date(`${seoDetails.reviewedDate}T00:00:00Z`));
const sectionsWithIds = article.content.map((section) => ({
  ...section,
  id: section.heading ? slugify(section.heading) : ""
}));
const tableOfContents = sectionsWithIds.filter((section) => section.heading);
const selectedRelatedArticles = (article.relatedSlugs ?? [])
  .map((slug) => fullArticles.find((item) => item.slug === slug))
  .filter(Boolean);
const relatedArticles = selectedRelatedArticles.length > 0
  ? selectedRelatedArticles
  : fullArticles
      .filter((item) => item.slug !== article.slug && item.category === article.category)
      .slice(0, 3);
const relatedQuoteTheme = getQuoteThemeForArticleCategory(article.category);
const relatedQuoteCategory = getQuoteCategory(relatedQuoteTheme);
const relatedQuotes = quotes.filter((quote) => quote.theme === relatedQuoteTheme).slice(0, 3);
const relatedBuddhistTerms = {
  "Buddhist Wisdom": [
    { label: "Dhamma", href: "/learn/buddhist-dictionary/dhamma/" },
    { label: "Karma", href: "/learn/buddhist-dictionary/karma/" },
    { label: "Dukkha", href: "/learn/buddhist-dictionary/dukkha/" }
  ],
  Meditation: [
    { label: "Sati", href: "/learn/buddhist-dictionary/sati/" },
    { label: "Mindfulness", href: "/learn/buddhist-dictionary/mindfulness/" },
    { label: "Metta", href: "/learn/buddhist-dictionary/metta/" }
  ],
  Mindfulness: [
    { label: "Sati", href: "/learn/buddhist-dictionary/sati/" },
    { label: "Mindfulness", href: "/learn/buddhist-dictionary/mindfulness/" },
    { label: "Anicca", href: "/learn/buddhist-dictionary/anicca/" }
  ],
  Reflection: [
    { label: "Anicca", href: "/learn/buddhist-dictionary/anicca/" },
    { label: "Dukkha", href: "/learn/buddhist-dictionary/dukkha/" },
    { label: "Anatta", href: "/learn/buddhist-dictionary/anatta/" }
  ],
  Practice: [
    { label: "Sati", href: "/learn/buddhist-dictionary/sati/" },
    { label: "Compassion", href: "/learn/buddhist-dictionary/compassion/" },
    { label: "Dhamma", href: "/learn/buddhist-dictionary/dhamma/" }
  ]
}[article.category] ?? [];
const practiceToday =
  article.category === "Meditation"
    ? "Pause for three natural breaths and return gently whenever attention wanders."
    : article.category === "Mindfulness"
      ? "Choose one ordinary task and give it your full attention for one minute."
      : article.category === "Practice"
        ? "Before one reply today, check whether your words are true, kind, useful, and timely."
        : article.category === "Reflection"
          ? "Notice one place where clinging tightens the body, then soften one breath around it."
          : "Ask what action would reduce harm in one situation you meet today.";
const reflectionQuestion =
  article.category === "Meditation"
    ? "What did this practice help you notice about the mind or body today?"
    : article.category === "Mindfulness"
      ? "Where did awareness create even a small pause before habit took over?"
      : article.category === "Practice"
        ? "Which ordinary action could become part of your Buddhist practice this week?"
        : article.category === "Reflection"
          ? "What are you holding tightly that may be asking for a softer relationship?"
          : "What would a wiser, less harmful response look like in one real situation?";
const needsWellbeingNote = [
  "how-to-meditate-for-anxiety",
  "mindfulness-for-better-sleep",
  "buddhist-approach-to-anger",
  "buddhist-wisdom-for-overthinking",
  "impermanence-in-buddhism"
].includes(article.slug);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": ["BlogPosting", "Article"],
    headline: article.title,
    description: article.description,
    url: articleUrl,
    datePublished: article.date,
    dateModified: seoDetails.reviewedDate,
    articleSection: article.category,
    keywords: article.tags.join(", "),
    wordCount,
    timeRequired: `PT${Number.parseInt(readTime, 10)}M`,
    inLanguage: "en",
    image: articleImageUrl,
    author: {
      "@type": "Organization",
      name: article.author,
      url: `${SITE.url}/authors/echo-buddha-editorial/`
    },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      url: SITE.url,
      logo: {
        "@type": "ImageObject",
        url: `${SITE.url}/og-default.svg`
      }
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": articleUrl
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: SITE.url
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Articles",
        item: `${SITE.url}/articles/`
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.category,
        item: `${SITE.url}/articles/category/${category.slug}/`
      },
      {
        "@type": "ListItem",
        position: 4,
        name: article.title,
        item: articleUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: seoDetails.faqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<Layout
  title={article.seoTitle ?? article.title}
  description={article.description}
  canonicalPath={canonicalPath}
  type="article"
  image={article.thumbnail}
  publishedDate={article.date}
  modifiedDate={seoDetails.reviewedDate}
  author={article.author}
  jsonLd={jsonLd}
>
  <article>
    <header class="page-hero">
      <div class="container prose">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/articles/">Articles</a>
          <span aria-hidden="true">/</span>
          <a href={`/articles/category/${category.slug}/`}>{article.category}</a>
        </nav>
        <a class="eyebrow category-eyebrow" href={`/articles/category/${category.slug}/`}>{article.category}</a>
        <h1>{article.title}</h1>
        <p class="lede">{article.description}</p>
        <div class="article-meta">
          <span>By <a href="/authors/echo-buddha-editorial/">{article.author}</a></span>
          <span>Published <time datetime={article.date}>{formattedDate}</time></span>
          <span>Reviewed <time datetime={seoDetails.reviewedDate}>{formattedReviewedDate}</time></span>
          <span>{readTime}</span>
        </div>
        <div class="article-share-row">
          <ArticleShare
            title={article.title}
            description={article.description}
            url={articleUrl}
            image={articleImageUrl}
            variant="page"
          />
        </div>
      </div>
    </header>

    <div class="container article-shell">
      <div class="prose article-content">
        <aside class="key-takeaways surface" aria-labelledby="key-takeaways-heading">
          <h2 id="key-takeaways-heading">Key Takeaways</h2>
          <ul>
            {seoDetails.takeaways.map((takeaway) => <li>{takeaway}</li>)}
          </ul>
        </aside>

        {sectionsWithIds.map((section, index) => (
          <>
            {section.heading && <h2 id={section.id}>{section.heading}</h2>}
            {section.subheading && <h3>{section.subheading}</h3>}
            {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
            {section.visual && <Fragment set:html={section.visual} />}
            {index === 1 && <AdSlot />}
          </>
        ))}

        {needsWellbeingNote && (
          <aside class="wellbeing-note surface" aria-labelledby="wellbeing-note-heading">
            <h2 id="wellbeing-note-heading">A Note About Wellbeing</h2>
            <p>
              This article is educational and does not provide medical or mental health treatment. Meditation and
              mindfulness experiences vary. Seek qualified professional support for persistent or serious symptoms.
            </p>
          </aside>
        )}

        <aside class="practice-today surface" aria-labelledby="practice-today-heading">
          <h2 id="practice-today-heading">Practice Today</h2>
          <p>{practiceToday}</p>
        </aside>

        <aside class="reflection-question surface" aria-labelledby="reflection-question-heading">
          <h2 id="reflection-question-heading">Reflection Question</h2>
          <p>{reflectionQuestion}</p>
        </aside>

        {relatedBuddhistTerms.length > 0 && (
          <section class="related-terms" aria-labelledby="related-terms-heading">
            <h2 id="related-terms-heading">Related Buddhist Terms</h2>
            <div>
              {relatedBuddhistTerms.map((term) => <a href={term.href}>{term.label}</a>)}
            </div>
          </section>
        )}

        <section class="article-faq" aria-labelledby="article-faq-heading">
          <h2 id="article-faq-heading">Frequently Asked Questions</h2>
          <div class="faq-list">
            {seoDetails.faqs.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="source-note" aria-labelledby="source-note-heading">
          <h2 id="source-note-heading">Further Reading / Source Note</h2>
          <p>
            Echo Buddha articles are original educational reflections written for general readers. For deeper formal
            study, compare reputable Buddhist translations, teachers, and practice communities.
          </p>
        </section>
      </div>
      <aside>
        {tableOfContents.length > 0 && (
          <nav class="surface article-toc" aria-label="Article contents">
            <h2>On This Page</h2>
            <ol>
              {tableOfContents.map((section) => (
                <li><a href={`#${section.id}`}>{section.heading}</a></li>
              ))}
              <li><a href="#article-faq-heading">Frequently Asked Questions</a></li>
            </ol>
          </nav>
        )}
        <AdSlot size="box" />
        <div class="surface article-tags">
          <h2>Topics</h2>
          <ul>
            {article.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </div>
        <div class="surface author-card">
          <span class="eyebrow">About the author</span>
          <h2>Echo Buddha Editorial</h2>
          <p>
            Accessible Buddhist-inspired wisdom, mindfulness, reflection, and meditation education for general
            readers.
          </p>
          <a href="/authors/echo-buddha-editorial/">View editorial profile</a>
        </div>
      </aside>
    </div>
  </article>

  {relatedArticles.length > 0 && (
    <section class="section section-band">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Article to article</span>
            <h2>Related Articles</h2>
          </div>
          <a href={`/articles/category/${category.slug}/`}>View this category</a>
        </div>
        <div class="grid grid--3">
          {relatedArticles.map((item) => <ArticleCard article={item} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Article to quote</span>
          <h2>{relatedQuoteTheme} Quotes for Further Reflection</h2>
        </div>
        <a href={`/quotes/${relatedQuoteCategory.slug}/`}>View all {relatedQuoteTheme} quotes</a>
      </div>
      <div class="grid grid--3">
        {relatedQuotes.map((quote) => <QuoteCard quote={quote} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .breadcrumbs {
    align-items: center;
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.86rem;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .breadcrumbs a {
    color: var(--color-muted);
  }

  .category-eyebrow {
    text-decoration-thickness: 1px;
  }

  .article-share-row {
    display: flex;
    margin-top: 1rem;
  }

  .key-takeaways {
    margin-bottom: 2rem;
    padding: 1.25rem 1.5rem;
  }

  .key-takeaways h2 {
    font-size: 1.45rem;
    margin-top: 0;
  }

  .key-takeaways ul {
    margin-bottom: 0;
  }

  .article-toc {
    margin-bottom: 1rem;
    padding: 1.25rem;
  }

  .article-toc h2 {
    font-size: 1.35rem;
  }

  .article-toc ol {
    font-size: 0.9rem;
    margin: 0;
    padding-left: 1.2rem;
  }

  .article-toc li + li {
    margin-top: 0.5rem;
  }

  .article-toc a {
    color: var(--color-brown);
  }

  .article-tags {
    margin-bottom: 1rem;
    padding: 1.25rem;
  }

  .article-tags h2 {
    font-size: 1.35rem;
  }

  .article-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-tags li {
    background: var(--color-green-soft);
    border-radius: 999px;
    color: var(--color-green);
    font-size: 0.84rem;
    font-weight: 800;
    padding: 0.25rem 0.7rem;
  }

  .author-card,
  .wellbeing-note {
    padding: 1.25rem;
  }

  .author-card h2,
  .wellbeing-note h2 {
    font-size: 1.35rem;
    margin-top: 0;
  }

  .author-card p,
  .wellbeing-note p {
    color: var(--color-muted);
  }

  .wellbeing-note {
    border-left: 3px solid var(--color-green);
    margin-top: 2.5rem;
  }

  :global(.article-visual) {
    margin: 2rem 0;
    padding: 1.25rem;
  }

  :global(.article-visual figcaption) {
    color: var(--color-muted);
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  :global(.visual-card-grid),
  :global(.visual-comparison),
  :global(.visual-mini-grid) {
    display: grid;
    gap: 0.85rem;
  }

  :global(.visual-card-grid--three) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  :global(.visual-card-grid--four) {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  :global(.visual-card),
  :global(.visual-comparison-card),
  :global(.visual-mini-card),
  :global(.visual-table),
  :global(.visual-flow li) {
    background: rgba(247, 240, 229, 0.72);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 1rem;
  }

  :global(.visual-card),
  :global(.visual-comparison-card) {
    display: grid;
    gap: 0.65rem;
  }

  :global(.visual-card--compact) {
    gap: 0.45rem;
    padding: 0.95rem;
  }

  :global(.visual-card h3),
  :global(.visual-comparison-card h3),
  :global(.visual-mini-card h3),
  :global(.visual-table h3) {
    color: var(--color-brown);
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.25;
    margin: 0;
  }

  :global(.visual-kicker) {
    color: var(--color-green);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }

  :global(.visual-card p),
  :global(.visual-mini-card p),
  :global(.visual-flow span) {
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }

  :global(.visual-card ul),
  :global(.visual-comparison-card ul) {
    display: grid;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global(.visual-card li),
  :global(.visual-comparison-card li) {
    background: rgba(255, 253, 248, 0.82);
    border: 1px solid rgba(212, 194, 163, 0.72);
    border-radius: 999px;
    color: var(--color-ink);
    font-size: 0.9rem;
    margin: 0;
    padding: 0.42rem 0.7rem;
  }

  :global(.visual-comparison) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1rem;
  }

  :global(.visual-flow) {
    counter-reset: visual-step;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  :global(.visual-flow li) {
    counter-increment: visual-step;
    display: grid;
    gap: 0.35rem;
    margin: 0;
    position: relative;
  }

  :global(.visual-flow li + li) {
    margin-top: 0;
  }

  :global(.visual-flow strong) {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.3;
  }

  :global(.visual-flow--numbered li),
  :global(.visual-flow--cycle li) {
    padding-left: 3rem;
  }

  :global(.visual-flow--numbered li::before),
  :global(.visual-flow--cycle li::before) {
    align-items: center;
    background: rgba(95, 127, 98, 0.14);
    border: 1px solid rgba(95, 127, 98, 0.25);
    border-radius: 50%;
    color: var(--color-green);
    content: counter(visual-step);
    display: inline-flex;
    font-size: 0.82rem;
    font-weight: 800;
    height: 1.8rem;
    justify-content: center;
    left: 0.85rem;
    position: absolute;
    top: 0.85rem;
    width: 1.8rem;
  }

  :global(.visual-flow--cycle li::before) {
    background: rgba(198, 151, 56, 0.16);
    border-color: rgba(198, 151, 56, 0.28);
    color: var(--color-gold);
  }

  :global(.visual-table) {
    margin-top: 1rem;
  }

  :global(.visual-table dl) {
    display: grid;
    gap: 0.55rem;
    margin: 0.85rem 0 0;
  }

  :global(.visual-table dl > div) {
    background: rgba(255, 253, 248, 0.82);
    border: 1px solid rgba(212, 194, 163, 0.72);
    border-radius: 8px;
    display: grid;
    gap: 0.65rem;
    grid-template-columns: minmax(120px, 0.75fr) 1fr;
    padding: 0.7rem 0.8rem;
  }

  :global(.visual-table dt) {
    color: var(--color-brown);
    font-weight: 800;
  }

  :global(.visual-table dd) {
    color: var(--color-muted);
    margin: 0;
  }

  :global(.visual-mini-grid) {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }

  :global(.visual-flow + .visual-mini-grid) {
    margin-top: 1rem;
  }

  @media (max-width: 820px) {
    :global(.visual-card-grid--three),
    :global(.visual-card-grid--four),
    :global(.visual-mini-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    :global(.visual-card-grid--three),
    :global(.visual-card-grid--four),
    :global(.visual-comparison),
    :global(.visual-mini-grid),
    :global(.visual-table dl > div) {
      grid-template-columns: 1fr;
    }
  }

  .practice-today,
  .reflection-question {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
  }

  .practice-today h2,
  .reflection-question h2 {
    font-size: 1.45rem;
    margin-top: 0;
  }

  .related-terms {
    border-top: 1px solid var(--color-line);
    margin-top: 3rem;
    padding-top: 0.25rem;
  }

  .related-terms div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .related-terms a {
    background: var(--color-green-soft);
    border-radius: 999px;
    color: var(--color-green);
    font-size: 0.88rem;
    font-weight: 800;
    padding: 0.3rem 0.75rem;
    text-decoration: none;
  }

  .related-terms a:hover {
    color: var(--color-brown);
  }

  .article-faq {
    border-top: 1px solid var(--color-line);
    margin-top: 3rem;
    padding-top: 0.25rem;
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
  }

  .faq-list details {
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
  }

  .faq-list summary {
    color: var(--color-ink);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 700;
  }

  .faq-list p {
    color: var(--color-muted);
    margin: 0.75rem 0 0;
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .section-heading {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .section-heading a {
    font-weight: 800;
  }
</style>

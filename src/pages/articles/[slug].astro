---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import ArticleShare from "../../components/ArticleShare.astro";
import QuoteCard from "../../components/QuoteCard.astro";
import EditorialStandardsLinks from "../../components/EditorialStandardsLinks.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import {
  SITE,
  fullArticles,
  getArticleCategory,
  getArticleReadTime,
  getArticleSeoDetails,
  getArticleWordCount,
  getQuoteCategory,
  getQuoteThemeForArticleCategory,
  quotes,
  slugify
} from "../../data/site";
import {
  EDITORIAL_AUTHOR_SCHEMA,
  PUBLISHER_SCHEMA,
  getSourceReferencesForRoute
} from "../../data/editorialGovernance";

export function getStaticPaths() {
  return fullArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;
const canonicalPath = `/articles/${article.slug}/`;
const formattedDate = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric"
}).format(new Date(`${article.date}T00:00:00Z`));
const articleUrl = `${SITE.url}${canonicalPath}`;
const articleImageUrl = new URL(article.thumbnail, SITE.url).toString();
const category = getArticleCategory(article.category);
const seoDetails = getArticleSeoDetails(article.slug);
const readTime = getArticleReadTime(article);
const wordCount = getArticleWordCount(article);
const formattedReviewedDate = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric"
}).format(new Date(`${seoDetails.reviewedDate}T00:00:00Z`));
const sectionsWithIds = article.content.map((section) => ({
  ...section,
  id: section.heading ? slugify(section.heading) : ""
}));
const tableOfContents = sectionsWithIds.filter((section) => section.heading);
const selectedRelatedArticles = (article.relatedSlugs ?? [])
  .map((slug) => fullArticles.find((item) => item.slug === slug))
  .filter(Boolean);
const relatedArticles = selectedRelatedArticles.length > 0
  ? selectedRelatedArticles
  : fullArticles
      .filter((item) => item.slug !== article.slug && item.category === article.category)
      .slice(0, 3);
const relatedQuoteTheme = getQuoteThemeForArticleCategory(article.category);
const relatedQuoteCategory = getQuoteCategory(relatedQuoteTheme);
const relatedQuotes = quotes.filter((quote) => quote.theme === relatedQuoteTheme).slice(0, 3);
const relatedBuddhistTerms = {
  "Buddhist Wisdom": [
    { label: "Dhamma", href: "/learn/buddhist-dictionary/dhamma/" },
    { label: "Karma", href: "/learn/buddhist-dictionary/karma/" },
    { label: "Dukkha", href: "/learn/buddhist-dictionary/dukkha/" }
  ],
  Meditation: [
    { label: "Sati", href: "/learn/buddhist-dictionary/sati/" },
    { label: "Mindfulness", href: "/learn/buddhist-dictionary/mindfulness/" },
    { label: "Metta", href: "/learn/buddhist-dictionary/metta/" }
  ],
  Mindfulness: [
    { label: "Sati", href: "/learn/buddhist-dictionary/sati/" },
    { label: "Mindfulness", href: "/learn/buddhist-dictionary/mindfulness/" },
    { label: "Anicca", href: "/learn/buddhist-dictionary/anicca/" }
  ],
  Reflection: [
    { label: "Anicca", href: "/learn/buddhist-dictionary/anicca/" },
    { label: "Dukkha", href: "/learn/buddhist-dictionary/dukkha/" },
    { label: "Anatta", href: "/learn/buddhist-dictionary/anatta/" }
  ],
  Practice: [
    { label: "Sati", href: "/learn/buddhist-dictionary/sati/" },
    { label: "Compassion", href: "/learn/buddhist-dictionary/compassion/" },
    { label: "Dhamma", href: "/learn/buddhist-dictionary/dhamma/" }
  ]
}[article.category] ?? [];
const topicClusters = [
  {
    slugs: ["four-noble-truths-explained", "four-noble-truths-explained-simply"],
    label: "main Four Noble Truths guide",
    href: "/learn/four-noble-truths/",
    source:
      "This article is an original Echo Buddha educational explanation based on the widely taught Buddhist framework of the Four Noble Truths, traditionally associated with the Buddha's first teaching.",
    links: [
      { label: "Four Noble Truths Learning Hub", href: "/learn/four-noble-truths/" },
      { label: "Four Noble Truths Explained Simply", href: "/articles/four-noble-truths-explained-simply/" },
      { label: "Four Noble Truths in Everyday Language", href: "/articles/four-noble-truths-explained/" },
      { label: "Dukkha Definition", href: "/learn/buddhist-dictionary/dukkha/" }
    ]
  },
  {
    slugs: ["eightfold-path-explained", "eightfold-path-explained-daily-life", "noble-eightfold-path-practical-guide"],
    label: "main Noble Eightfold Path guide",
    href: "/learn/eightfold-path/",
    source:
      "This article is an original Echo Buddha explanation of the Noble Eightfold Path as a practical training path in wisdom, ethical conduct, and mental cultivation.",
    links: [
      { label: "Eightfold Path Learning Hub", href: "/learn/eightfold-path/" },
      { label: "Noble Eightfold Path Practical Guide", href: "/articles/noble-eightfold-path-practical-guide/" },
      { label: "Right Speech in Buddhism", href: "/articles/right-speech-buddhism/" },
      { label: "Eightfold Path Lesson", href: "/learn/buddhism-101/the-noble-eightfold-path-explained/" }
    ]
  },
  {
    slugs: ["impermanence-in-buddhism", "buddhist-teachings-on-impermanence", "impermanence-in-buddhism-letting-go"],
    label: "main impermanence guide",
    href: "/learn/buddhism-101/what-is-impermanence/",
    source:
      "This article is original Echo Buddha educational writing on anicca, the Buddhist teaching of impermanence, with daily-life examples for general readers.",
    links: [
      { label: "What Is Impermanence?", href: "/learn/buddhism-101/what-is-impermanence/" },
      { label: "Impermanence and Letting Go", href: "/articles/impermanence-in-buddhism-letting-go/" },
      { label: "Accepting Change Peacefully", href: "/articles/impermanence-in-buddhism/" },
      { label: "Anicca Definition", href: "/learn/buddhist-dictionary/anicca/" }
    ]
  },
  {
    slugs: ["how-to-meditate-for-beginners", "mindfulness-of-breathing-guide", "mindfulness-vs-meditation"],
    label: "main beginner meditation guide",
    href: "/meditation/",
    source:
      "This article is educational and reflective, based on general Buddhist meditation themes. It is not medical or mental health advice.",
    links: [
      { label: "Meditation Practice Hub", href: "/meditation/" },
      { label: "How to Meditate for Beginners", href: "/articles/how-to-meditate-for-beginners/" },
      { label: "Mindfulness of Breathing", href: "/articles/mindfulness-of-breathing-guide/" },
      { label: "Meditation for Beginners", href: "/meditation/meditation-for-beginners/" }
    ]
  },
  {
    slugs: ["loving-kindness-meditation-guide", "loving-kindness-meditation-beginners", "metta-meditation-script"],
    label: "main loving-kindness meditation guide",
    href: "/meditation/loving-kindness-meditation/",
    source:
      "This article is original Echo Buddha educational writing on metta, or loving-kindness practice, presented as reflective guidance rather than clinical advice.",
    links: [
      { label: "Loving-Kindness Meditation Practice", href: "/meditation/loving-kindness-meditation/" },
      { label: "Loving-Kindness Meditation Guide", href: "/articles/loving-kindness-meditation-guide/" },
      { label: "Metta Meditation Script", href: "/articles/metta-meditation-script/" },
      { label: "Metta Definition", href: "/learn/buddhist-dictionary/metta/" }
    ]
  },
  {
    slugs: ["what-is-buddhism-beginner-guide", "buddhism-for-beginners-simple-guide"],
    label: "main Buddhism beginner guide",
    href: "/learn/buddhism-for-beginners/",
    source:
      "This article is an original Echo Buddha beginner explanation of Buddhism as a living tradition of wisdom, ethics, meditation, and compassion.",
    links: [
      { label: "Buddhism for Beginners Learning Hub", href: "/learn/buddhism-for-beginners/" },
      { label: "What Is Buddhism?", href: "/articles/what-is-buddhism-beginner-guide/" },
      { label: "Buddhism for Beginners", href: "/articles/buddhism-for-beginners-simple-guide/" },
      { label: "Buddhism 101 Learning Path", href: "/learn/buddhism-101/" }
    ]
  },
  {
    slugs: ["first-week-buddhist-practice"],
    label: "Buddhism for Beginners hub",
    href: "/learn/buddhism-for-beginners/",
    source:
      "This article is original Echo Buddha beginner practice guidance. It supports the Buddhism for Beginners hub and does not replace formal tradition-specific instruction.",
    links: [
      { label: "Buddhism for Beginners", href: "/learn/buddhism-for-beginners/" },
      { label: "Simple Daily Buddhist Practice", href: "/learn/buddhism-101/a-simple-daily-buddhist-practice/" },
      { label: "How to Practice Buddhism at Home", href: "/learn/buddhism-101/how-to-practice-buddhism-at-home/" },
      { label: "Meditation for Beginners", href: "/meditation/meditation-for-beginners/" }
    ]
  },
  {
    slugs: ["what-is-karma-in-buddhism"],
    label: "main beginner karma guide",
    href: "/learn/buddhism-101/what-is-karma-in-buddhism/",
    source:
      "This article is original Echo Buddha educational writing about karma as intention, action, habit, and consequence. It avoids using karma to blame people for suffering.",
    links: [
      { label: "What Is Karma in Buddhism? A Beginner's Guide", href: "/learn/buddhism-101/what-is-karma-in-buddhism/" },
      { label: "Daily Karma Practice Article", href: "/articles/what-is-karma-in-buddhism/" },
      { label: "Karma Dictionary Term", href: "/learn/buddhist-dictionary/karma/" },
      { label: "Dependent Origination", href: "/learn/buddhism-101/dependent-origination-explained/" }
    ]
  },
  {
    slugs: ["dhammapada-reflection-what-we-think", "dhammapada-reflection-trained-mind"],
    label: "Dhammapada reflections hub",
    href: "/learn/dhammapada-reflections/",
    source:
      "This is an original Echo Buddha reflection inspired by broad Dhammapada themes. It distinguishes source context, paraphrase, translation, and reflection, and is not presented as an exact canonical translation.",
    links: [
      { label: "Dhammapada Reflections Hub", href: "/learn/dhammapada-reflections/" },
      { label: "The Mind Leads All Things", href: "/learn/dhammapada-reflections/the-mind-leads-all-things/" },
      { label: "Peace Comes From a Trained Mind", href: "/learn/dhammapada-reflections/peace-comes-from-a-trained-mind/" }
    ]
  },
  {
    slugs: ["dhammapada-verse-1-meaning"],
    label: "Dhammapada reflections hub",
    href: "/learn/dhammapada-reflections/",
    source:
      "This article is original Echo Buddha source-aware guidance on Dhammapada Verse 1 themes. It is not presented as a new translation and distinguishes translation, paraphrase, source context, and reflection.",
    links: [
      { label: "Dhammapada Reflections Hub", href: "/learn/dhammapada-reflections/" },
      { label: "What We Think, We Become Attribution Note", href: "/articles/dhammapada-reflection-what-we-think/" },
      { label: "Buddhist Sources and Citations", href: "/buddhist-sources-and-citations/" },
      { label: "Quote Attribution Policy", href: "/quote-attribution-policy/" }
    ]
  },
  {
    slugs: ["right-speech-buddhism", "right-speech-examples"],
    label: "Noble Eightfold Path hub",
    href: "/learn/eightfold-path/",
    source:
      "This article is original Echo Buddha guidance on Right Speech as a narrow ethical-practice page within the Noble Eightfold Path, with source context from traditional right-speech summaries.",
    links: [
      { label: "Eightfold Path Learning Hub", href: "/learn/eightfold-path/" },
      { label: "Right Speech Examples", href: "/articles/right-speech-examples/" },
      { label: "Right Speech in Daily Life", href: "/learn/sutta-for-daily-life/right-speech-in-daily-life/" },
      { label: "Five Precepts", href: "/learn/buddhism-101/five-precepts-buddhism/" },
      { label: "Buddhist Approach to Anger", href: "/articles/buddhist-approach-to-anger/" }
    ]
  },
  {
    slugs: ["three-poisons-buddhism-explained"],
    label: "beginner karma guide",
    href: "/learn/buddhism-101/what-is-karma-in-buddhism/",
    source:
      "This article is original Echo Buddha educational writing on the Three Poisons as roots of unskillful action. It uses traditional source context and keeps the page as the current broad Three Poisons explainer.",
    links: [
      { label: "Karma Lesson", href: "/learn/buddhism-101/what-is-karma-in-buddhism/" },
      { label: "Five Precepts in Daily Life", href: "/articles/five-precepts-in-daily-life/" },
      { label: "Right Speech in Buddhism", href: "/articles/right-speech-buddhism/" },
      { label: "Buddhist Approach to Anger", href: "/articles/buddhist-approach-to-anger/" }
    ]
  },
  {
    slugs: ["five-precepts-in-daily-life"],
    label: "Five Precepts learning definition",
    href: "/learn/buddhism-101/five-precepts-buddhism/",
    source:
      "This article is original Echo Buddha educational writing on daily-life application of the Five Precepts. The Learn page remains the concise definition route.",
    links: [
      { label: "Five Precepts Learning Definition", href: "/learn/buddhism-101/five-precepts-buddhism/" },
      { label: "Right Speech in Buddhism", href: "/articles/right-speech-buddhism/" },
      { label: "Three Poisons in Buddhism", href: "/articles/three-poisons-buddhism-explained/" },
      { label: "Karma Lesson", href: "/learn/buddhism-101/what-is-karma-in-buddhism/" }
    ]
  },
  {
    slugs: ["dhamma-vs-dharma"],
    label: "Dhamma dictionary definition",
    href: "/learn/buddhist-dictionary/dhamma/",
    source:
      "This article is original Echo Buddha support content about Dhamma and Dharma spelling. The Dhamma dictionary page remains the broad meaning owner.",
    links: [
      { label: "Dhamma Dictionary Definition", href: "/learn/buddhist-dictionary/dhamma/" },
      { label: "The Three Jewels", href: "/learn/buddhism-101/the-three-jewels-explained/" },
      { label: "Dhammapada Reflections", href: "/learn/dhammapada-reflections/" },
      { label: "Buddhist Sources and Citations", href: "/buddhist-sources-and-citations/" }
    ]
  },
  {
    slugs: ["what-is-sangha-buddhist-community", "visiting-a-buddhist-temple-respectfully"],
    label: "main Sangha and Buddhist community guide",
    href: "/articles/what-is-sangha-buddhist-community/",
    source:
      "This article is original Echo Buddha educational writing on Sangha as Buddhist community. It is the deeper beginner guide; the dictionary page remains the concise definition.",
    links: [
      { label: "Sangha Dictionary Definition", href: "/learn/buddhist-dictionary/sangha/" },
      { label: "What Is Sangha?", href: "/articles/what-is-sangha-buddhist-community/" },
      { label: "The Three Jewels", href: "/learn/buddhism-101/the-three-jewels-explained/" },
      { label: "Buddhism for Beginners", href: "/learn/buddhism-for-beginners/" },
      { label: "Buddhist Resources", href: "/learn/buddhist-resources/" }
    ]
  },
  {
    slugs: ["how-to-let-go-of-attachment-in-buddhism", "non-attachment-in-relationships"],
    label: "main attachment and letting-go guide",
    href: "/articles/how-to-let-go-of-attachment-in-buddhism/",
    source:
      "This article is original Echo Buddha reflection on letting go and non-attachment. It preserves the distinction between care, wise effort, boundaries, and clinging.",
    links: [
      { label: "How to Let Go of Attachment", href: "/articles/how-to-let-go-of-attachment-in-buddhism/" },
      { label: "Non-Attachment in Relationships", href: "/articles/non-attachment-in-relationships/" },
      { label: "Letting Go Quotes", href: "/quotes/letting-go/" }
    ]
  }
];
const activeTopicCluster = topicClusters.find((cluster) => cluster.slugs.includes(article.slug));
const topicClusterHub = activeTopicCluster && activeTopicCluster.href !== canonicalPath ? activeTopicCluster : undefined;
const sourceReferences = getSourceReferencesForRoute(canonicalPath);
const sourceNoteText =
  activeTopicCluster?.source ??
  undefined;
const cornerstonePracticePrompts: Record<string, string> = {
  "right-speech-buddhism":
    "Before one consequential message, write what is known, what is inferred, what benefit the message should serve, and whether this is the right time.",
  "compassion-with-boundaries":
    "Name one situation in three lines: what care requires, what capacity is available, and whose responsibility the next action truly is.",
  "dhamma-vs-dharma":
    "Open one Buddhist source you already use and note whether Dhamma or Dharma appears, what tradition or language frames it, and what the word is doing in that sentence.",
  "dhammapada-verse-1-meaning":
    "Compare Verse 1 and Verse 2 in one named translation; note the mental quality, the speech or action, and the consequence in each half of the pair.",
  "dhammapada-reflection-what-we-think":
    "Check one attributed quote for a verse reference, named translator, and matching source wording before you share it as scripture.",
  "noble-eightfold-path-practical-guide":
    "Review one choice through two neighboring path factors—for example, the intention behind a sentence and the mindfulness that noticed it.",
  "buddhist-wisdom-for-overthinking":
    "Ask whether the last five minutes produced new information, one available action, or only replay; then choose an action, a review time, or a deliberate stop."
};
const cornerstoneReflectionQuestions: Record<string, string> = {
  "right-speech-buddhism": "Which necessary truth in your life needs better timing or less contempt—not greater avoidance?",
  "compassion-with-boundaries": "Where would a clearer limit protect compassion from becoming resentment or unsafe availability?",
  "dhamma-vs-dharma": "When you meet a Buddhist term in translation, what context would help you understand it without forcing one English equivalent?",
  "dhammapada-verse-1-meaning": "What changes when Verse 1 is read as ethical causation alongside Verse 2 rather than as a promise that thoughts control events?",
  "dhammapada-reflection-what-we-think": "What evidence would you need before presenting a popular English line as an exact canonical quotation?",
  "noble-eightfold-path-practical-guide": "Which path factor became visible today because another factor supported it?",
  "buddhist-wisdom-for-overthinking": "What repeated thought is still discovering something, and what thought has crossed into replay without new information?"
};
const practiceToday = cornerstonePracticePrompts[article.slug];
const reflectionQuestion = cornerstoneReflectionQuestions[article.slug];
const needsWellbeingNote = [
  "how-to-meditate-for-anxiety",
  "mindfulness-for-better-sleep",
  "buddhist-approach-to-anger",
  "buddhist-wisdom-for-overthinking",
  "impermanence-in-buddhism",
  "loving-kindness-meditation-beginners",
  "loving-kindness-meditation-guide",
  "metta-meditation-script",
  "mindfulness-of-breathing-guide",
  "how-to-meditate-for-beginners",
  "mindfulness-vs-meditation"
].includes(article.slug);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": ["BlogPosting", "Article"],
    headline: article.title,
    description: article.description,
    url: articleUrl,
    datePublished: article.date,
    dateModified: seoDetails.reviewedDate,
    articleSection: article.category,
    keywords: article.tags.join(", "),
    wordCount,
    timeRequired: `PT${Number.parseInt(readTime, 10)}M`,
    inLanguage: "en",
    image: articleImageUrl,
    author: { ...EDITORIAL_AUTHOR_SCHEMA, name: article.author },
    publisher: {
      ...PUBLISHER_SCHEMA,
      logo: {
        "@type": "ImageObject",
        url: `${SITE.url}/og-default.svg`
      }
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": articleUrl
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: SITE.url
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Articles",
        item: `${SITE.url}/articles/`
      },
      {
        "@type": "ListItem",
        position: 3,
        name: article.category,
        item: `${SITE.url}/articles/category/${category.slug}/`
      },
      {
        "@type": "ListItem",
        position: 4,
        name: article.title,
        item: articleUrl
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: seoDetails.faqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<Layout
  title={article.seoTitle ?? article.title}
  description={article.description}
  canonicalPath={canonicalPath}
  type="article"
  image={article.thumbnail}
  publishedDate={article.date}
  modifiedDate={seoDetails.reviewedDate}
  author={article.author}
  jsonLd={jsonLd}
>
  <article>
    <header class="page-hero">
      <div class="container prose">
        <Breadcrumbs items={[
          { label: "Home", href: "/" },
          { label: "Articles", href: "/articles/" },
          { label: article.category, href: `/articles/category/${category.slug}/` },
          { label: article.title }
        ]} />
        <a class="eyebrow category-eyebrow" href={`/articles/category/${category.slug}/`}>{article.category}</a>
        <h1>{article.title}</h1>
        <p class="lede">{article.description}</p>
        <div class="article-meta">
          <span>By <a href="/authors/echo-buddha-editorial/" rel="author">{article.author}</a></span>
          <span>Published <time datetime={article.date}>{formattedDate}</time></span>
          <span>Updated <time datetime={seoDetails.reviewedDate}>{formattedReviewedDate}</time></span>
          <span>{readTime}</span>
        </div>
        <div class="article-share-row">
          <ArticleShare
            title={article.title}
            description={article.description}
            url={articleUrl}
            image={articleImageUrl}
            variant="page"
          />
        </div>
      </div>
    </header>

    <div class="container article-shell">
      <div class="prose article-content">
        <aside class="key-takeaways surface" aria-labelledby="key-takeaways-heading">
          <h2 id="key-takeaways-heading">Key Takeaways</h2>
          <ul>
            {seoDetails.takeaways.map((takeaway) => <li>{takeaway}</li>)}
          </ul>
        </aside>

        {sectionsWithIds.map((section, index) => (
          <>
            {section.heading && <h2 id={section.id}>{section.heading}</h2>}
            {section.subheading && <h3>{section.subheading}</h3>}
            {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
            {section.visual && <Fragment set:html={section.visual} />}
          </>
        ))}

        {needsWellbeingNote && (
          <aside class="wellbeing-note surface" aria-labelledby="wellbeing-note-heading">
            <h2 id="wellbeing-note-heading">A Note About Wellbeing</h2>
            <p>
              This article is educational and does not provide medical or mental health treatment. Meditation and
              mindfulness experiences vary. If a practice feels uncomfortable, open your eyes, shorten it, feel your
              feet or hands, change anchors, or stop. Seek qualified professional support for persistent or serious
              symptoms.
            </p>
          </aside>
        )}

        {practiceToday && (
          <aside class="practice-today surface" aria-labelledby="practice-today-heading">
            <h2 id="practice-today-heading">Practice Today</h2>
            <p>{practiceToday}</p>
          </aside>
        )}

        {reflectionQuestion && (
          <aside class="reflection-question surface" aria-labelledby="reflection-question-heading">
            <h2 id="reflection-question-heading">Reflection Question</h2>
            <p>{reflectionQuestion}</p>
          </aside>
        )}

        {relatedBuddhistTerms.length > 0 && (
          <section class="related-terms" aria-labelledby="related-terms-heading">
            <h2 id="related-terms-heading">Related Buddhist Terms</h2>
            <div>
              {relatedBuddhistTerms.map((term) => <a href={term.href}>{term.label}</a>)}
            </div>
          </section>
        )}

        <section class="article-faq" aria-labelledby="article-faq-heading">
          <h2 id="article-faq-heading">Frequently Asked Questions</h2>
          <div class="faq-list">
            {seoDetails.faqs.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>

        {(sourceNoteText || sourceReferences.length > 0) && (
          <section class="source-note" aria-labelledby="source-note-heading">
          <h2 id="source-note-heading">Sources and Context</h2>
          {sourceNoteText && <p>{sourceNoteText}</p>}
          {topicClusterHub && (
            <p>
              For a broader learning path, continue with the
              {" "}<a href={topicClusterHub.href}>{topicClusterHub.label}</a>.
            </p>
          )}
          {sourceReferences.length > 0 && (
            <>
              <h3>Selected References</h3>
              <ul class="source-list">
                {sourceReferences.map((source) => (
                  <li>
                    <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>
                    <span>{source.note}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
          </section>
        )}

        <EditorialStandardsLinks
          includeDisclaimer
          includeMeditationSafety={needsWellbeingNote}
        />

        {activeTopicCluster && (
          <section class="continue-learning" aria-labelledby="continue-learning-heading">
            <h2 id="continue-learning-heading">Continue Learning</h2>
            <ul>
              {activeTopicCluster.links
                .filter((link) => link.href !== canonicalPath)
                .map((link) => <li><a href={link.href}>{link.label}</a></li>)}
            </ul>
          </section>
        )}
      </div>
      <aside>
        {tableOfContents.length > 0 && (
          <nav class="surface article-toc" aria-label="Article contents">
            <h2>On This Page</h2>
            <ol>
              {tableOfContents.map((section) => (
                <li><a href={`#${section.id}`}>{section.heading}</a></li>

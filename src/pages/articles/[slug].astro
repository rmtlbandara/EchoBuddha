          </p>
          <a href="/authors/echo-buddha-editorial/">View editorial profile</a>
          <a href="/editorial-policy/">How we write Echo Buddha content</a>
        </div>
      </aside>
    </div>
  </article>

  {relatedArticles.length > 0 && (
    <section class="section section-band">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Article to article</span>

---
import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import LearningCard from "../components/LearningCard.astro";
import DailyReflectionCard from "../components/DailyReflectionCard.astro";
import { dailyReflections } from "../data/dailyReflections";
import { SITE, fullArticles } from "../data/site";

const title = "Mindful Living with Buddhist Wisdom";
const description =
  "Explore practical Buddhist-inspired mindfulness for daily life, work, speech, relationships, patience, compassion, and letting go.";
const canonicalPath = "/mindful-living/";
const articleSlugs = [
  "mindfulness-morning-routine",
  "right-speech-buddhism",
  "right-speech-examples",
  "mindful-email-and-texting",
  "mindful-listening-in-everyday-life",
  "buddhist-approach-to-anger",
  "compassion-as-a-daily-discipline",
  "compassion-with-boundaries",
  "buddhist-teachings-on-impermanence",
  "non-attachment-in-relationships",
  "how-to-let-go-of-attachment-in-buddhism"
];
const featuredArticles = articleSlugs
  .map((slug) => fullArticles.find((article) => article.slug === slug))
  .filter(Boolean);
const livingAreas = [
  { label: "Speech", href: "/articles/right-speech-buddhism/", description: "Practice truthful, timely, non-harming words before a reply leaves the mouth." },
  { label: "Work", href: "/learn/buddhism-101/right-livelihood-buddhism/", description: "Let livelihood and responsibility reflect care, honesty, and restraint." },
  { label: "Family", href: "/quotes/patience/family-kindness-and-patience/", description: "Use familiar rooms as a place for patience rather than automatic reaction." },
  { label: "Emotions", href: "/articles/buddhist-approach-to-anger/", description: "Meet anger and difficulty through awareness, not suppression or harm." },
  { label: "Screens", href: "/articles/mindful-email-and-texting/", description: "Bring Right Speech and patience to email, texting, scrolling, and digital habits." },
  { label: "Grief and Change", href: "/learn/buddhism-101/what-is-impermanence/", description: "Let impermanence guide tenderness when life will not stay fixed." },
  { label: "Rest", href: "/daily-reflections/", description: "Return through one daily reflection instead of turning practice into another task." },
  { label: "Relationships", href: "/articles/non-attachment-in-relationships/", description: "Practice care with boundaries, listening, and less controlling love." }
];
const principleLinks = [
  { label: "Right Speech", href: "/articles/right-speech-buddhism/" },
  { label: "Right Speech Examples", href: "/articles/right-speech-examples/" },
  { label: "Mindful Email", href: "/articles/mindful-email-and-texting/" },
  { label: "Patience", href: "/articles/three-ways-to-practice-patience/" },
  { label: "Letting Go", href: "/articles/how-to-let-go-of-attachment-in-buddhism/" },
  { label: "Compassion", href: "/learn/buddhist-dictionary/compassion/" },
  { label: "Compassion With Boundaries", href: "/articles/compassion-with-boundaries/" },
  { label: "Impermanence", href: "/learn/buddhism-101/what-is-impermanence/" },
  { label: "Daily Reflections", href: "/daily-reflections/" }
];
const faqItems = [
  {
    question: "What does mindful living mean?",
    answer: "Mindful living means bringing awareness, kindness, and wise intention into ordinary actions such as speaking, working, listening, resting, and responding to difficulty."
  },
  {
    question: "Is mindful living the same as meditation?",
    answer: "Meditation can support mindful living, but mindful living also includes daily choices, speech, work, relationships, and ethical care."
  }
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: `${SITE.url}${canonicalPath}`
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
      { "@type": "ListItem", position: 2, name: "Mindful Living", item: `${SITE.url}${canonicalPath}` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer }
    }))
  }
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Mindful living</span>
      <h1>Mindful Living with Buddhist Wisdom</h1>
      <p class="lede">
        Buddhist practice becomes useful when it enters ordinary life: the message before you send it, the pause before
        anger speaks, the work done with honesty, and the kindness that includes boundaries.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <span class="eyebrow">Daily life practice</span>
      <h2>Practice Areas</h2>
      <div class="grid grid--3">
        {livingAreas.map((item) => <LearningCard item={item} />)}
      </div>
      <nav class="principle-links" aria-label="Mindful living Buddhist principles">
        {principleLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
  </section>

  <section class="section section-band">
    <div class="container split">
      <div>
        <span class="eyebrow">Today's doorway</span>
        <h2>Begin With One Small Practice</h2>
        <p class="lede">
          Mindful living does not require making the day look special. Choose one real moment and meet it with clearer
          attention, less harm, and a little more patience.
        </p>
        <a class="button" href="/daily-reflections/today/">Read today's reflection</a>
      </div>
      <DailyReflectionCard reflection={dailyReflections[4]} compact />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Related articles</span>
      <h2>Practical Reading</h2>
      <div class="grid grid--3">
        {featuredArticles.map((article) => <ArticleCard article={article} />)}
      </div>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="surface faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .faq-list {
    display: grid;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .principle-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.25rem;
  }

  .principle-links a {
    background: var(--color-green-soft);
    border-radius: 999px;
    color: var(--color-green);
    font-size: 0.84rem;
    font-weight: 800;
    padding: 0.35rem 0.7rem;
    text-decoration: none;
  }

  .principle-links a:hover {
    color: var(--color-brown);
  }

  .faq-item {
    padding: 1rem 1.15rem;
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 800;
  }

  .faq-item p {
    color: var(--color-muted);
    margin-bottom: 0;
  }
</style>

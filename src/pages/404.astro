---
import Layout from "../layouts/Layout.astro";

const title = "Page Not Found";
const description = "The requested Echo Buddha page could not be found. Return to Buddhist articles, quotes, or meditation guidance.";
---

<Layout title={title} description={description} canonicalPath={false} noindex>
  <section class="page-hero not-found">
    <div class="container prose">
      <span class="eyebrow">404</span>
      <h1>Page Not Found</h1>
      <p class="lede">
        The page may have moved or the address may be incomplete. Search for the topic, begin again with Start Here,
        or choose one of the main paths below.
      </p>
      <nav class="not-found-links" aria-label="Helpful links">
        <a class="button" href="/">Home</a>
        <a class="button button--secondary" href="/search/">Search</a>
        <a class="button button--secondary" href="/start-here/">Start Here</a>
        <a class="button button--secondary" href="/learn/">Learn</a>
        <a class="button button--secondary" href="/meditation/">Meditation</a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 65vh;
  }

  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
</style>

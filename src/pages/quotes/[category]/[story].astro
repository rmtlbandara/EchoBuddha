---
import Layout from "../../../layouts/Layout.astro";
import QuoteCard from "../../../components/QuoteCard.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import AdSlot from "../../../components/AdSlot.astro";
import ArticleShare from "../../../components/ArticleShare.astro";
import {
  SITE,
  getArticlesForQuoteTheme,
  getQuoteCategory,
  getQuoteSlug,
  getQuoteStory,
  isQuoteStoryIndexable,
  quotes
} from "../../../data/site";

export function getStaticPaths() {
  return quotes.map((quote) => {
    const category = getQuoteCategory(quote.theme);
    return {
      params: {
        category: category.slug,
        story: getQuoteSlug(quote)
      },
      props: { quote, category }
    };
  });
}

const { quote, category } = Astro.props;
const story = getQuoteStory(quote);
const canonicalPath = `/quotes/${category.slug}/${story.slug}/`;
const quoteUrl = `${SITE.url}${canonicalPath}`;
const isIndexable = isQuoteStoryIndexable(quote);
const relatedQuotes = quotes.filter((item) => item.theme === quote.theme && item.text !== quote.text).slice(0, 3);
const relatedArticles = getArticlesForQuoteTheme(quote.theme).slice(0, 2);
const relatedTeaching = {
  Mindfulness: { label: "Mindfulness", href: "/learn/buddhism-101/what-is-mindfulness/" },
  Compassion: { label: "Compassion", href: "/learn/buddhist-dictionary/compassion/" },
  Patience: { label: "Right Speech", href: "/articles/right-speech-buddhism/" },
  Awareness: { label: "Sati", href: "/learn/buddhist-dictionary/sati/" },
  Practice: { label: "Noble Eightfold Path", href: "/learn/eightfold-path/" },
  "Letting Go": { label: "Non-Attachment", href: "/articles/how-to-practice-non-attachment/" },
  Meditation: { label: "Meditation for Beginners", href: "/meditation/meditation-for-beginners/" },
  Renewal: { label: "Daily Practice", href: "/learn/buddhism-101/a-simple-daily-buddhist-practice/" },
  Wisdom: { label: "Dhamma", href: "/learn/buddhist-dictionary/dhamma/" },
  Impermanence: { label: "Impermanence", href: "/learn/buddhism-101/what-is-impermanence/" }
}[quote.theme] ?? { label: "Buddhist Wisdom", href: "/learn/" };
const practiceSuggestion =
  quote.theme === "Meditation"
    ? "Sit for one minute and follow a natural breath without trying to force calm."
    : quote.theme === "Compassion"
      ? "Offer one small kindness today while keeping your boundaries clear."
      : quote.theme === "Patience"
        ? "Before one difficult reply, pause long enough to feel the body."
        : quote.theme === "Letting Go"
          ? "Name one outcome you can release for today while still acting with care."
          : "Choose one ordinary moment and meet it with more awareness than habit.";
const reflectionQuestion =
  story.reflectionQuestion ??
  `Where could this ${quote.theme.toLowerCase()} quote become one small practice in your day?`;
const dailyLifeExample =
  quote.theme === "Meditation"
    ? "This quote can meet you before a short sitting practice, during a restless pause, or after noticing the mind wander."
    : quote.theme === "Compassion"
      ? "This quote can meet you in a tense conversation, a moment of self-criticism, or a chance to reduce someone else's burden."
      : quote.theme === "Patience"
        ? "This quote can meet you in traffic, family life, delayed plans, or the moment before irritation becomes speech."
        : "This quote can meet you in work, relationships, quiet routines, or any moment where awareness can guide the next step.";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: story.title,
    description: story.description,
    url: quoteUrl,
    author: {
      "@type": "Organization",
      name: SITE.author,
      url: `${SITE.url}/authors/echo-buddha-editorial/`
    },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      url: SITE.url
    },
    about: {
      "@type": "Thing",
      name: quote.theme
    },
    isPartOf: {
      "@type": "CollectionPage",
      name: `${quote.theme} Buddhist Quotes`,
      url: `${SITE.url}/quotes/${category.slug}/`
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: SITE.url
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Buddhist Quotes",
        item: `${SITE.url}/quotes/`
      },
      {
        "@type": "ListItem",
        position: 3,
        name: quote.theme,
        item: `${SITE.url}/quotes/${category.slug}/`
      },
      {
        "@type": "ListItem",
        position: 4,
        name: story.title,
        item: quoteUrl
      }
    ]
  }
];
---

<Layout
  title={story.title}
  description={story.description}
  canonicalPath={canonicalPath}
  type="article"
  noindex={!isIndexable}
  jsonLd={jsonLd}
>
  <article>
    <header class="page-hero story-hero">
      <div class="container prose">
        <a class="back-link" href={`/quotes/${category.slug}/`}>All {quote.theme} Quotes</a>
        <span class="eyebrow">{quote.theme} Reflection Story</span>
        <h1>{story.title}</h1>
        <blockquote>{quote.text}</blockquote>
        <div class="quote-share-row">
          <ArticleShare
            title={story.title}
            description={story.description}
            url={quoteUrl}
            variant="page"
          />
        </div>
      </div>
    </header>

    <div class="container article-shell">
      <div class="prose story-body">
        <aside class="surface meaning-box">
          <h2>Meaning of This Quote</h2>
          <p>{story.description}</p>
          <h2>Daily-Life Example</h2>
          <p>{dailyLifeExample}</p>
          <h2>Related Buddhist Teaching</h2>
          <p>
            This reflection connects with <a href={relatedTeaching.href}>{relatedTeaching.label}</a>, a practical way
            to bring Buddhist wisdom into ordinary life.
          </p>
          <h2>Practice Suggestion</h2>
          <p>{practiceSuggestion}</p>
        </aside>

        {story.intro ? (
          <>
            <p class="lede" set:html={story.intro} />
            {story.sections.map((section) => (
              <section>
                <h2>{section.heading}</h2>
                {section.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
              </section>
            ))}
          </>
        ) : (
          <>
            <h2>The Story</h2>
            {story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </>
        )}

        <AdSlot />

        <h2>Reflection Question</h2>
        <p>{reflectionQuestion}</p>

        <h2>A Quiet Reflection</h2>
        <p>
          Consider where this quote meets your own life today. Is there a conversation, habit, expectation, or
          difficult feeling that could be approached with a little more {quote.theme.toLowerCase()}?
        </p>
        <p>
          Keep the quote nearby and choose one small action that expresses its meaning. Buddhist-inspired wisdom
          becomes useful when reflection is followed by patient practice.
        </p>

        <section class="source-note">
          <h2>Source Note</h2>
          <p>
            This is an original Echo Buddha Buddhist-inspired reflection, not a direct scripture translation. For
            formal study, compare reputable Buddhist teachers, translations, and learning communities.
          </p>
        </section>
      </div>

      <aside>
        <div class="surface story-note">
          <span class="eyebrow">Quote category</span>
          <h2>{quote.theme}</h2>
          <p>{category.introduction}</p>
          <a href={`/quotes/${category.slug}/`}>Explore all {quote.theme} quotes</a>
        </div>
        <AdSlot size="box" />
      </aside>
    </div>
  </article>

  {relatedQuotes.length > 0 && (
    <section class="section section-band">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Quote to quote</span>
            <h2>Related {quote.theme} Quotes</h2>
          </div>
          <a href={`/quotes/${category.slug}/`}>View the category</a>
        </div>
        <div class="grid grid--3">
          {relatedQuotes.map((item) => <QuoteCard quote={item} />)}
        </div>
      </div>
    </section>
  )}

  {relatedArticles.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Quote to article</span>
            <h2>Continue the Reflection</h2>
          </div>
          <a href="/articles/">Browse all articles</a>
        </div>
        <div class="grid grid--2 related-article-grid">
          {relatedArticles.map((article) => <ArticleCard article={article} />)}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .back-link {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .story-hero blockquote {
    border-left: 3px solid var(--color-gold);
    color: var(--color-brown);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    margin: 1.5rem 0 0;
    padding-left: 1.25rem;
  }

  .quote-share-row {
    display: flex;
    margin-top: 1rem;
  }

  .story-body h2:first-child {
    margin-top: 0;
  }

  .meaning-box {
    margin-bottom: 2rem;
    padding: 1.25rem;
  }

  .meaning-box h2 {
    font-size: 1.25rem;
    margin-top: 1.35rem;
  }

  .meaning-box h2:first-child {
    margin-top: 0;
  }

  .meaning-box p {
    color: var(--color-muted);
  }

  .story-note {
    padding: 1.25rem;
  }

  .story-note h2 {
    font-size: 1.45rem;
  }

  .story-note p {
    color: var(--color-muted);
  }

  .section-band {
    background: rgba(247, 240, 229, 0.64);
    border-block: 1px solid var(--color-line);
  }

  .section-heading {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .section-heading a {
    font-weight: 800;
  }

  .related-article-grid {
    max-width: 760px;
  }
</style>

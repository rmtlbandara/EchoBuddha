---
import Layout from "../../layouts/Layout.astro";
import DailyReflectionCard from "../../components/DailyReflectionCard.astro";
import { dailyReflections, getDailyReflectionForDate, getDailyReflectionPath } from "../../data/dailyReflections";
import { SITE } from "../../data/site";

const title = "Today's Buddhist Reflection Prompt";
const description =
  "Open a recurring daily reflection prompt selected from Echo Buddha's original reflection library, with archive links and gentle practice guidance.";
const canonicalPath = "/daily-reflections/today/";
const fallbackReflection = getDailyReflectionForDate();
const reflectionPaths = dailyReflections.map((reflection) => getDailyReflectionPath(reflection));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    headline: title,
    name: title,
    description,
    url: `${SITE.url}${canonicalPath}`,
    publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
    isPartOf: {
      "@type": "CollectionPage",
      name: "Daily Buddhist Reflections",
      url: `${SITE.url}/daily-reflections/`
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
      { "@type": "ListItem", position: 2, name: "Daily Reflections", item: `${SITE.url}/daily-reflections/` },
      { "@type": "ListItem", position: 3, name: "Today", item: `${SITE.url}${canonicalPath}` }
    ]
  }
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} noindex jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <a class="back-link" href="/daily-reflections/">Daily Reflections</a>
      <span class="eyebrow">Today</span>
      <h1>Today's Buddhist Reflection Prompt</h1>
      <p class="lede">
        A recurring utility page that selects one prompt from Echo Buddha's original reflection library by UTC day.
        The URL stays stable; the full archive pages remain the permanent homes for each reflection.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container today-shell">
      <div data-daily-reflection-root>
        <p class="today-date" data-today-date></p>
        <h2 class="section-title">Selected Reflection</h2>
        <div class="reflection-stack">
          {dailyReflections.map((reflection) => (
            <div id={reflection.slug} data-daily-reflection-card data-reflection-slug={reflection.slug} hidden={reflection.slug !== fallbackReflection.slug}>
              <DailyReflectionCard reflection={reflection} />
            </div>
          ))}
        </div>
        <a class="full-reflection-link" href={getDailyReflectionPath(fallbackReflection)} data-current-reflection-link>
          Open the full reflection page
        </a>
        <div class="tool-actions">
          <button class="button" type="button" data-random-reflection>Show another reflection</button>
          <a class="button button--secondary" href="/tools/">Open practice tools</a>
        </div>
      </div>
      <aside class="surface note-card">
        <span class="eyebrow">Gentle note</span>
        <h2>Use This as a Prompt</h2>
        <p>
          These reflections are educational and contemplative. They may support mindfulness for some readers, but they
          are not medical advice or a replacement for professional care.
        </p>
        <p>Return tomorrow for a new reflection, or use the random button when a different prompt would be helpful.</p>
        <nav aria-label="Related daily reflection links">
          <a href="/start-here/">Start Here</a>
          <a href="/meditation/">Meditation</a>
          <a href="/mindful-living/">Mindful Living</a>
        </nav>
      </aside>
    </div>
  </section>
</Layout>

<script define:vars={{ reflectionCount: dailyReflections.length, reflectionPaths }}>
  const root = document.querySelector("[data-daily-reflection-root]");
  const cards = [...document.querySelectorAll("[data-daily-reflection-card]")];
  const dateLabel = document.querySelector("[data-today-date]");
  const randomButton = document.querySelector("[data-random-reflection]");
  const fullReflectionLink = document.querySelector("[data-current-reflection-link]");

  const dayOfYear = (date) => {
    const start = Date.UTC(date.getUTCFullYear(), 0, 0);
    const today = Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate());
    return Math.floor((today - start) / 86400000);
  };

  const showIndex = (index) => {
    cards.forEach((card, cardIndex) => {
      card.hidden = cardIndex !== index;
    });
    if (fullReflectionLink) {
      fullReflectionLink.href = reflectionPaths[index] || "/daily-reflections/";
    }
  };

  if (root && cards.length) {
    const today = new Date();
    const todayIndex = (dayOfYear(today) - 1) % reflectionCount;
    showIndex(todayIndex);
    if (dateLabel) {
      dateLabel.textContent = new Intl.DateTimeFormat(undefined, {
        weekday: "long",
        month: "long",
        day: "numeric",
        year: "numeric"
      }).format(today);
    }

    randomButton?.addEventListener("click", () => {
      const visibleIndex = cards.findIndex((card) => !card.hidden);
      const nextIndex = (visibleIndex + 7) % cards.length;
      showIndex(nextIndex);
    });
  }
</script>

<style>
  .back-link {
    display: block;
    font-size: 0.9rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .today-shell {
    display: grid;
    gap: 1.5rem;
  }

  .today-date {
    color: var(--color-green);
    font-weight: 900;
  }

  .section-title {
    font-size: clamp(1.7rem, 4vw, 2.25rem);
  }

  .tool-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .full-reflection-link {
    display: inline-flex;
    font-weight: 800;
    margin-top: 1rem;
  }

  .tool-actions .button {
    cursor: pointer;
  }

  .note-card {
    padding: 1.25rem;
  }

  .note-card h2 {
    font-size: 1.35rem;
  }

  .note-card p {
    color: var(--color-muted);
  }

  .note-card nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .note-card nav a {
    background: var(--color-green-soft);
    border-radius: var(--radius);
    color: var(--color-green);
    font-size: 0.86rem;
    font-weight: 800;
    padding: 0.42rem 0.68rem;
    text-decoration: none;
  }

  @media (min-width: 920px) {
    .today-shell {
      align-items: start;
      grid-template-columns: minmax(0, 1fr) 18rem;
    }
  }
</style>

---
import Layout from "../../layouts/Layout.astro";
import LearningCard from "../../components/LearningCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import {
  dailyReflections,
  getDailyReflectionDetails,
  getDailyReflectionExample,
  getDailyReflectionPath,
  getDailyReflectionQuoteLinks,
  type DailyReflection
} from "../../data/dailyReflections";
import { SITE } from "../../data/site";
import { EDITORIAL_AUTHOR_SCHEMA, PUBLISHER_SCHEMA } from "../../data/editorialGovernance";

export function getStaticPaths() {
  return dailyReflections.map((reflection) => ({
    params: { slug: reflection.slug },
    props: { reflection }
  }));
}

const { reflection } = Astro.props as { reflection: DailyReflection };
const canonicalPath = getDailyReflectionPath(reflection);
const title = `${reflection.title} - Daily Buddhist Reflection`;
const description = `${reflection.reflection} Includes meaning, daily-life example, practice, journal question, and related Buddhist teachings.`;
const details = getDailyReflectionDetails(reflection);
const reflectionModel = {
  "ethical decision": { insight: "The Choice in View", situation: "Where the Choice Appears", practice: "A Response to Test" },
  "short contemplative exercise": { insight: "The Experience to Notice", situation: "When to Pause", practice: "Try the Exercise" },
  "contemplative exercise": { insight: "The Experience to Notice", situation: "Where the Grip Appears", practice: "Try the Exercise" },
  "relationship practice": { insight: "Where Relationship Becomes Practice", situation: "The Human Situation", practice: "A Relational Response" },
  observation: { insight: "What to Watch Changing", situation: "Where It Becomes Visible", practice: "Observe It Directly" },
  "mindful activity": { insight: "Attention in Motion", situation: "An Ordinary Place to Begin", practice: "Use the Activity" },
  "one-sentence reminder plus practice": { insight: "The Reminder", situation: "When to Remember It", practice: "Keep It Small" },
  "question-led reflection": { insight: "The Question Beneath the Reaction", situation: "Where the Question Opens", practice: "Stay With the Question" },
  "morning intention": { insight: "Before the Day Chooses for You", situation: "The First Point of Contact", practice: "Set the Intention" },
  "evening review": { insight: "What the Day Can Teach", situation: "At the End of the Day", practice: "Review Without a Trial" }
}[details?.form ?? ""] ?? { insight: "What This Reflection Notices", situation: "Where It Appears", practice: "Practice for Today" };
const dailyLifeExample = getDailyReflectionExample(reflection);
const relatedQuoteLinks = getDailyReflectionQuoteLinks(reflection);
const continueLinks = [
  { label: "Today's Reflection", href: "/daily-reflections/today/", description: "Open the reflection selected for today's date." },
  { label: "Daily Reflections Hub", href: "/daily-reflections/", description: "Browse the reflection library and daily practice notes." },
  { label: "Practice Tools", href: "/tools/", description: "Use the meditation timer, breathing timer, quote tool, and reflection prompt." }
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: `${SITE.url}${canonicalPath}`,
    author: EDITORIAL_AUTHOR_SCHEMA,
    publisher: PUBLISHER_SCHEMA,
    about: { "@type": "Thing", name: reflection.relatedIdea },
    learningResourceType: details?.form ?? "daily reflection",
    isPartOf: {
      "@type": "CollectionPage",
      name: "Daily Buddhist Reflections",
      url: `${SITE.url}/daily-reflections/`
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
      { "@type": "ListItem", position: 2, name: "Daily Reflections", item: `${SITE.url}/daily-reflections/` },
      { "@type": "ListItem", position: 3, name: reflection.title, item: `${SITE.url}${canonicalPath}` }
    ]
  }
];
---

<Layout title={title} description={description} canonicalPath={canonicalPath} type="article" noindex jsonLd={jsonLd}>
  <article>
    <header class="page-hero">
      <div class="container prose">
        <Breadcrumbs items={[
          { label: "Home", href: "/" },
          { label: "Daily Reflections", href: "/daily-reflections/" },
          { label: reflection.title }
        ]} />
        <span class="eyebrow">{reflection.relatedIdea}</span>
        <h1>{reflection.title}</h1>
        <blockquote>{reflection.reflection}</blockquote>
        {details && <p class="reflection-form">{details.form}</p>}
      </div>
    </header>

    <div class="container article-shell">
      <div class="prose reflection-body">
        <section class="surface reflection-summary">
          <h2>{reflectionModel.insight}</h2>
          {details && <p>{details.centralObservation}</p>}
          <p>{reflection.meaning}</p>
        </section>

        <h2>{reflectionModel.situation}</h2>
        <p>{dailyLifeExample}</p>
        {details && <p class="next-step"><strong>One next step:</strong> {details.nextStep}</p>}

        <h2>{reflectionModel.practice}</h2>
        <p>{reflection.practice}</p>

        <h2>A Question to Keep</h2>
        <p>{reflection.journalQuestion}</p>

	        <h2>Related Buddhist Idea</h2>
	        <p>
	          This reflection connects with <strong>{reflection.relatedIdea}</strong>. Use the links below to continue with
	          a fuller teaching or a quote category that supports the same practice.
	        </p>

        <section class="reflection-context" aria-labelledby="reflection-context-heading">
          <h2 id="reflection-context-heading">How to Use This Reflection</h2>
          <p>
            Read this page as a small practice note rather than a rule for every situation. Echo Buddha reflections are
            original educational writing inspired by Buddhist themes such as non-harming, mindfulness, compassion,
            impermanence, and wise intention.
          </p>
          <p>
            If the reflection names a difficult emotion or relationship, keep practical safety and boundaries in view.
            A gentle pause can support clarity, but it should not replace qualified help, honest communication, or
            necessary protection.
          </p>
        </section>

        <nav class="reflection-link-list" aria-label={`Related teachings for ${reflection.title}`}>
          {reflection.relatedLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          {relatedQuoteLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>

        <section class="source-note">
          <h2>Editorial Note</h2>
          <p>
            This is an original Echo Buddha reflection written for education and daily contemplation. It is not medical
            advice, and mindfulness or meditation should be practiced gently according to your needs. Read the
            <a href="/editorial-policy/">Editorial Policy</a> and <a href="/disclaimer/">Disclaimer</a> for the site's
            review standards and limitations. Seek qualified professional support for serious, persistent, or unsafe
            distress.
          </p>
          {details?.wellbeingNote && <p>{details.wellbeingNote}</p>}
        </section>
      </div>

      <aside>
        <div class="surface side-note">
          <span class="eyebrow">Return tomorrow</span>
          <h2>Make It a Daily Practice</h2>
          <p>
            Read one reflection, try one small practice, and let one question stay with you. Tomorrow's page will offer
            a new prompt from the reflection library.
          </p>
          <a class="button button--secondary" href="/daily-reflections/today/">Open today's reflection</a>
        </div>
      </aside>
    </div>
  </article>

  <section class="section section-band">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Continue practice</span>
          <h2>Practice Next</h2>
        </div>
      </div>
      <div class="grid grid--3">
        {continueLinks.map((item) => <LearningCard item={item} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  blockquote {
    border-left: 3px solid var(--color-gold);
    color: var(--color-brown);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    margin: 1.5rem 0 0;
    padding-left: 1.25rem;
  }

  .reflection-form {
    background: var(--color-green-soft);
    border: 1px solid rgba(45, 106, 79, 0.2);
    border-radius: var(--radius);
    color: var(--color-green);
    display: inline-flex;
    font-size: 0.86rem;
    font-weight: 900;
    margin-top: 1rem;
    padding: 0.35rem 0.65rem;
    text-transform: capitalize;
  }

  .reflection-summary,
  .side-note {
    padding: 1.25rem;
  }

  .reflection-summary h2,
  .side-note h2 {
    font-size: 1.35rem;
    margin-top: 0;
  }

  .reflection-summary p,
  .side-note p {
    color: var(--color-muted);
  }

	  .reflection-link-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.25rem 0 2rem;
	  }

  .reflection-context {
    border-block: 1px solid var(--color-line);
    margin: 2rem 0;
    padding: 0.5rem 0 1rem;
  }

  .reflection-link-list a {
    background: var(--color-green-soft);
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--color-green);
    font-size: 0.88rem;
    font-weight: 800;
    padding: 0.45rem 0.75rem;
    text-decoration: none;
  }

  .reflection-link-list a:hover {
    border-color: var(--color-green);
  }

  .section-heading {
    margin-bottom: 1.25rem;
  }
</style>

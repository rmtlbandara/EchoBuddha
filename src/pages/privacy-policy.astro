---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/site";

const title = "Privacy Policy";
const description = "Read how Echo Buddha handles analytics, cookies, advertising technologies, email messages, and privacy choices.";
const canonicalPath = "/privacy-policy/";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "PrivacyPolicy",
  name: title,
  description,
  url: `${SITE.url}${canonicalPath}`,
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url,
    email: SITE.email
  }
};
---

<Layout title={title} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Policy</span>
      <h1>Privacy Policy</h1>
      <p class="lede">Last updated: July 3, 2026</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container prose">
      <h2>Overview</h2>
      <p>
        Echo Buddha is an educational website. This policy explains the types of information that may be collected
        when visitors use the site and how future services may affect privacy.
      </p>
      <h2>Cookies and Analytics</h2>
      <p>
        Echo Buddha uses Google Analytics to understand general website usage, such as page views, approximate device
        information, and navigation patterns. Google Analytics may use cookies or related technologies. This information
        helps improve content and website performance and is not used by Echo Buddha to identify visitors personally.
      </p>
      <p>
        Analytics information is reviewed in aggregate where possible. Echo Buddha uses it to understand which pages
        are useful, identify technical issues, and improve navigation, search, and reading experience.
      </p>
      <h2>Advertising and Google AdSense</h2>
      <p>
        Echo Buddha may use third-party advertising services, including Google AdSense. Third-party vendors, including
        Google, may use cookies to serve ads based on a visitor's prior visits to this website or other websites.
        Advertising cookies may support ad delivery, frequency limits, measurement, fraud prevention, and personalized
        or non-personalized advertising, depending on user choices and applicable law.
      </p>
      <p>
        Before live ad code is added, visible ad areas may appear only as clearly labeled Advertisement spaces. These
        areas do not collect information by themselves unless a third-party advertising service is later enabled.
      </p>
      <p>
        Visitors can learn about or manage Google ad personalization through
        <a href="https://adssettings.google.com/" rel="noopener noreferrer">Google Ads Settings</a>. Additional choices
        may be available through browser settings or regional consent tools.
      </p>
      <h2>Contact and Email</h2>
      <p>
        If you contact Echo Buddha by email, your message and email address may be used to respond to your inquiry.
        Email messages are not sold or used to create public profiles.
      </p>
      <h2>Third-Party Links</h2>
      <p>
        Articles may link to external resources. Echo Buddha is not responsible for the privacy practices of
        third-party websites.
      </p>
      <h2>Your Choices</h2>
      <p>
        You can restrict or delete cookies through browser controls. Blocking some technologies may affect website
        features or measurement. Where legally required, additional consent choices may be presented before
        non-essential cookies are used.
      </p>
      <h2>Contact</h2>
      <p>
        Questions about this policy can be sent to
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </section>
</Layout>

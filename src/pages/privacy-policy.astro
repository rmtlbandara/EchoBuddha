---
import Layout from "../layouts/Layout.astro";

const title = "Privacy Policy";
const description = "Read the Echo Buddha privacy policy covering cookies, analytics, advertising placeholders, email, and contact information.";
---

<Layout title={title} description={description} canonicalPath="/privacy-policy/">
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Policy</span>
      <h1>Privacy Policy</h1>
      <p class="lede">Last updated: June 22, 2026</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container prose">
      <h2>Overview</h2>
      <p>
        Echo Buddha is an educational website. This policy explains the types of information that may be collected
        when visitors use the site and how future services may affect privacy.
      </p>
      <h2>Cookies and Analytics</h2>
      <p>
        This starter site does not include active analytics scripts. In the future, Echo Buddha may use privacy-conscious
        analytics or similar tools to understand page views, device types, and general usage patterns. These tools may
        use cookies or related technologies.
      </p>
      <h2>Advertising</h2>
      <p>
        The website includes advertising placeholder areas only. No real advertising code is installed at launch.
        If advertising networks such as Google AdSense are added later, those services may use cookies to personalize,
        measure, or limit advertising. This policy should be reviewed and updated before any advertising code is enabled.
      </p>
      <h2>Contact and Email</h2>
      <p>
        If you contact Echo Buddha by email, your message and email address may be used to respond to your inquiry.
        Newsletter functionality is currently a placeholder and should not collect addresses until a proper email service
        and consent process are connected.
      </p>
      <h2>Third-Party Links</h2>
      <p>
        Future articles may link to external resources. Echo Buddha is not responsible for the privacy practices of
        third-party websites.
      </p>
      <h2>Contact</h2>
      <p>
        Questions about this policy can be sent to
        <a href="mailto:info.echobuddha@gmail.com">info.echobuddha@gmail.com</a>.
      </p>
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import QuoteCard from "../components/QuoteCard.astro";
import AdSlot from "../components/AdSlot.astro";
import { SITE, getQuoteSlug, quoteCategories, quotes } from "../data/site";

const title = "Original Buddhist-Inspired Quotes";
const description = "Read original Echo Buddha quotes inspired by Buddhist practice, with clear origin labels, reflection stories, and mindful browsing by theme.";
const quoteOfTheDay = quotes.find((quote) => quote.story) ?? quotes[0];
const relatedReadingByTheme = {
  Mindfulness: "/articles/beginning-a-daily-mindfulness-practice/",
  Compassion: "/articles/compassion-in-buddhism-beginner-guide/",
  Patience: "/articles/three-ways-to-practice-patience/",
  Awareness: "/articles/mindfulness-vs-meditation/",
  Practice: "/learn/buddhism-101/a-simple-daily-buddhist-practice/",
  "Letting Go": "/articles/how-to-let-go-of-attachment-in-buddhism/",
  Meditation: "/meditation/",
  Renewal: "/articles/how-to-let-go-of-attachment-in-buddhism/",
  Wisdom: "/articles/what-is-buddhism-beginner-guide/",
  Impermanence: "/articles/impermanence-in-buddhism-letting-go/"
};
const quoteRelatedReading = quoteCategories
  .map((category) => ({
    label: `${category.name} reading`,
    href: relatedReadingByTheme[category.name]
  }))
  .filter((item) => item.href);
const quoteSourcePaths = [
  {
    title: "Original Echo Buddha Quotes",
    href: "/quote-attribution-policy/",
    description: "Current quote pages are original editorial reflections unless a page clearly says otherwise."
  },
  {
    title: "Future Verified Buddhist Text Quotes",
    href: "/buddhist-sources-and-citations/",
    description: "Future scripture or named-source quotations need visible source, translation, and attribution context."
  },
  {
    title: "Quote to Practice",
    href: "/mindful-living/",
    description: "Move from a short line into speech, patience, compassion, letting go, and daily-life practice."
  }
];
const editorialStartingSlugs = new Set([
  "begin-the-day-with-awareness",
  "kindness-as-quiet-practice",
  "patience-softens-the-wait",
  "caring-without-clinging",
  "one-honest-breath",
  "difficult-people-and-boundaries"
]);
const editorialStartingQuotes = quotes.filter((quote) => editorialStartingSlugs.has(getQuoteSlug(quote)));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: `${SITE.url}/quotes/`,
    numberOfItems: quotes.length
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: SITE.url
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Quotes",
        item: `${SITE.url}/quotes/`
      }
    ]
  }
];
---

<Layout title={title} description={description} canonicalPath="/quotes/" jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Quotes</span>
      <h1>Original Buddhist-Inspired Quotes</h1>
      <p class="lede">
        Browse {quotes.length} short original Echo Buddha quotes inspired by Buddhist practice. These are editorial
        reflections for mindful reading, not direct Buddha quotes or scripture translations.
      </p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container" data-filter-root>
      <aside class="surface quote-note" aria-labelledby="quote-note-heading">
        <div>
          <span class="eyebrow">Quote of the day</span>
          <h2 id="quote-note-heading">{quoteOfTheDay.text}</h2>
          <p>
            Echo Buddha quotes are original editorial reflections inspired by Buddhist practice. If a future page uses
            a traditional or named-source quotation, it should be labeled separately and sourced visibly.
          </p>
        </div>
        {quoteOfTheDay.story && (
          <a class="button button--secondary" href={`/quotes/${quoteOfTheDay.theme.toLowerCase().replace(/[^a-z0-9]+/g, "-")}/${quoteOfTheDay.story.slug}/`}>
            Read the reflection
          </a>
        )}
      </aside>
      <section class="quote-pathways" aria-labelledby="quote-pathways-heading">
        <span class="eyebrow">Quote integrity</span>
        <h2 id="quote-pathways-heading">Know What Kind of Quote You Are Reading</h2>
        <div class="quote-pathway-grid">
          {quoteSourcePaths.map((path) => (
            <a class="surface quote-pathway" href={path.href}>
              <strong>{path.title}</strong>
              <span>{path.description}</span>
            </a>
          ))}
        </div>
      </section>
      <section class="editorial-starting-points" aria-labelledby="editorial-starting-heading">
        <div class="section-heading">
          <div>
            <span class="eyebrow">A smaller place to begin</span>
            <h2 id="editorial-starting-heading">Editorial Starting Points</h2>
          </div>
        </div>
        <p>
          This short selection offers different ways into attention, compassion, patience, non-attachment,
          meditation, and wise boundaries. The full collection remains browsable below, but a quote does not need a
          standalone Search page simply because it has a shareable permalink.
        </p>
        <div class="grid grid--3">
          {editorialStartingQuotes.map((quote) => <QuoteCard quote={quote} />)}
        </div>
      </section>
      <div class="category-heading">
        <span class="eyebrow">Browse by category</span>
        <h2>Choose a Theme</h2>
      </div>
      <nav class="category-grid" aria-label="Buddhist quote categories">
        {quoteCategories.map((category) => (
          <a class="category-link surface" href={`/quotes/${category.slug}/`}>
            <span>{category.name}</span>
            <small>{category.count} quotes</small>
          </a>
        ))}
      </nav>

      <nav class="related-reading-row" aria-label="Quote theme related reading">
        {quoteRelatedReading.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="surface filter-panel">
        <label for="quote-filter">Search quotes</label>
        <div class="filter-controls">
          <input
            id="quote-filter"
            type="search"
            data-filter-input
            autocomplete="off"
            placeholder="Search quote text, theme, mindfulness, compassion, patience..."
          />
          <button type="button" data-filter-clear>Clear</button>
        </div>
        <p class="filter-empty" data-filter-empty hidden>No quotes found. Try mindfulness, compassion, letting go, or wisdom.</p>
      </div>

      <h2 class="all-quotes-heading">All Buddhist Quotes</h2>
      <div class="grid grid--3">
        {quotes.map((quote) => (
          <div data-filter-item data-filter-text={`${quote.text} ${quote.theme} ${quote.story?.title ?? ""} ${quote.story?.description ?? ""}`}>
            <QuoteCard quote={quote} />
          </div>
        ))}
      </div>
      <AdSlot />
    </div>
  </section>
</Layout>

<style>
  .category-heading h2 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }

  .quote-pathways {
    margin-bottom: 1.5rem;
  }

  .editorial-starting-points {
    margin: 2rem 0 2.5rem;
  }

  .editorial-starting-points > p {
    color: var(--color-muted);
    max-width: 52rem;
  }

  .quote-pathways h2 {
    font-size: clamp(1.65rem, 3vw, 2.1rem);
  }

  .quote-pathway-grid {
    display: grid;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .quote-pathway {
    color: var(--color-ink);
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
    text-decoration: none;
  }

  .quote-pathway strong {
    color: var(--color-green);
    font-family: var(--font-serif);
    font-size: 1.08rem;
  }

  .quote-pathway span {
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .quote-note {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding: 1.25rem;
  }

  .quote-note h2 {
    font-size: clamp(1.45rem, 3vw, 1.9rem);
    max-width: 760px;
  }

  .quote-note p {
    color: var(--color-muted);
    margin-bottom: 0;
    max-width: 760px;
  }

  .category-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .category-link {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1rem;
    text-decoration: none;
  }

  .category-link span {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.12rem;
    font-weight: 700;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .category-link small {
    color: var(--color-green);
    font-size: 0.8rem;
    font-weight: 800;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .category-link:hover {
    border-color: var(--color-green);
  }

  .related-reading-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .related-reading-row a {
    background: var(--color-green-soft);
    border-radius: 999px;
    color: var(--color-green);
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.3rem 0.7rem;
    text-decoration: none;
  }

  .related-reading-row a:hover {
    color: var(--color-brown);
  }

  .all-quotes-heading {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-top: 3rem;
  }

  .filter-panel {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding: 1.25rem;
  }

  .filter-panel label {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .filter-controls {
    display: grid;
    gap: 0.65rem;
  }

  .filter-controls input {
    background: #fffdf8;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-ink);
    font: inherit;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    width: 100%;
  }

  .filter-controls button {
    background: transparent;
    border: 1px solid var(--color-brown);
    border-radius: var(--radius);
    color: var(--color-brown);
    cursor: pointer;
    font: inherit;
    font-weight: 800;
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
  }

  .filter-controls button:hover {
    background: var(--color-green-soft);
    border-color: var(--color-green);
    color: var(--color-green);
  }

  .filter-empty {
    color: var(--color-muted);
    margin-bottom: 0;
  }

  @media (min-width: 720px) {
    .category-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .quote-pathway-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .filter-controls {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>

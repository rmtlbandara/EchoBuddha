---
import Layout from "../layouts/Layout.astro";
import QuoteCard from "../components/QuoteCard.astro";
import AdSlot from "../components/AdSlot.astro";
import { SITE, quoteCategories, quotes } from "../data/site";

const title = "Buddhist Quotes";
const description = "Read original Buddhist-inspired quotes about mindfulness, compassion, patience, letting go, and peaceful living.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: `${SITE.url}/quotes/`,
  numberOfItems: quotes.length
};
---

<Layout title={title} description={description} canonicalPath="/quotes/" jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Quotes</span>
      <h1>Buddhist Quotes</h1>
      <p class="lede">
        Browse {quotes.length} short original reflections inspired by Buddhist practice, written for mindful reading and
        daily contemplation.
      </p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container" data-filter-root>
      <div class="category-heading">
        <span class="eyebrow">Browse by category</span>
        <h2>Choose a Theme</h2>
      </div>
      <nav class="category-grid" aria-label="Buddhist quote categories">
        {quoteCategories.map((category) => (
          <a class="category-link surface" href={`/quotes/${category.slug}/`}>
            <span>{category.name}</span>
            <small>{category.count} quotes</small>
          </a>
        ))}
      </nav>

      <div class="surface filter-panel">
        <label for="quote-filter">Search quotes</label>
        <div class="filter-controls">
          <input
            id="quote-filter"
            type="search"
            data-filter-input
            autocomplete="off"
            placeholder="Search quote text, theme, mindfulness, compassion, patience..."
          />
          <button type="button" data-filter-clear>Clear</button>
        </div>
        <p class="filter-empty" data-filter-empty hidden>No quotes found. Try mindfulness, compassion, letting go, or wisdom.</p>
      </div>

      <h2 class="all-quotes-heading">All Buddhist Quotes</h2>
      <div class="grid grid--3">
        {quotes.map((quote) => (
          <div data-filter-item data-filter-text={`${quote.text} ${quote.theme} ${quote.story?.title ?? ""} ${quote.story?.description ?? ""}`}>
            <QuoteCard quote={quote} />
          </div>
        ))}
      </div>
      <AdSlot />
    </div>
  </section>
</Layout>

<style>
  .category-heading h2 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }

  .category-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .category-link {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1rem;
    text-decoration: none;
  }

  .category-link span {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.12rem;
    font-weight: 700;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .category-link small {
    color: var(--color-green);
    font-size: 0.8rem;
    font-weight: 800;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .category-link:hover {
    border-color: var(--color-green);
  }

  .all-quotes-heading {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-top: 3rem;
  }

  .filter-panel {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding: 1.25rem;
  }

  .filter-panel label {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .filter-controls {
    display: grid;
    gap: 0.65rem;
  }

  .filter-controls input {
    background: #fffdf8;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-ink);
    font: inherit;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    width: 100%;
  }

  .filter-controls button {
    background: transparent;
    border: 1px solid var(--color-brown);
    border-radius: var(--radius);
    color: var(--color-brown);
    cursor: pointer;
    font: inherit;
    font-weight: 800;
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
  }

  .filter-controls button:hover {
    background: var(--color-green-soft);
    border-color: var(--color-green);
    color: var(--color-green);
  }

  .filter-empty {
    color: var(--color-muted);
    margin-bottom: 0;
  }

  @media (min-width: 720px) {
    .category-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .filter-controls {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>

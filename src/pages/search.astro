---
import Layout from "../layouts/Layout.astro";

const title = "Search Echo Buddha";
const description =
  "Search Echo Buddha for Buddhist teachings, meditation guides, Dhammapada reflections, quotes, and beginner-friendly wisdom for daily life.";
const popularSearches = [
  "Mindfulness",
  "Metta",
  "Karma",
  "Anicca",
  "Meditation",
  "Dhammapada",
  "Patience",
  "Compassion",
  "Anger",
  "Four Noble Truths"
];
const discoveryLinks = [
  { label: "Start Here", href: "/start-here/" },
  { label: "Daily Reflection", href: "/daily-reflections/today/" },
  { label: "Beginner Buddhism", href: "/learn/buddhism-for-beginners/" },
  { label: "Meditation Guides", href: "/meditation/" },
  { label: "Quote Categories", href: "/quotes/" },
  { label: "Buddhist Dictionary", href: "/learn/buddhist-dictionary/" },
  { label: "Practice Tools", href: "/tools/" }
];
const noResultLinks = [
  { label: "Start Here", href: "/start-here/" },
  { label: "Daily Reflection", href: "/daily-reflections/today/" },
  { label: "Buddhism 101", href: "/learn/buddhism-101/" },
  { label: "Meditation Guides", href: "/meditation/" },
  { label: "Buddhist Dictionary", href: "/learn/buddhist-dictionary/" },
  { label: "Dhammapada Reflections", href: "/learn/dhammapada-reflections/" },
  { label: "Quotes", href: "/quotes/" }
];
---

<Layout title={title} description={description} canonicalPath="/search/" noindex>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">Search</span>
      <h1>Search Echo Buddha</h1>
      <p class="lede">
        Find Buddhist terms, articles, quotes, meditation guides, Dhammapada reflections, sutta notes, and beginner
        learning pages across Echo Buddha.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container search-page" data-search-root data-search-mode="page">
      <form class="search-page-form surface" data-search-form action="/search/" method="get" role="search">
        <label for="site-search-page-input">Search Echo Buddha</label>
        <div>
          <input
            id="site-search-page-input"
            name="q"
            type="search"
            data-search-input
            autocomplete="off"
            placeholder="Search Buddhist wisdom, meditation, quotes, and teachings..."
          />
          <button type="submit">Search</button>
          <button type="button" class="clear-button" data-search-clear>Clear</button>
        </div>
      </form>

      <div class="search-page-meta">
        <span data-search-count aria-live="polite"></span>
      </div>

      <div class="surface search-page-state" data-search-empty>
        <h2>What would you like to explore?</h2>
        <p>Search for a Buddhist teaching, meditation practice, quote, or term.</p>
        <div class="popular-searches" aria-label="Suggested popular searches">
          {popularSearches.map((term) => <button type="button" data-popular-search={term}>{term}</button>)}
        </div>
        <nav class="no-result-links discovery-links" aria-label="Browse Echo Buddha sections">
          {discoveryLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>

      <div class="surface search-page-state" data-search-no-results hidden>
        <h2>No results found</h2>
        <p>Try searching for mindfulness, metta, karma, meditation, or compassion.</p>
        <nav class="no-result-links" aria-label="Helpful search alternatives">
          {noResultLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>

      <ol class="search-page-results" data-search-results aria-label="Search results"></ol>
    </div>
  </section>
</Layout>

<style>
  .search-page {
    display: grid;
    gap: 1rem;
  }

  .search-page-form {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .search-page-form label {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .search-page-form div {
    display: grid;
    gap: 0.65rem;
  }

  .search-page-form input {
    background: #fffdf8;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-ink);
    font: inherit;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    width: 100%;
  }

  .search-page-form button {
    background: var(--color-brown);
    border: 1px solid var(--color-brown);
    border-radius: var(--radius);
    color: #fffaf1;
    cursor: pointer;
    font: inherit;
    font-weight: 800;
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
  }

  .search-page-form .clear-button {
    background: transparent;
    color: var(--color-brown);
  }

  .search-page-form button:hover {
    background: var(--color-green);
    border-color: var(--color-green);
    color: #fff;
  }

  .search-page-meta {
    color: var(--color-green);
    font-size: 0.9rem;
    font-weight: 800;
    min-height: 1.5rem;
  }

  .search-page-state {
    padding: 1.25rem;
  }

  .search-page-state h2 {
    font-size: 1.55rem;
  }

  .search-page-state p {
    color: var(--color-muted);
  }

  .popular-searches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .no-result-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .no-result-links a,
  .popular-searches button {
    background: var(--color-green-soft);
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--color-green);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 800;
    padding: 0.45rem 0.75rem;
    text-decoration: none;
  }

  .popular-searches button {
    cursor: pointer;
  }

  .no-result-links a:hover,
  .popular-searches button:hover {
    border-color: var(--color-green);
  }

  .search-page-results {
    display: grid;
    gap: 0.85rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 720px) {
    .search-page-form div {
      grid-template-columns: minmax(0, 1fr) auto auto;
    }
  }
</style>

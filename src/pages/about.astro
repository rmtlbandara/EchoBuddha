---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../data/site";
import { PUBLISHER_SCHEMA } from "../data/editorialGovernance";

const title = "About Echo Buddha";
const description = "Learn about Echo Buddha's purpose, educational approach, editorial standards, and respectful Buddhist-inspired content.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: title,
  description,
  url: `${SITE.url}/about/`,
  mainEntity: {
    ...PUBLISHER_SCHEMA,
    email: SITE.email
  }
};
---

<Layout title={title} description={description} canonicalPath="/about/" jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container prose">
      <span class="eyebrow">About</span>
      <h1>About Echo Buddha</h1>
      <p class="lede">
        Echo Buddha is a quiet online space for original Buddhist-inspired quotes, articles, and meditation guidance.
      </p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container prose">
      <h2>Purpose</h2>
      <p>
        The project is designed for readers who want simple, respectful reflections on mindfulness, compassion,
        patience, and daily practice. The content is educational and introductory, written in plain language for
        a broad audience.
      </p>
      <p>
        Echo Buddha is especially helpful for beginners who want to understand Buddhist ideas slowly: what the Buddha
        taught, how meditation is practiced, what terms such as karma or metta mean, and how these themes can support
        kinder speech and steadier attention in ordinary life.
      </p>
      <p>
        Echo Buddha does not claim to replace traditional teachers, Buddhist communities, or careful study.
        It offers a gentle starting point and encourages readers to approach the teachings with humility.
      </p>
      <h2>Educational and Reflective Content</h2>
      <p>
        Articles, quote reflections, and meditation guides are created for general education and personal reflection.
        They are not a substitute for professional mental health, medical, legal, or religious advice. Readers facing
        serious distress or important personal decisions should seek appropriately qualified support.
      </p>
      <p>
        The website separates original reflections from traditional Buddhist themes. When a page discusses a teaching,
        it is presented as an accessible explanation rather than an official translation or final authority.
      </p>
      <h2>Editorial Approach</h2>
      <p>
        Echo Buddha publishes original writing in accessible language. The editorial voice avoids sensational claims,
        false attribution, invented authority, and promises that meditation or spiritual practice will guarantee a
        particular outcome.
      </p>
      <p>
        Learn more about how content is prepared and corrected in the
        <a href="/editorial-policy/">Editorial Policy</a>,
        <a href="/how-echo-buddha-creates-content/">How Echo Buddha Creates Content</a>, or read about
        <a href="/authors/echo-buddha-editorial/">Echo Buddha Editorial</a>.
      </p>
      <h2>Publisher and Authorship</h2>
      <p>
        Echo Buddha is the publisher responsible for this website. “Echo Buddha Editorial” is the organizational
        publication byline used on site-authored material; it is not a named person, a professional credential, or a
        claim that an expert review board exists. Internal editorial checks do not mean outside monastic, academic,
        medical, clinical, or legal approval.
      </p>
      <p>
        Current quote and reflection pages are intended as original Echo Buddha writing unless a page clearly identifies
        a traditional, historical, or named source. Traditional Buddhist terms and teachings are introduced with source
        notes where relevant, but formal doctrinal and translation questions should be checked with qualified teachers
        and reputable translations. The <a href="/quote-attribution-policy/">Quote Attribution Policy</a> and
        <a href="/buddhist-sources-and-citations/">Buddhist Sources and Citations</a> explain those standards.
      </p>
      <h2>Transparency and Contact</h2>
      <p>
        Please review the <a href="/disclaimer/">Disclaimer</a> for important limitations, the
        <a href="/privacy-policy/">Privacy Policy</a> for information about analytics and advertising, or
        <a href="/corrections/">Corrections and Editorial Updates</a> to report a concern.
      </p>
      <p>
        Publisher and correction contact: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </section>
</Layout>

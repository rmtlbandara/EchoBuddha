{
  "name": "echo-buddha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "prebuild": "node scripts/block-legacy-cloudflare-production-build.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "lint": "node scripts/lint-governance.mjs",
    "audit:content": "node scripts/audit-content-remediation.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:browser": "node scripts/browser-readiness-check.mjs",
    "audit:q3q4:browser": "node scripts/validate-buddhist-questions-q3-q4-browser.mjs",
    "audit:buddhist-questions:browser": "node scripts/validate-buddhist-questions-browser.mjs",
    "audit:lighthouse": "node scripts/lighthouse-readiness.mjs",
    "images:articles": "node scripts/generate-article-image-variants.mjs",
    "audit:images": "node scripts/audit-article-images.mjs",
    "audit:phase8": "node scripts/validate-phase-8.mjs && node docs/audits/adsense-recovery-phase-8-2026-08-24/validate-phase-8-cookie-cutter.mjs",
    "audit:cookie-cutter": "node docs/audits/adsense-recovery-phase-8-2026-08-24/validate-phase-8-cookie-cutter.mjs",
    "audit:phase8:release": "node docs/audits/adsense-recovery-phase-8-2026-08-24/run-phase-8-release-validation.mjs",
    "audit:phase9": "node scripts/validate-phase-9.mjs && node docs/audits/adsense-recovery-phase-9-2026-08-24/validate-phase-9-ux.mjs",
    "audit:phase9:ux": "node docs/audits/adsense-recovery-phase-9-2026-08-24/validate-phase-9-ux.mjs",
    "generate:phase9:ux": "node docs/audits/adsense-recovery-phase-9-2026-08-24/generate-phase-9-ux-evidence.mjs",
    "audit:phase10": "node scripts/validate-phase-10.mjs && npm run audit:phase10:firewall",
    "audit:phase10:firewall": "npm run generate:phase10:firewall && node docs/audits/adsense-recovery-phase-10-2026-08-24/validate-phase-10-red-team.mjs && node docs/audits/adsense-recovery-phase-10-2026-08-24/validate-phase-10-firewall.mjs",
    "generate:phase10:firewall": "node docs/audits/adsense-recovery-phase-10-2026-08-24/generate-phase-10-firewall-evidence.mjs",
    "generate:phase10:registry": "node scripts/generate-phase-10-route-registry.mjs",
    "audit:phase11": "node scripts/validate-phase-11.mjs && node scripts/validate-phase-11-index-hygiene.mjs",
    "audit:phase11:index": "node scripts/validate-phase-11-index-hygiene.mjs",
    "generate:phase11:index": "node docs/audits/adsense-recovery-phase-11-2026-08-25/generate-phase-11-index-hygiene.mjs",
    "generate:phase12": "node docs/audits/adsense-recovery-phase-12-2026-08-25/generate-phase-12-policy-redteam.mjs",
    "audit:phase12": "node scripts/validate-phase-12-policy-redteam.mjs",
    "generate:phase13": "node docs/audits/adsense-recovery-phase-13-2026-08-25/generate-phase-13-skip.mjs",
    "audit:phase13": "node scripts/validate-phase-13.mjs",
    "audit:governance:changes": "node scripts/report-governance-changes.mjs",
    "audit:production-smoke": "node scripts/production-smoke-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:quotes": "node scripts/validate-quote-governance.mjs",
    "audit:cornerstones": "node docs/audits/adsense-recovery-phase-6-2026-08-24/validate-phase-6-cornerstone-upgrades.mjs",
    "audit:trust": "node docs/audits/adsense-recovery-phase-7-2026-08-24/validate-phase-7-editorial-trust.mjs",
    "audit:historical-boundaries": "node scripts/validate-historical-snapshot-boundaries.mjs",
    "validate": "npm run build && npm run audit:images && npm run typecheck && npm run lint && npm test && npm run audit:seo && npm run audit:content && npm run audit:quotes && npm run audit:trust && npm run audit:historical-boundaries",
    "validate:release": "npm run validate && node scripts/validate-phase-8.mjs && node scripts/validate-phase-9.mjs && node scripts/validate-phase-10.mjs && npm run audit:phase11 && npm run audit:phase12 && npm run audit:phase13 && npm run audit:dependencies"
  },
  "dependencies": {
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "lighthouse": "^13.4.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.8.3",
    "wrangler": "4.134.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "devalue": "^5.9.1",
    "postcss": "^8.5.25",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "undici": "7.29.0"
  }
}

{
  "name": "echo-buddha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "prebuild": "node scripts/block-legacy-cloudflare-production-build.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "lint": "node scripts/lint-governance.mjs",
    "audit:content": "node scripts/audit-content-remediation.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:browser": "node scripts/browser-readiness-check.mjs",
    "audit:lighthouse": "node scripts/lighthouse-readiness.mjs",
    "audit:phase8": "node scripts/validate-phase-8.mjs",
    "audit:phase9": "node scripts/validate-phase-9.mjs",
    "audit:phase10": "node scripts/validate-phase-10.mjs",
    "audit:phase11": "node scripts/validate-phase-11.mjs",
    "audit:governance:changes": "node scripts/report-governance-changes.mjs",
    "audit:production-smoke": "node scripts/production-smoke-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "validate": "npm run build && npm run typecheck && npm run lint && npm test && npm run audit:seo && npm run audit:content",
    "validate:release": "npm run validate && npm run audit:phase8 && npm run audit:phase9 && npm run audit:phase10 && npm run audit:phase11 && npm run audit:dependencies"
  },
  "dependencies": {
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "lighthouse": "^13.4.1",
    "playwright-core": "^1.61.1",
    "typescript": "^5.8.3",
    "wrangler": "4.118.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "undici": "7.29.0"
  }
}
